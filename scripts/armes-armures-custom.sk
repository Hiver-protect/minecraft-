# ==================== FABRICATION DES ARMURES CUSTOMS (STYLE HYPIXEL / RPG) ====================

function getCustomArmor(set: text, piece: text) :: item:
    # 1. SET DU TITAN (Netherite - Tank & Résistance)
    if {_set} is "titan":
        if {_piece} is "helmet":
            set {_i} to 1 of netherite helmet named "&6&l✦ CASQUE DU TITAN ✦"
            set line 1 of lore of {_i} to "&8&m─────────────────────────"
            set line 2 of lore of {_i} to "&7Gear Score: &6720 &8| &7Pièce: &fCasque"
            set line 3 of lore of {_i} to "&7Santé: &a+60 ❤ &8| &7Défense: &a+90 ❈"
            set line 4 of lore of {_i} to "&8&m─────────────────────────"
