# ==============================================================================
#           MINESTARS - ARSENAL & ÉQUIPEMENTS MYTHIQUES SUPRÊMES (MENU UNIFIÉ)
#           - 20 Armes Légendaires avec Compétences Actives, Passifs & Effets Kill
#           - 6 Sets d'Armures Complets avec Effets d'Ensemble 4/4 & Auras
#           - 5 Outils Mythiques (Pioche 3x3, Pioche Auto-Smelt, Hache, Pelle 3x3, Canne)
#           - 1 Bouclier Divin de l'Aegis
#           - 8 Reliques & Artefacts Mythiques
#           - MENU VITRINE APERÇU 54 SLOTS ULTRA-STYLÉ AVEC 5 ONGLETS DYNAMIQUES
# ==============================================================================

options:
    prefix: &6&l✦ ARSENAL &8> &7

# ==================== FABRICATION DES ARMES CUSTOMS ====================

# ==================== FABRICATION DES ARMES CUSTOMS (STYLE HYPIXEL / RPG) ====================

function getCustomWeapon(type: text) :: item:
    # 1. Lame Stellaire
    if {_type} is "star":
        set {_i} to 1 of netherite sword named "&d&l✦ LAME STELLAIRE ✦"
        set line 1 of lore of {_i} to "&8&m─────────────────────────"
        set line 2 of lore of {_i} to "&7Gear Score: &d860 &8| &7Rareté: &d&lMYTHIQUE"
        set line 3 of lore of {_i} to "&7Dégâts: &c+14.0 🗡 &8| &7Force: &c+35 ❁"
        set line 4 of lore of {_i} to "&7Critique: &9+25%% ☣ &8| &7Dég. Crit: &9+65%% ☠"
        set line 5 of lore of {_i} to "&7Vitesse: &e+1.8 ⚡ &8| &b+15%% Vitesse ✦"
        set line 6 of lore of {_i} to "&8&m─────────────────────────"
        set line 7 of lore of {_i} to "&6Capacité : Rayon Stellaire &e&l[CLIC DROIT]"
        set line 8 of lore of {_i} to "&7Projette un rayon foudroyant infligeant &c4❤"
        set line 9 of lore of {_i} to "&7à toutes les entités traversées en ligne droite."
        set line 10 of lore of {_i} to "&8Temps de recharge: &a10s"
        set line 11 of lore of {_i} to " "
        set line 12 of lore of {_i} to "&bPassif : Vitesse Céleste"
        set line 13 of lore of {_i} to "&7Confère un bonus permanent de &b+15%% Vitesse&7."
        set line 14 of lore of {_i} to "&8&m─────────────────────────"
        set line 15 of lore of {_i} to "&d&l✦ ÉPÉE MYTHIQUE MINESTARS ✦"
        enchant {_i} with sharpness 5
        enchant {_i} with unbreaking 3
        set custom model data of {_i} to 10001
        return {_i}
        
    # 2. Hache Tellurique
    else if {_type} is "titan":
        set {_i} to 1 of netherite axe named "&6&l✦ HACHE TELLURIQUE ✦"
        set line 1 of lore of {_i} to "&8&m─────────────────────────"
        set line 2 of lore of {_i} to "&7Gear Score: &6820 &8| &7Rareté: &6&lLÉGENDAIRE"
        set line 3 of lore of {_i} to "&7Dégâts: &c+16.0 🗡 &8| &7Force: &c+50 ❁"
        set line 4 of lore of {_i} to "&7Critique: &9+15%% ☣ &8| &7Dég. Crit: &9+80%% ☠"
        set line 5 of lore of {_i} to "&7Vitesse: &e+0.9 ⚡ &8| &6Anti-Knockback 🛡"
        set line 6 of lore of {_i} to "&8&m─────────────────────────"
        set line 7 of lore of {_i} to "&6Capacité : Fracas Sismique &e&l[CLIC DROIT]"
        set line 8 of lore of {_i} to "&7Déclenche un séisme repoussant les cibles"
        set line 9 of lore of {_i} to "&7dans un rayon de 7 blocs en leur infligeant &c5❤&7."
        set line 10 of lore of {_i} to "&8Temps de recharge: &a12s"
        set line 11 of lore of {_i} to " "
        set line 12 of lore of {_i} to "&cPassif : Étourdissement"
        set line 13 of lore of {_i} to "&720%% de chance d'étourdir et paralyser la cible 1.5s."
        set line 14 of lore of {_i} to "&8&m─────────────────────────"
        set line 15 of lore of {_i} to "&6&l✦ HACHE LÉGENDAIRE MINESTARS ✦"
        enchant {_i} with sharpness 5
        enchant {_i} with unbreaking 3
        set custom model data of {_i} to 10002
        return {_i}

    # 3. Faux de la Faucheuse
    else if {_type} is "scythe":
        set {_i} to 1 of netherite hoe named "&5&l✦ FAUX DE LA FAUCHEUSE ✦"
        set line 1 of lore of {_i} to "&8&m─────────────────────────"
        set line 2 of lore of {_i} to "&7Gear Score: &5880 &8| &7Rareté: &5&lMYTHIQUE"
        set line 3 of lore of {_i} to "&7Dégâts: &c+13.5 🗡 &8| &7Force: &c+30 ❁"
        set line 4 of lore of {_i} to "&7Vol de Vie: &c+20%% 🩸 &8| &5Siphon d'Âmes"
        set line 5 of lore of {_i} to "&8&m─────────────────────────"
        set line 6 of lore of {_i} to "&6Capacité : Siphon d'Âmes &e&l[CLIC DROIT]"
        set line 7 of lore of {_i} to "&7Aspire la force vitale des ennemis proches"
        set line 8 of lore of {_i} to "&7infligeant &54❤ &7et vous restaurant la même santé."
        set line 9 of lore of {_i} to "&8Temps de recharge: &a12s"
        set line 10 of lore of {_i} to " "
        set line 11 of lore of {_i} to "&8Passif : Décomposition"
        set line 12 of lore of {_i} to "&7Chaque coup applique &8Wither II &7pendant 4 secondes."
        set line 13 of lore of {_i} to "&8&m─────────────────────────"
        set line 14 of lore of {_i} to "&5&l✦ FAUX MYTHIQUE MINESTARS ✦"
        enchant {_i} with sharpness 5
        enchant {_i} with unbreaking 3
        set custom model data of {_i} to 10003
        return {_i}

    # 4. Marteau de Thor
