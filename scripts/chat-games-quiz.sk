# ==============================================================================
#           MINESTARS - GRAND QUIZ & CHAT JEUX ULTIMATE (609+ QUESTIONS)
#           - Thèmes : Québec & Expressions, Gaming, Cinéma, Anime/Manga, Géographie,
#             Sciences, Culture G, Histoire, Pop Culture, Musique, Sport, Tech, Énigmes
#           - Animations : Particules Totem & Feux d'artifice, Titre de Victoire,
#             Séries de Victoires (Win Streaks) & /quiz top
# ==============================================================================

options:
    prefix: &e&l✦ CHAT JEUX &8> &7
    border: <#00D4FF>&m───────────────────────────────────────────────

on load:
    set {quiz_active} to false

every 8 minutes:
    if number of all players >= 1:
        startChatGame()

function startChatGame():
    if {quiz_active} is true:
        stop
        
    set {quiz_active} to true
    set {quiz_start_time} to now
    set {quiz_alt2} to ""
    set {quiz_alt3} to ""
    set {quiz_reward_money} to random integer between 35 and 70
    set {quiz_reward_xp} to random integer between 20 and 40
    
    # Choix entre Trivia ou Dynamique (Calcul, Anagrammes, Speed-Type)
    set {_rollType} to random integer between 1 and 11
    
    # 1. CALCUL MENTAL RAPIDE DYNAMIQUE
    if {_rollType} is 9:
        set {quiz_category} to "🧮 CALCUL MENTAL"
        set {_op} to random integer between 1 and 4
        if {_op} is 1:
            set {_n1} to random integer between 18 and 149
            set {_n2} to random integer between 18 and 149
            set {_res} to {_n1} + {_n2}
            set {quiz_question} to "Calculez rapidement : &e%{_n1}% + %{_n2}% &f= ?"
            set {quiz_answer} to "%{_res}%"
            set {quiz_alt} to "%{_res}%"
        else if {_op} is 2:
            set {_n1} to random integer between 75 and 250
            set {_n2} to random integer between 15 and 70
            set {_res} to {_n1} - {_n2}
            set {quiz_question} to "Calculez rapidement : &e%{_n1}% - %{_n2}% &f= ?"
            set {quiz_answer} to "%{_res}%"
            set {quiz_alt} to "%{_res}%"
        else if {_op} is 3:
            set {_n1} to random integer between 7 and 15
            set {_n2} to random integer between 6 and 14
            set {_res} to {_n1} * {_n2}
            set {quiz_question} to "Calculez rapidement : &e%{_n1}% x %{_n2}% &f= ?"
            set {quiz_answer} to "%{_res}%"
            set {quiz_alt} to "%{_res}%"
        else:
            set {_n1} to random integer between 5 and 12
            set {_n2} to random integer between 4 and 9
            set {_n3} to random integer between 10 and 35
            set {_res} to ({_n1} * {_n2}) + {_n3}
            set {quiz_question} to "Calculez rapidement : &e(%{_n1}% x %{_n2}%) + %{_n3}% &f= ?"
            set {quiz_answer} to "%{_res}%"
            set {quiz_alt} to "%{_res}%"

    # 2. ANAGRAMMES & MOTS MÊLÉS
    else if {_rollType} is 10:
        set {quiz_category} to "🔤 ANAGRAMME & MOT MYSTÈRE"
        set {_anId} to random integer between 1 and 20
        if {_anId} is 1:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eD - M - I - N - A - A - T"
            set {quiz_answer} to "diamant"
            set {quiz_alt} to "diamant"
        else if {_anId} is 2:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eE - R - E - D - N"
            set {quiz_answer} to "ender"
            set {quiz_alt} to "ender"
        else if {_anId} is 3:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eH - E - T - N - R - E"
            set {quiz_answer} to "nether"
            set {quiz_alt} to "nether"
        else if {_anId} is 4:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eT - R - S - A - N - I - M - E - S"
            set {quiz_answer} to "minestars"
            set {quiz_alt} to "minestars"
        else if {_anId} is 5:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eB - S - C - K - Y - L - O"
            set {quiz_answer} to "skyblock"
            set {quiz_alt} to "skyblock"
        else if {_anId} is 6:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eC - R - P - E - E - E"
            set {quiz_answer} to "creeper"
            set {quiz_alt} to "creeper"
        else if {_anId} is 7:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eD - A - W - E - R - N"
            set {quiz_answer} to "warden"
            set {quiz_alt} to "warden"
        else if {_anId} is 8:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eO - B - U - L - E - I - R - T"
            set {quiz_answer} to "bouclier"
            set {quiz_alt} to "bouclier"
        else if {_anId} is 9:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eE - M - E - A - D - E - U - R"
            set {quiz_answer} to "emeraude"
            set {quiz_alt} to "emeraude"
        else if {_anId} is 10:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eP - K - C - I - A - X - E"
            set {quiz_answer} to "pickaxe"
            set {quiz_alt} to "pioche"
        else if {_anId} is 11:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eF - R - I - E - O - X"
            set {quiz_answer} to "firefox"
            set {quiz_alt} to "firefox"
        else if {_anId} is 12:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eP - T - N - Y - H - O"
            set {quiz_answer} to "python"
            set {quiz_alt} to "python"
        else if {_anId} is 13:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eA - R - A - G - N - I - E"
            set {quiz_answer} to "araignee"
            set {quiz_alt} to "araignee"
        else if {_anId} is 14:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eE - X - P - L - O - S - I - O - N"
            set {quiz_answer} to "explosion"
            set {quiz_alt} to "explosion"
        else if {_anId} is 15:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eG - A - L - A - X - I - E"
            set {quiz_answer} to "galaxie"
            set {quiz_alt} to "galaxie"
        else if {_anId} is 16:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eC - H - V - A - L - E - I - R"
            set {quiz_answer} to "chevalier"
            set {quiz_alt} to "chevalier"
        else if {_anId} is 17:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eF - O - R - T - R - E - S - S - E"
            set {quiz_answer} to "forteresse"
            set {quiz_alt} to "forteresse"
        else if {_anId} is 18:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eA - N - T - I - G - R - A - V - I - T - Y"
            set {quiz_answer} to "antigravity"
            set {quiz_alt} to "antigravity"
        else if {_anId} is 19:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eS - A - N - C - T - U - A - I - R - E"
            set {quiz_answer} to "sanctuaire"
            set {quiz_alt} to "sanctuaire"
        else:
            set {quiz_question} to "Remettez les lettres dans l''ordre : &eL - E - G - E - N - D - E"
            set {quiz_answer} to "legende"
            set {quiz_alt} to "legende"

    # 3. SPEED-TYPE & SÉCURITÉ
    else if {_rollType} is 11:
        set {quiz_category} to "⚡ SPEED-TYPE RAPIDE"
        set {_c1} to random integer between 1000 and 9999
        set {quiz_question} to "Soyez le plus rapide a reecrire ce code : &e&lSTAR-%{_c1}%"
        set {quiz_answer} to "star-%{_c1}%"
        set {quiz_alt} to "STAR-%{_c1}%"

    # 4. GRAND TRIVIA MULTI-THÈMES (609 QUESTIONS)
    else:
        set {_tId} to random integer between 1 and 609
        if {_tId} is 1:
            set {quiz_category} to "🎮 GAMING"
            set {quiz_question} to "Quel est le nom du célèbre plombier moustachu de Nintendo ?"
