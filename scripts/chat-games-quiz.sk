            set {quiz_question} to "Quel célèbre scientifique a formulé les trois lois du mouvement et la gravitation universelle après la chute d'une pomme ?"
            set {quiz_answer} to "isaac newton"
            set {quiz_alt} to "newton"
        else if {_tId} is 605:
            set {quiz_category} to "🔬 SCIENCES & ESPACE"
            set {quiz_question} to "Quelle galaxie spirale géante est la plus proche voisine de notre Voie Lactée ?"
            set {quiz_answer} to "andromede"
            set {quiz_alt} to "m31"
        else if {_tId} is 606:
            set {quiz_category} to "🔬 SCIENCES & ESPACE"
            set {quiz_question} to "Quel est l'organe le plus volumineux et le plus lourd du corps humain ?"
            set {quiz_answer} to "la peau"
            set {quiz_alt} to "peau"
        else if {_tId} is 607:
            set {quiz_category} to "🔬 SCIENCES & ESPACE"
            set {quiz_question} to "Quel gaz composant environ 78%% de l'air que nous respirons est le plus abondant sur Terre ?"
            set {quiz_answer} to "azote"
            set {quiz_alt} to "diazote"
        else if {_tId} is 608:
            set {quiz_category} to "🔬 SCIENCES & ESPACE"
            set {quiz_question} to "Comment s'appelle l'état de la matière qui n'est ni solide, ni liquide, ni gaz, mais formé d'ions et d'électrons libres ?"
            set {quiz_answer} to "plasma"
            set {quiz_alt} to "le plasma"
        else if {_tId} is 609:
            set {quiz_category} to "🔬 SCIENCES & ESPACE"
            set {quiz_question} to "Combien d'os composent le squelette d'un être humain adulte en bonne santé ?"
            set {quiz_answer} to "206"
            set {quiz_alt} to "206 os"
    # Annonce stylisée avec sons & animations
    broadcast "{@border}"
    broadcast "  &e&l✦ CHAT JEUX &8» &f%{quiz_category}%"
    broadcast "  &7Question : &f%{quiz_question}%"
    broadcast "  &7Recompense : &a+%{quiz_reward_money}%$ &7& &b+%{quiz_reward_xp}% XP"
    broadcast "  &8[&7Ecrivez simplement votre reponse dans le chat !&8]"
    broadcast "{@border}"
    
    send action bar "&e&l✦ NOUVEAU QUIZ ! &fRepondez dans le chat pour gagner &a+%{quiz_reward_money}%$" to all players
    play sound "block.note_block.bell" with volume 0.8 and pitch 1.2 to all players
    
    # Expiration après 45 secondes
    set {_currentStart} to {quiz_start_time}
    wait 45 seconds
    if {quiz_active} is true:
        if {quiz_start_time} is {_currentStart}:
            set {quiz_active} to false
            broadcast "{@border}"
            broadcast "  &c&l✦ TEMPS ÉCOULÉ ! &7Personne n''a trouve la bonne reponse."
            broadcast "  &7La reponse etait : &e&l%{quiz_answer}%"
            broadcast "{@border}"
            play sound "block.note_block.bass" with volume 0.7 and pitch 0.8 to all players

on chat:
    if {quiz_active} is true:
        set {_msg} to message
        set {_cleanMsg} to {_msg}
        # Normalisation
        replace all "é" with "e" in {_cleanMsg}
        replace all "è" with "e" in {_cleanMsg}
        replace all "ê" with "e" in {_cleanMsg}
        replace all "ë" with "e" in {_cleanMsg}
        replace all "à" with "a" in {_cleanMsg}
        replace all "â" with "a" in {_cleanMsg}
        replace all "ù" with "u" in {_cleanMsg}
        replace all "û" with "u" in {_cleanMsg}
        replace all "î" with "i" in {_cleanMsg}
        replace all "ï" with "i" in {_cleanMsg}
        replace all "ô" with "o" in {_cleanMsg}
        replace all "ç" with "c" in {_cleanMsg}
        
        set {_ans} to {quiz_answer}
        set {_cleanAns} to {_ans}
        replace all "é" with "e" in {_cleanAns}
        replace all "è" with "e" in {_cleanAns}
        replace all "ê" with "e" in {_cleanAns}
        replace all "ë" with "e" in {_cleanAns}
        replace all "à" with "a" in {_cleanAns}
        replace all "â" with "a" in {_cleanAns}
        replace all "ù" with "u" in {_cleanAns}
        replace all "û" with "u" in {_cleanAns}
        replace all "î" with "i" in {_cleanAns}
        replace all "ï" with "i" in {_cleanAns}
        replace all "ô" with "o" in {_cleanAns}
        replace all "ç" with "c" in {_cleanAns}
        
        set {_alt} to {quiz_alt}
        set {_alt2} to {quiz_alt2}
        
        set {_isCorrect} to false
        if {_cleanMsg} is {_cleanAns}:
            set {_isCorrect} to true
        else if {_msg} is {_ans}:
            set {_isCorrect} to true
        else if {_cleanMsg} is {_alt}:
            set {_isCorrect} to true
        else if {_alt2} is not "":
            if {_cleanMsg} is {_alt2}:
                set {_isCorrect} to true
                
        if {_isCorrect} is true:
            set {quiz_active} to false
            cancel event
            
            # Calcul du temps de réponse
            set {_timeTaken} to difference between {quiz_start_time} and now
            
            # Gestion des victoires et win streak
            add 1 to {quiz_wins::%player's uuid%}
            add 1 to {quiz_streak::%player's uuid%}
            set {_streak} to {quiz_streak::%player's uuid%}
            
            # Bonus de streak
            set {_finalMoney} to {quiz_reward_money}
            set {_streakBonus} to 0
            if {_streak} >= 2:
                set {_streakBonus} to round({_finalMoney} * 0.5)
                add {_streakBonus} to {_finalMoney}
            
            add {_finalMoney} to {balance::%player's uuid%}
            add {quiz_reward_xp} to {xp::%player's uuid%}
            
            # Annonce Chat
            broadcast "{@border}"
            broadcast "  &a&l✔ VICTOIRE ! &f%player% &7a trouve la bonne reponse !"
            broadcast "  &7Reponse : &e&l%{quiz_answer}% &8(&fTemps: %{_timeTaken}%&8)"
            if {_streak} >= 2:
                broadcast "  &6&l🔥 SÉRIE DE VICTOIRES : &e%{_streak}% d'affilee ! &a(+%{_streakBonus}%$ Bonus)"
            broadcast "  &7Recompense recue : &a+%{_finalMoney}%$ &7& &b+%{quiz_reward_xp}% XP"
            broadcast "{@border}"
            
            # Effets visuels & sonores premium
            send title "&a&l✦ BONNE RÉPONSE ! ✦" with subtitle "&7Gagne : &a+%{_finalMoney}%$ &7& &b+%{quiz_reward_xp}% XP" to player for 3 seconds with fadein 5 ticks and fade out 15 ticks
            play sound "entity.player.levelup" with volume 1.0 and pitch 1.3 to player
            play sound "ui.toast.challenge_complete" with volume 0.8 and pitch 1.2 to player
            draw 25 of totem of undying at player's head
            draw 15 of firework at player's head

# Reset du streak si le joueur se déconnecte
on quit:
    delete {quiz_streak::%player's uuid%}

# Commande pour voir ses statistiques ou le top
command /quiz [<text>]:
    aliases: /chatjeux, /questions
    trigger:
        if arg-1 is "top" or "classement":
            send "{@border}" to player
            send "  &e&l✦ CLASSEMENT CHAT JEUX &8(Victoires)" to player
            set {_qw} to {quiz_wins::%player's uuid%}
            if {_qw} is not set:
                set {_qw} to 0
            set {_qs} to {quiz_streak::%player's uuid%}
            if {_qs} is not set:
                set {_qs} to 0
            send "  &7Vos victoires : &e%{_qw}% &7(Serie : &6%{_qs}%&7)" to player
            send "  &8Rejoignez chaque quiz toutes les 8 minutes !" to player
            send "{@border}" to player
        else if arg-1 is "force" or "start":
            if player has permission "minestars.admin":
                startChatGame()
                send "{@prefix} &aQuiz lance manuellement !" to player
            else:
                send "&cVous n''avez pas la permission." to player
        else:
            send "{@border}" to player
            send "  &e&l✦ STATISTIQUES QUIZ &8- &f%player%" to player
            set {_qw} to {quiz_wins::%player's uuid%}
            if {_qw} is not set:
                set {_qw} to 0
            set {_qs} to {quiz_streak::%player's uuid%}
            if {_qs} is not set:
                set {_qs} to 0
            send "  &7Victoires totales : &a%{_qw}%" to player
            set {_qw} to {quiz_wins::%player's uuid%}
            if {_qw} is not set:
                set {_qw} to 0
            set {_qs} to {quiz_streak::%player's uuid%}
            if {_qs} is not set:
                set {_qs} to 0
            send "  &7Serie actuelle (Streak) : &6%{_qs}% 🔥" to player
            send "  &8Tapez &e/quiz top &8pour voir vos stats !" to player
            send "{@border}" to player
