# ==============================================================================
#           MINESTARS - SYSTÈME DE CLÉS 3D & BOX MYTHIQUES (12 CLÉS DU SERVEUR)
#           - 12 Clés 3D Custom (Ailées, Cœurs, Arcanes, Améthyste, Vote, Sculk...)
#           - Menu GUI 54 slots interactif /box /clefs /crates /keys
#           - Commande /givekey <joueur> <type> [nombre] & /giveallkeys <joueur>
#           - Animation d'ouverture de Crate avec Particules, Sons & Récompenses RPG
# ==============================================================================

options:
    prefix: &6&l✦ BOX & CLÉS &8> &7

# ==================== FABRICATION DES 12 CLÉS 3D ====================

function getCustomKey(type: text) :: item:
    # 1. Clé Céleste Ailée
    if {_type} is "cle_celeste" or "celeste":
        set {_i} to 1 of tripwire hook named "&e&l✦ CLÉ CÉLESTE AILÉE ✦"
        set line 1 of lore of {_i} to "&8&m─────────────────────────"
        set line 2 of lore of {_i} to "&7Type: &eClé Mythique 3D &8| &7Rareté: &e&lDIVINE"
        set line 3 of lore of {_i} to "&7Caisse associée: &eBox Céleste Suprême"
        set line 4 of lore of {_i} to "&8&m─────────────────────────"
        set line 5 of lore of {_i} to "&6Utilisation : &eClic-Droit sur la Box Céleste"
        set line 6 of lore of {_i} to "&7Débloque des armes stellaires, ailes célestes"
        set line 7 of lore of {_i} to "&7et des artefacts légendaires d'élite !"
        set line 8 of lore of {_i} to "&8&m─────────────────────────"
        set line 9 of lore of {_i} to "&e⭐ CLÉ MYTHIQUE MINESTARS"
        set custom model data of {_i} to 40001
        return {_i}

    # 2. Clé Cœur Céleste
    else if {_type} is "cle_coeur" or "coeur":
        set {_i} to 1 of tripwire hook named "&d&l✦ CLÉ CŒUR CÉLESTE ✦"
        set line 1 of lore of {_i} to "&8&m─────────────────────────"
        set line 2 of lore of {_i} to "&7Type: &dClé Sacrée 3D &8| &7Rareté: &d&lMYTHIQUE"
        set line 3 of lore of {_i} to "&7Caisse associée: &dBox Cupidon / Vitalité"
        set line 4 of lore of {_i} to "&8&m─────────────────────────"
        set line 5 of lore of {_i} to "&6Utilisation : &eClic-Droit sur la Box Cœur"
        set line 6 of lore of {_i} to "&7Débloque l'Orbe de Vitalité, armure Céleste"
        set line 7 of lore of {_i} to "&7et des bonus de vie permanents !"
        set line 8 of lore of {_i} to "&8&m─────────────────────────"
        set line 9 of lore of {_i} to "&d⭐ CLÉ SACRÉE MINESTARS"
        set custom model data of {_i} to 40002
        return {_i}

    # 3. Clé Arcane de Saphir
    else if {_type} is "cle_arcane" or "arcane":
        set {_i} to 1 of tripwire hook named "&9&l✦ CLÉ ARCANE DE SAPHIR ✦"
        set line 1 of lore of {_i} to "&8&m─────────────────────────"
        set line 2 of lore of {_i} to "&7Type: &9Clé Magique 3D &8| &7Rareté: &9&lMYTHIQUE"
        set line 3 of lore of {_i} to "&7Caisse associée: &9Box Arcane / Enchanteur"
        set line 4 of lore of {_i} to "&8&m─────────────────────────"
        set line 5 of lore of {_i} to "&6Utilisation : &eClic-Droit sur la Box Arcane"
        set line 6 of lore of {_i} to "&7Débloque Bâton de Tempête, parchemins"
        set line 7 of lore of {_i} to "&7et livres d'enchantements suprêmes VI !"
        set line 8 of lore of {_i} to "&8&m─────────────────────────"
        set line 9 of lore of {_i} to "&9⭐ CLÉ MAGIQUE MINESTARS"
        set custom model data of {_i} to 40003
        return {_i}

    # 4. Clé Améthyste du Vide
    else if {_type} is "cle_amethyst" or "amethyst":
        set {_i} to 1 of tripwire hook named "&5&l✦ CLÉ AMÉTHYSTE DU VIDE ✦"
        set line 1 of lore of {_i} to "&8&m─────────────────────────"
        set line 2 of lore of {_i} to "&7Type: &5Clé Cosmique 3D &8| &7Rareté: &5&lMYTHIQUE"
        set line 3 of lore of {_i} to "&7Caisse associée: &5Box du Vide Interstellaire"
        set line 4 of lore of {_i} to "&8&m─────────────────────────"
        set line 5 of lore of {_i} to "&6Utilisation : &eClic-Droit sur la Box du Vide"
        set line 6 of lore of {_i} to "&7Débloque le Set du Néant et armes cosmiques !"
        set line 7 of lore of {_i} to "&8&m─────────────────────────"
        set line 8 of lore of {_i} to "&5⭐ CLÉ MYTHIQUE MINESTARS"
