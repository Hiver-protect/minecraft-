        set line 3 of lore of {_i} to "&7Caisse associée: &6Box Vote Quotidien"
        set line 4 of lore of {_i} to "&8&m─────────────────────────"
        set line 5 of lore of {_i} to "&6Utilisation : &eClic-Droit sur la Box Vote"
        set line 6 of lore of {_i} to "&7Obtenue gratuitement en votant pour le serveur !"
        set line 7 of lore of {_i} to "&8&m─────────────────────────"
        set line 8 of lore of {_i} to "&6⭐ CLÉ VOTE MINESTARS"
        set custom model data of {_i} to 40005
        return {_i}

    # 6. Clé Rare Prismatique
    else if {_type} is "cle_rare" or "rare":
        set {_i} to 1 of tripwire hook named "&b&l✦ CLÉ PRISMATIQUE ✦"
