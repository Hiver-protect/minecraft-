# ==============================================================================
#                 MINESTARS - BOSS WARDEN TITAN (ÉDITION ULTIME & ÉPIQUE)
#                 - 3 Phases de Combat Épiques (Normal, Enragé, Apocalypse)
#                 - Attaques Spectaculaires (Vortex du Sculk, Onde Sonique, Éclairs)
#                 - Arme Mythique "Lame du Warden" & Loots Légendaires
# ==============================================================================

options:
    prefix: &4&l☠ WARDEN TITAN &8> &7
    max_hp: 500

# ==================== APPARITION DU WARDEN TITAN ====================

on spawn of warden:
    wait 2 ticks
    set max health of event-entity to {@max_hp}
    set health of event-entity to {@max_hp}
    set custom name of event-entity to "&4&l☠ WARDEN TITAN &8┃ &a500&7/&a500❤"
    
    # Effets cinématiques d'apparition
    play sound "entity.warden.emerge" at event-entity for all players
    play sound "entity.wither.spawn" at event-entity for all players
    play sound "entity.ender_dragon.growl" at event-entity for all players
    
    broadcast ""
    broadcast "&4&l☠══════════════════════════════════════════☠"
    broadcast " &4&l✦ ÉVÉNEMENT BOSS : LE WARDEN TITAN A ÉMERGÉ !"
    broadcast " &7Un titan ancestral de &c500❤ &7est apparu dans les ténèbres."
    broadcast " &eTous les guerriers sont appelés au combat ! Butins Mythiques !"
    broadcast "&4&l☠══════════════════════════════════════════☠"
    broadcast ""
    
    loop players in radius 30 around event-entity:
        send title "&4&l☠ WARDEN TITAN ☠" with subtitle "&cLe combat pour votre survie commence !" to loop-player for 3 seconds

# ==================== PHASES DE COMBAT & ATTAQUES SPÉCIALES ====================

on damage of warden:
    set {_hp} to round(health of victim - damage)
    if {_hp} < 0:
        set {_hp} to 0
        
    set {_u} to uuid of victim

    # ========== PHASE 1 : TITAN NORMAL (500 - 250 PV) ==========
    if {_hp} > 250:
        set custom name of victim to "&4&l☠ WARDEN TITAN &8┃ &a%{_hp}%&7/&a500❤"

        # Onde Tellurique Sonique (1 chance sur 5)
        chance of 20%:
            play sound "entity.warden.sonic_boom" at victim for all players
            loop players in radius 12 around victim:
                push loop-player upwards at speed 0.9
                push loop-player (vector from victim to loop-player) at speed 1.6
                damage loop-player by 4
                send "{@prefix}&cLe Warden Titan a déclenché une &4&lOnde Tellurique &c!" to loop-player

    # ========== PHASE 2 : WARDEN ENRAGÉ (250 - 100 PV) ==========
    else if {_hp} > 100:
        set custom name of victim to "&6&l☠ WARDEN ENRAGÉ &8┃ &e%{_hp}%&7/&a500❤ 🔥"
        
        # Passage en rage (Annonce & Invocation unique)
        if {phase2::%{_u}%} is not set:
            set {phase2::%{_u}%} to true
            play sound "entity.warden.roar" at victim for all players
            play sound "entity.generic.explode" at victim for all players
            broadcast "{@prefix}&6&l⚠ PHASE 2 : Le Warden Titan entre en &4&lRAGE &6et appelle ses Ombres !"
            apply speed 1 to victim for 999 days
            loop 3 times:
                spawn 1 vex at victim
                set name of last spawned entity to "&8&l✦ Ombre du Sculk ✦"
                set max health of last spawned entity to 25
                set health of last spawned entity to 25

        # Vortex du Sculk (Attire les joueurs vers le boss)
        chance of 20%:
            play sound "entity.warden.heartbeat" at victim for all players
            loop players in radius 15 around victim:
                push loop-player (vector from loop-player to victim) at speed 1.2
                apply darkness 1 to loop-player for 5 seconds
                send "{@prefix}&8Le &5&lVortex du Sculk &8vous attire vers le Titan !" to loop-player

    # ========== PHASE 3 : FURIE APOCALYPTIQUE (< 100 PV) ==========
    else:
        set custom name of victim to "&5&l☠ WARDEN APOCALYPSE &8┃ &c%{_hp}%&7/&a500❤ ⚡"

        # Passage en Furie Ultime
        if {phase3::%{_u}%} is not set:
            set {phase3::%{_u}%} to true
            play sound "entity.warden.sonic_boom" at victim for all players
            play sound "ui.toast.challenge_complete" at victim for all players
            broadcast "{@prefix}&5&l⚡ DERNIÈRE PHASE : Le Warden libère sa &c&lFURIE APOCALYPTIQUE &5!"
            apply strength 1 to victim for 999 days

        # Foudre et onde sonique déchaînée
        chance of 25%:
            play sound "entity.lightning_bolt.thunder" at victim for all players
            loop players in radius 15 around victim:
                strike lightning effect at loop-player's location
                damage loop-player by 5
                apply slowness 2 to loop-player for 3 seconds
                send "{@prefix}&cUne foudre abyssale frappe votre position !" to loop-player

# ==================== MORT DU BOSS & RÉCOMPENSES LÉGENDAIRES ====================

on death of warden:
    set {_u} to uuid of victim
    delete {phase2::%{_u}%}
    delete {phase3::%{_u}%}
    
    # 1. Annonce Globale de Victoire
    broadcast ""
    broadcast "&6&l⭐══════════════════════════════════════════⭐"
    broadcast " &6&l✦ VICTOIRE : LE WARDEN TITAN A ÉTÉ VAINCU !"
    if attacker is a player:
        broadcast " &eGuerrier victorieux : &f&l%attacker%"
        broadcast " &aRécompenses : &e+1,500$ &7et butin du Sculk !"
        
        # Récompenses directes au vainqueur (équilibrées)
        execute console command "eco give %attacker% 1500"
        give 1 of golden apple to attacker
        give 6 of diamond to attacker
        give 16 of experience bottle to attacker
        
        # 35% de chance d'obtenir la Lame du Sculk
        chance of 33%:
            set {_sword} to getCustomWeapon("sculk")
            give {_sword} to attacker
            send "{@prefix}&6&lCHANCE DIVINE ! &eTu as obtenu la &3&lLame du Sculk &e!" to attacker
        
        send title "&6&l✦ BOSS VAINCU ✦" with subtitle "&aTu as terrassé le Warden Titan !" to attacker for 4 seconds
        play sound "ui.toast.challenge_complete" to attacker
    else:
        broadcast " &7Le Warden Titan a succombé aux blessures !"
    broadcast "&6&l⭐══════════════════════════════════════════⭐"
    broadcast ""
    
    # 2. Drops équilibrés au sol
    drop 1 of netherite scrap at victim's location
    drop 3 of diamond at victim's location
    drop 4 of gold ingot at victim's location
    drop 4 of golden apple at victim's location
    spawn 150 of xp at victim's location

# ==================== COMMANDES ADMIN (/boss & /wardenboss) ====================

command /wardenboss [<text>]:
    aliases: /spawnboss, /warden, /titan
    permission: op
    permission message: &cTu n'as pas la permission !
    trigger:
        if arg-1 is "spawn" or "create":
            spawn 1 warden at player
            send "{@prefix}&aWarden Titan invoqué à votre position !" to player
        else if arg-1 is "kill" or "clear":
            set {_c} to 0
            loop all entities in world of player:
                if "%type of loop-entity%" is "warden":
                    delete loop-entity
                    add 1 to {_c}
            send "{@prefix}&c%{_c}% Warden(s) supprimé(s) dans ce monde." to player
        else:
            execute player command "boss"

command /boss [<text>]:
    aliases: /bosses, /menuboss, /bossmenu
    permission: op
    permission message: &cTu n'as pas la permission !
    trigger:
        if arg-1 is "warden" or "titan":
            spawn 1 warden at player
            send "{@prefix}&aWarden Titan invoqué !" to player
            stop
        else if arg-1 is "wither":
            spawn 1 wither at player
            send "{@prefix}&aWither Boss invoqué !" to player
            stop
        else if arg-1 is "dragon":
            spawn 1 ender dragon at player
            send "{@prefix}&aDragon de l'Ender invoqué !" to player
            stop
        else if arg-1 is "guard" or "garde":
            spawn 1 zombie at player
            set {_b} to last spawned zombie
            set name of {_b} to "&6&l✦ GARDE CÉLESTE ✦ &c[Mini-Boss]"
            set max health of {_b} to 60
            set health of {_b} to 60
            equip {_b} with netherite helmet
            equip {_b} with golden chestplate
            equip {_b} with iron sword
            set {skyblock_boss::%uuid of {_b}%} to "garde_celeste"
            send "{@prefix}&aGarde Céleste (Mini-Boss) invoqué !" to player
            stop
        else if arg-1 is "spectre":
            spawn 1 skeleton at player
            set {_b} to last spawned skeleton
            set name of {_b} to "&d&l✦ SPECTRE DU NÉANT ✦ &c[Mini-Boss]"
            set max health of {_b} to 50
            set health of {_b} to 50
            equip {_b} with diamond helmet
            equip {_b} with bow of power 2
            set {skyblock_boss::%uuid of {_b}%} to "spectre_neant"
            send "{@prefix}&aSpectre du Néant (Mini-Boss) invoqué !" to player
            stop
            
        # Menu GUI Interactif (3 Rows)
        set {_gui} to a new chest inventory with 3 rows named "<#D63031>&lMINE<#FFFFFF>&lSTARS &8▸ &4Boss & Titans"
        loop 27 times:
            set slot (loop-number - 1) of {_gui} to 1 of gray stained glass pane named "&8✦"
            
        # Coins rouges
        set slot 0 of {_gui} to 1 of red stained glass pane named " "
        set slot 8 of {_gui} to 1 of red stained glass pane named " "
        set slot 18 of {_gui} to 1 of red stained glass pane named " "
        set slot 26 of {_gui} to 1 of red stained glass pane named " "
        
        # 1. WARDEN TITAN (Slot 10)
        set slot 10 of {_gui} to 1 of sculk catalyst named "<#D63031>&l✦ WARDEN TITAN ✦" with lore "&8&m─────────────────────" and "&8▸ &7Santé : &c500❤ &8(3 Phases)" and "&8▸ &7Butin : &a+1,500$ &8┃ &d✦ Lame Sculk ✦" and "&8&m─────────────────────" and "&a▶ Invoquer (/boss warden)"
        
        # 2. WITHER BOSS (Slot 12)
        set slot 12 of {_gui} to 1 of wither skeleton skull named "<#747D8C>&l✦ WITHER BOSS ✦" with lore "&8&m─────────────────────" and "&8▸ &7Santé : &c300❤" and "&8▸ &7Butin : &bÉtoile du Nether" and "&8&m─────────────────────" and "&a▶ Invoquer (/boss wither)"
        
        # 3. ENDER DRAGON (Slot 14)
        set slot 14 of {_gui} to 1 of dragon egg named "<#E056FD>&l✦ ENDER DRAGON ✦" with lore "&8&m─────────────────────" and "&8▸ &7Santé : &c200❤" and "&8▸ &7Butin : &eOeuf de Dragon & XP" and "&8&m─────────────────────" and "&a▶ Invoquer (/boss dragon)"
        
        # 4. GARDE CÉLESTE (Slot 16)
        set slot 16 of {_gui} to 1 of golden chestplate named "<#FFA502>&l✦ GARDE CÉLESTE ✦" with lore "&8&m─────────────────────" and "&8▸ &7Santé : &e60❤ &8(Mini-Boss)" and "&8▸ &7Butin : &6Or & Diamants" and "&8&m─────────────────────" and "&a▶ Invoquer (/boss guard)"
        
        # 5. SPECTRE DU NÉANT (Slot 22)
        set slot 22 of {_gui} to 1 of bow named "<#00D4FF>&l✦ SPECTRE DU NÉANT ✦" with lore "&8&m─────────────────────" and "&8▸ &7Santé : &d50❤ &8(Mini-Boss)" and "&8▸ &7Butin : &aLivre Enchanté & XP" and "&8&m─────────────────────" and "&a▶ Invoquer (/boss spectre)"
        
        open {_gui} to player
        play sound "block.chest.open" to player

on inventory click:
    if name of event-inventory contains "Boss & Titans":
        cancel event
        
        # 1. Warden Titan (Slot 10)
        if index of event-slot is 10:
            close player's inventory
            execute player command "boss warden"
            
        # 2. Wither (Slot 12)
        else if index of event-slot is 12:
            close player's inventory
            execute player command "boss wither"
            
        # 3. Dragon (Slot 14)
        else if index of event-slot is 14:
            close player's inventory
            execute player command "boss dragon"
            
        # 4. Garde Céleste (Slot 16)
        else if index of event-slot is 16:
            close player's inventory
            execute player command "boss guard"
            
        # 5. Spectre du Néant (Slot 22)
        else if index of event-slot is 22:
            close player's inventory
            execute player command "boss spectre"

