# ==============================================================================
#      SKYBLOCK V9 ULTIMATE PRO - MINESTARS NEXT-GEN EDITION
#      Système complet & Ultra-Avancé :
#      - Menus 54 slots animés & interactifs
#      - Générateur Central & Naturel Ultra-Complet (TOUS les blocs & minerais de Minecraft)
#      - Coups Critiques, Particules Réalistes, Jackpots & Trésors Mystères
#      - Système d'Équipe & Co-op Avancé (/is invite, /is accept, /is team, /is leave)
#      - Téléportation, spawn et respawn d'équipe synchronisés à 100%
#      - Boutique Skyblock & Vente Rapide intégrée (/is shop)
#      - 8 Quêtes & Défis d'île progressifs
#      - Pass Vol / Fly par abonnement, grades et OP
#      - Banque d'île interactive avec intérêts
#      - Gestion de sécurité, bans, kicks et warps de visite
#      - Biomes réels, Boosters multiplicateurs & Auto-Replant
# ==============================================================================

options:
    prefix: &e&l✦ SKYBLOCK &8> &7
    distance: 1000
    island_y: 150
    radius: 75

on load:
    if {skyblock_next_x} is not set:
        set {skyblock_next_x} to 0
    if {skyblock_next_z} is not set:
        set {skyblock_next_z} to 0
    wait 10 ticks
    loop all players:
        if "%world of loop-player%" contains "skyblock":
            set {_u} to uuid of loop-player
            set {_owner} to "%loop-player%"
            if {island_team_owner::%{_u}%} is set:
                set {_owner} to "%{island_team_owner::%{_u}%}%"
            else if {island_team_owner::%loop-player%} is set:
                set {_owner} to "%{island_team_owner::%loop-player%}%"
            applyIslandBorder(loop-player, {_owner})

on join:
    wait 10 ticks
    set {_u} to uuid of player
    set {_name} to "%player%"
    
    # 1. Synchronisation UUID <-> Pseudo (Empêche toute perte d'île)
    if {island_uuid::%{_u}%::x} is set:
        if {island::%{_name}%::x} is not set:
            set {island::%{_name}%::x} to {island_uuid::%{_u}%::x}
            set {island::%{_name}%::y} to 150
            set {island::%{_name}%::z} to {island_uuid::%{_u}%::z}
            set {island::%{_name}%::world} to {island_uuid::%{_u}%::world}
            set {island_home::%{_name}%} to {island_uuid::%{_u}%::home}
    else if {island::%{_name}%::x} is set:
        set {island_uuid::%{_u}%::x} to {island::%{_name}%::x}
        set {island_uuid::%{_u}%::y} to 150
        set {island_uuid::%{_u}%::z} to {island::%{_name}%::z}
        set {island_uuid::%{_u}%::world} to {island::%{_name}%::world}
        set {island_uuid::%{_u}%::home} to {island_home::%{_name}%}
        
    # 2. Auto-Détection si le joueur se trouve sur une île physique existante
    if "%world of player%" contains "skyblock":
        if {island::%{_name}%::x} is not set:
            set {_px} to x-coordinate of player
            set {_roundedX} to round({_px} / 1000) * 1000
            if abs({_px} - {_roundedX}) <= 150:
                set {island::%{_name}%::x} to {_roundedX}
                set {island::%{_name}%::y} to 150
                set {island::%{_name}%::z} to 0
                set {island::%{_name}%::world} to world "skyblock"
                set {island_home::%{_name}%} to location(({_roundedX} + 0.5), 151, 2.5, world "skyblock")
                set {island_uuid::%{_u}%::x} to {_roundedX}
                set {island_uuid::%{_u}%::z} to 0
                send "{@prefix}&aVotre île a été automatiquement reconnue et rattachée (X: %{_roundedX}%) !" to player
                
        set {_owner} to "%player%"
        if {island_team_owner::%{_u}%} is set:
            set {_owner} to "%{island_team_owner::%{_u}%}%"
        else if {island_team_owner::%player%} is set:
            set {_owner} to "%{island_team_owner::%player%}%"
        applyIslandBorder(player, {_owner})

# ==================== FONCTIONS UTILITAIRES, RAYON D'ÎLE & COFFRES ====================

function getIslandRadius(owner: text) :: number:
    set {_lvl} to {island_upgrades::%{_owner}%::size} ? 1
    if {_lvl} is 1:
        return 50
    else if {_lvl} is 2:
        return 75
    else if {_lvl} is 3:
        return 100
    else if {_lvl} is 4:
        return 150
    else:
        return 200

function applyIslandBorder(p: player, owner: text):
    if {island::%{_owner}%::x} is set:
        set {_rad} to getIslandRadius({_owner})
        set {_size} to {_rad} * 2
        set {_x} to {island::%{_owner}%::x}
        set {_z} to {island::%{_owner}%::z}
        execute console command "worldborder center %{_x}% %{_z}%"
        execute console command "worldborder set %{_size}%"
        execute console command "worldborder warning distance 15"
        execute console command "worldborder damage amount 0"
        execute console command "worldborder damage buffer 5"

function fillStarterChest(loc: location):
    set block at {_loc} to chest
    clear inventory of block at {_loc}
    set slot 0 of inventory of block at {_loc} to 2 ice
    set slot 1 of inventory of block at {_loc} to 1 lava bucket
    set slot 2 of inventory of block at {_loc} to 1 oak sapling
    set slot 3 of inventory of block at {_loc} to 1 sugar cane
    set slot 4 of inventory of block at {_loc} to 1 melon slice
    set slot 5 of inventory of block at {_loc} to 1 pumpkin seeds
    set slot 6 of inventory of block at {_loc} to 1 brown mushroom
    set slot 7 of inventory of block at {_loc} to 1 red mushroom
    set slot 8 of inventory of block at {_loc} to 1 bone
    set slot 9 of inventory of block at {_loc} to 6 bread

function fillDesertChest(loc: location):
    set block at {_loc} to chest
    clear inventory of block at {_loc}
    set slot 0 of inventory of block at {_loc} to 1 cactus
    set slot 1 of inventory of block at {_loc} to 2 sand
    set slot 2 of inventory of block at {_loc} to 1 sugar cane

# ==================== FONCTION DE GÉNÉRATION D'ÎLE CÉLESTE ====================

function createIsland(p: player, x: number, z: number):
    set {_w} to world "skyblock"
    if {_w} is not set:
        set {_w} to "skyblock" parsed as world
    if {_w} is not set:
        set {_w} to world of {_p}

    set {_centerLoc} to location({_x}, 150, {_z}, {_w})

    # 0. Nettoyage total de l'espace céleste & purge des entités
    loop entities in radius 50 of {_centerLoc}:
        if loop-entity is not a player:
            delete loop-entity

    loop integers from -8 to 8:
        set {_dx} to loop-integer-1
        loop integers from -8 to 8:
            set {_dz} to loop-integer-2
            loop integers from 144 to 165:
                set {_bLoc} to location(({_x} + {_dx}), loop-integer-3, ({_z} + {_dz}), {_w})
                if block at {_bLoc} is not air:
                    if block at {_bLoc} is chest or trapped chest or barrel or hopper or furnace or dropper or dispenser:
                        clear inventory of block at {_bLoc}
                    set block at {_bLoc} to air

    # Purge des items résiduels au sol
    loop entities in radius 50 of {_centerLoc}:
        if loop-entity is not a player:
            delete loop-entity

    # 1. Base Principale de l'Île en Relief (Y=146 à Y=150)
    set block at location({_x}, 146, {_z}, {_w}) to stone

    # Couche 2 : Pierre (3x3)
    loop integers from -1 to 1:
        set {_dx} to loop-integer-1
        loop integers from -1 to 1:
            set {_dz} to loop-integer-2
            set block at location(({_x} + {_dx}), 147, ({_z} + {_dz}), {_w}) to stone

    # Couche 3 : Terre profonde (5x5)
    loop integers from -2 to 2:
        set {_dx} to loop-integer-1
        loop integers from -2 to 2:
            set {_dz} to loop-integer-2
            set block at location(({_x} + {_dx}), 148, ({_z} + {_dz}), {_w}) to dirt

    # Couche 4 : Terre intermédiaire (7x7)
    loop integers from -3 to 3:
        set {_dx} to loop-integer-1
        loop integers from -3 to 3:
            set {_dz} to loop-integer-2
            set block at location(({_x} + {_dx}), 149, ({_z} + {_dz}), {_w}) to dirt

    # Couche 5 : Herbe supérieure (7x7)
    loop integers from -3 to 3:
        set {_dx} to loop-integer-1
        loop integers from -3 to 3:
            set {_dz} to loop-integer-2
            set block at location(({_x} + {_dx}), 150, ({_z} + {_dz}), {_w}) to grass block

    # 2. GÉNÉRATEUR INFINI DE MINERAIS AU CENTRE EXACT
    set block at location({_x}, 149, {_z}, {_w}) to bedrock
    set block at location({_x}, 150, {_z}, {_w}) to cobblestone
    set block at location({_x}, 151, {_z}, {_w}) to air

    # 3. Grand Arbre de Départ Céleste
    set {_tx} to {_x} - 2
    set {_tz} to {_z} - 2
    set block at location({_tx}, 150, {_tz}, {_w}) to dirt
    set block at location({_tx}, 151, {_tz}, {_w}) to oak log
    set block at location({_tx}, 152, {_tz}, {_w}) to oak log
    set block at location({_tx}, 153, {_tz}, {_w}) to oak log
    set block at location({_tx}, 154, {_tz}, {_w}) to oak log
    set block at location({_tx}, 155, {_tz}, {_w}) to oak log
    set block at location({_tx}, 156, {_tz}, {_w}) to oak log
    
    # Branches de soutien
    set block at location(({_tx} + 1), 154, {_tz}, {_w}) to oak log
    set block at location(({_tx} - 1), 154, {_tz}, {_w}) to oak log
    set block at location({_tx}, 154, ({_tz} + 1), {_w}) to oak log
    set block at location({_tx}, 154, ({_tz} - 1), {_w}) to oak log

    # Feuillage persistant
    loop integers from -2 to 2:
        set {_lx} to loop-integer-1
        loop integers from -2 to 2:
            set {_lz} to loop-integer-2
            if abs({_lx}) + abs({_lz}) <= 3:
                set block at location(({_tx} + {_lx}), 154, ({_tz} + {_lz}), {_w}) to oak leaves
                set block at location(({_tx} + {_lx}), 155, ({_tz} + {_lz}), {_w}) to oak leaves
    loop integers from -1 to 1:
        set {_lx} to loop-integer-1
        loop integers from -1 to 1:
            set {_lz} to loop-integer-2
            set block at location(({_tx} + {_lx}), 156, ({_tz} + {_lz}), {_w}) to oak leaves
    set block at location({_tx}, 157, {_tz}, {_w}) to oak leaves
    set block at location(({_tx} + 1), 157, {_tz}, {_w}) to oak leaves
    set block at location(({_tx} - 1), 157, {_tz}, {_w}) to oak leaves
    set block at location({_tx}, 157, ({_tz} + 1), {_w}) to oak leaves
    set block at location({_tx}, 157, ({_tz} - 1), {_w}) to oak leaves
    set block at location({_tx}, 158, {_tz}, {_w}) to oak leaves

    # 4. Coffre de Départ Rempli Directement (Nord-Est)
    set {_cx} to {_x} + 2
    set {_cz} to {_z} - 2
    set {_chestLoc} to location({_cx}, 151, {_cz}, {_w})
    fillStarterChest({_chestLoc})

    # 5. Îlot Désertique (à 15 blocs)
    set {_sx} to {_x} + 15
    loop integers from -1 to 1:
        set {_dx} to loop-integer-1
        loop integers from -1 to 1:
            set {_dz} to loop-integer-2
            set block at location(({_sx} + {_dx}), 148, ({_z} + {_dz}), {_w}) to sandstone
            set block at location(({_sx} + {_dx}), 149, ({_z} + {_dz}), {_w}) to sand
            set block at location(({_sx} + {_dx}), 150, ({_z} + {_dz}), {_w}) to sand
    
    set {_desertChestLoc} to location({_sx}, 151, {_z}, {_w})
    fillDesertChest({_desertChestLoc})

    # Cactus en diagonale
    set block at location(({_sx} + 1), 151, ({_z} + 1), {_w}) to cactus
    set block at location(({_sx} + 1), 152, ({_z} + 1), {_w}) to cactus
    set block at location(({_sx} - 1), 151, ({_z} - 1), {_w}) to cactus
    set block at location(({_sx} - 1), 152, ({_z} - 1), {_w}) to cactus

    # 6. Spawner d'animaux vivants
    spawn 1 cow at location(({_x} + 1), 151, ({_z} + 1), {_w})
    spawn 1 sheep at location(({_x} - 1), 151, ({_z} + 1), {_w})

    # 7. Sauvegarde des variables
    set {island::%{_p}%::x} to {_x}
    set {island::%{_p}%::y} to 150
    set {island::%{_p}%::z} to {_z}
    set {island::%{_p}%::world} to {_w}
    set {island::%{_p}%::owner} to uuid of {_p}
    if {island_upgrades::%{_p}%::gen} is not set:
        set {island_upgrades::%{_p}%::gen} to 1
    if {island_bank::%{_p}%} is not set:
        set {island_bank::%{_p}%} to 0
    if {island_level::%{_p}%} is not set:
        set {island_level::%{_p}%} to 10
    if {island_likes::%{_p}%} is not set:
        set {island_likes::%{_p}%} to 0

    applyIslandBorder({_p}, "%{_p}%")

    send "" to {_p}
    send "&e&l✦ SKYBLOCK ULTIMATE &8> &a&lTon île a été générée avec succès !" to {_p}
    send "&7• &6&lGénérateur de cobblestone &7placé &e&lau centre exact &7de ton île" to {_p}
    send "&7• &fÎle 100%% suspendue &7dans les nuages à Y=150" to {_p}
    send "&7• &fCoffre de départ épuré &7avec 2 Glaces, 1 Lave, Graines, Champignons, Pousse & Pain" to {_p}
    send "&7• &fÎlot désertique &7avec Cactus, Sable & Canne à sucre" to {_p}
    send "&7• Menu de gestion : &e/is &7ou &e/island" to {_p}
    send "" to {_p}

# ==================== COMMANDES ADMIN / RÉCUPÉRATION D'ÎLE (/isadmin) ====================

command /isadmin [<text>] [<text>] [<text>] [<text>]:
    aliases: /isadm, /islandadmin
    permission: op
    permission message: &cTu n'as pas la permission!
    trigger:
        if arg-1 is not set:
            send "" to player
            send "&e&l✦ GESTION ADMIN SKYBLOCK ✦" to player
            send "&7• &e/isadmin list &7- Liste et menu GUI de toutes les îles créées" to player
            send "&7• &e/isadmin scan &7- Scanner les coordonnées physiques d'îles dans le monde" to player
            send "&7• &e/isadmin link <joueur> <x> <z> &7- Relier une île existante aux coordonnées X Z" to player
            send "&7• &e/isadmin setisland <joueur> &7- Assigner l'île du joueur à votre position actuelle" to player
            send "&7• &e/isadmin tpcoord <x> <z> &7- Se téléporter aux coordonnées X Z" to player
            send "&7• &e/isadmin tp <joueur> &7- Se téléporter sur l'île d'un joueur" to player
            send "&7• &e/isadmin create <joueur> &7- Créer une île neuve pour un joueur" to player
            send "&7• &e/isadmin regen <joueur> &7- Régénérer l'île d'un joueur" to player
            send "&7• &e/isadmin fixhome <joueur> &7- Réinitialiser le spawn d'île du joueur" to player
            send "&7• &e/isadmin delete <joueur> &7- Supprimer l'enregistrement d'une île" to player
            send "" to player
            stop
            
        if arg-1 is "list" or "liste" or "islands":
            send "" to player
            send "&e&l✦ LISTE DES ÎLES SKYBLOCK ENREGISTRÉES ✦" to player
            set {_count} to 0
            loop {island::*}:
                add 1 to {_count}
            set {_gui} to a new chest inventory with 6 rows named "<#FFA502>&lMINE<#FFFFFF>&lSTARS &8▸ &6Îles Skyblock &8(&e%{_count}%&8)"
            set {_slot} to 0
            loop {island::*}:
                set {_owner} to loop-index
                set {_x} to {island::%{_owner}%::x}
                set {_z} to {island::%{_owner}%::z}
                set {_lvl} to {island_level::%{_owner}%} ? 10
                set slot {_slot} of {_gui} to 1 of player head named "&e&l✦ Île de %{_owner}% ✦" with lore "&8&m─────────────────────" and "&8▸ &7Coordonnées : &fX: %{_x}%, Z: %{_z}%" and "&8▸ &7Niveau d'île : &a★ %{_lvl}% ⭐" and "&8&m─────────────────────" and "&a▶ Clic Gauche : Se téléporter" and "&c▶ Clic Droit : Régénérer"
                add 1 to {_slot}
                if {_slot} >= 54:
                    stop loop
                    
            if {_count} is 0:
                send "&7Aucune île enregistrée dans les variables actuelles." to player
                send "&7Astuce : Utilisez &e/isadmin scan &7pour détecter les îles physiques dans le monde !" to player
            else:
                send "&aTotal : %{_count}% îles trouvées. Menu ouvert !" to player
                open {_gui} to player
                play sound "block.chest.open" to player
            send "" to player
            stop
            
        if arg-1 is "scan" or "scanner" or "find":
            send "" to player
            send "&e&l✦ SCANNER DES ÎLES PHYSIQUES SKYBLOCK ✦" to player
            send "&7Recherche des îles construites de X: 0 à X: %{skyblock_next_x} ? 15000%..." to player
            set {_found} to 0
            set {_w} to world "skyblock"
            if {_w} is not set:
                set {_w} to "skyblock" parsed as world
            if {_w} is not set:
                set {_w} to world of player
                
            set {_maxScan} to {skyblock_next_x} ? 15000
            if {_maxScan} < 10000:
                set {_maxScan} to 15000
                
            set {_curX} to 0
            while {_curX} <= {_maxScan}:
                set {_checkLoc} to location({_curX}, 149, 0, {_w})
                set {_b} to block at {_checkLoc}
                set {_bTop} to block at location({_curX}, 150, 0, {_w})
                if {_b} is not air:
                    add 1 to {_found}
                    send "&a[ÎLE DÉTECTÉE] &7Emplacement &eX: %{_curX}%, Z: 0 &8(Bloc: &f%{_b}% / %{_bTop}%&8) ➔ &b/isadmin tpcoord %{_curX}% 0" to player
                add 1000 to {_curX}
                
            send "&eScan terminé : %{_found}% emplacements d'îles physiques trouvés." to player
            send "" to player
            play sound "block.note_block.pling" to player
            stop
            
        if arg-1 is "tpcoord" or "gotocoord":
            set {_x} to (arg-2 parsed as number) ? 0
            set {_z} to (arg-3 parsed as number) ? 0
            set {_w} to world "skyblock"
            if {_w} is not set:
                set {_w} to "skyblock" parsed as world
            if {_w} is not set:
                set {_w} to world of player
            set {_loc} to location(({_x} + 0.5), 151, ({_z} + 2.5), {_w})
            teleport player to {_loc}
            send "{@prefix}&aTéléporté en Skyblock à &eX: %{_x}%, Y: 151, Z: %{_z}%&a !" to player
            play sound "entity.enderman.teleport" to player
            stop
            
        set {_target} to arg-2
        if {_target} is not set:
            send "{@prefix}&cPrécisez le pseudo du joueur !" to player
            stop
            
        if arg-1 is "link" or "relink" or "lier":
            set {_x} to (arg-3 parsed as number) ? 0
            set {_z} to (arg-4 parsed as number) ? 0
            set {_w} to world "skyblock"
            if {_w} is not set:
                set {_w} to "skyblock" parsed as world
            if {_w} is not set:
                set {_w} to world of player
                
            set {island::%{_target}%::x} to {_x}
            set {island::%{_target}%::y} to 150
            set {island::%{_target}%::z} to {_z}
            set {island::%{_target}%::world} to {_w}
            set {island_home::%{_target}%} to location(({_x} + 0.5), 151, ({_z} + 2.5), {_w})
            
            set {_targetP} to {_target} parsed as player
            if {_targetP} is online:
                applyIslandBorder({_targetP}, "%{_target}%")
                teleport {_targetP} to {island_home::%{_target}%}
                send "{@prefix}&aVotre île a été retrouvée et reliée avec succès par un administrateur !" to {_targetP}
                
            send "{@prefix}&aL'île de &e%{_target}% &aa été reliée avec succès aux coordonnées &eX: %{_x}%, Z: %{_z}%&a !" to player
            play sound "entity.player.levelup" to player
            stop
            
        if arg-1 is "create" or "new" or "add":
            set {_w} to world "skyblock"
            if {_w} is not set:
                set {_w} to "skyblock" parsed as world
            if {_w} is not set:
                set {_w} to world of player
                
            if {skyblock_next_x} is not set:
                set {skyblock_next_x} to 1000
            if {skyblock_next_z} is not set:
                set {skyblock_next_z} to 0
                
            set {_x} to {skyblock_next_x}
            set {_z} to {skyblock_next_z}
            
            set {island::%{_target}%::x} to {_x}
            set {island::%{_target}%::y} to 150
            set {island::%{_target}%::z} to {_z}
            set {island::%{_target}%::world} to {_w}
            
            add {@distance} to {skyblock_next_x}
            if {skyblock_next_x} > 100000:
                set {skyblock_next_x} to 0
                add {@distance} to {skyblock_next_z}
                
            set {_targetP} to {_target} parsed as player
            if {_targetP} is online:
                createIsland({_targetP}, {_x}, {_z})
                set {_targetLoc} to location(({_x} + 0.5), 151, ({_z} + 2.5), {_w})
                teleport {_targetP} to {_targetLoc}
                send "{@prefix}&aUne île a été créée par un administrateur pour vous !" to {_targetP}
            else:
                createIsland(player, {_x}, {_z})
                
            send "{@prefix}&aNouvelle île Skyblock créée avec succès pour &e%{_target}% &7(X: %{_x}%, Z: %{_z}%) !" to player
            play sound "entity.player.levelup" to player
            
        if arg-1 is "tp" or "teleport" or "goto":
            if {island::%{_target}%::x} is set:
                set {_w} to world "skyblock"
                if {_w} is not set:
                    set {_w} to "skyblock" parsed as world
                set {_targetLoc} to location(({island::%{_target}%::x} + 0.5), 151, ({island::%{_target}%::z} + 2.5), {_w})
                if {island_home::%{_target}%} is set:
                    set {_targetLoc} to {island_home::%{_target}%}
                teleport player to {_targetLoc}
                send "{@prefix}&aTéléporté sur l'île de &e%{_target}% &7(X: %{island::%{_target}%::x}%, Z: %{island::%{_target}%::z}%) !" to player
                play sound "entity.enderman.teleport" to player
            else:
                send "{@prefix}&cLe joueur &e%{_target}% &cn'a pas d'île enregistrée !" to player
                
        else if arg-1 is "regen" or "recreate" or "reset":
            if {island::%{_target}%::x} is set:
                set {_x} to {island::%{_target}%::x}
                set {_z} to {island::%{_target}%::z}
                set {_targetP} to {_target} parsed as player
                if {_targetP} is online:
                    createIsland({_targetP}, {_x}, {_z})
                    teleport {_targetP} to location(({_x} + 0.5), 151, ({_z} + 2.5), world "skyblock")
                else:
                    createIsland(player, {_x}, {_z})
                send "{@prefix}&aÎle de &e%{_target}% &arégénérée avec succès !" to player
                play sound "entity.player.levelup" to player
            else:
                send "{@prefix}&cLe joueur n'a pas d'île enregistrée. Fais &e/isadmin create <joueur>&c." to player
                
        else if arg-1 is "setisland" or "set":
            set {island::%{_target}%::x} to round(x-coordinate of player)
            set {island::%{_target}%::y} to 150
            set {island::%{_target}%::z} to round(z-coordinate of player)
            set {island::%{_target}%::world} to world of player
            set {island_home::%{_target}%} to location of player
            send "{@prefix}&aL'île de &e%{_target}% &aa été assignée à vos coordonnées actuelles !" to player
            play sound "block.note_block.pling" to player
            
        else if arg-1 is "fixhome":
            if {island::%{_target}%::x} is set:
                set {_w} to world "skyblock"
                set {island_home::%{_target}%} to location(({island::%{_target}%::x} + 0.5), 151, ({island::%{_target}%::z} + 2.5), {_w})
                send "{@prefix}&aSpawn d'île de &e%{_target}% &aréinitialisé aux coordonnées d'origine !" to player
                play sound "block.note_block.pling" to player
            else:
                send "{@prefix}&cLe joueur n'a pas d'île enregistrée !" to player
                
        else if arg-1 is "delete" or "remove":
            delete {island::%{_target}%::x}
            delete {island::%{_target}%::y}
            delete {island::%{_target}%::z}
            delete {island::%{_target}%::world}
            delete {island_home::%{_target}%}
            send "{@prefix}&aDonnées d'île de &e%{_target}% &asupprimées avec succès !" to player
            play sound "block.wooden_button.click_off" to player

# ==================== COMMANDE PRINCIPALE SKYBLOCK (/is) ====================

command /skyblock [<text>] [<text>] [<number>]:
    aliases: /is, /ile, /island
    trigger:
        set {_cmd} to arg-1
        set {_target} to arg-2
        set {_val} to arg-3
        
        # Résolution universelle du propriétaire de l'île / hôte d'équipe
        set {_u} to uuid of player
        set {_owner} to "%player%"
        if {island_team_owner::%{_u}%} is set:
            set {_owner} to "%{island_team_owner::%{_u}%}%"
        else if {island_team_owner::%player%} is set:
            set {_owner} to "%{island_team_owner::%player%}%"

        if "%world of player%" contains "skyblock":
            applyIslandBorder(player, {_owner})

        # 0. CRÉATION MANUELLE D'ÎLE (/is create)
        if {_cmd} is "create" or "creer" or "new":
            if {island::%player%::x} is set:
                send "{@prefix}&cTu possèdes déjà une île ! Fais &e/is home &cpour t'y téléporter." to player
            else if {island_team_owner::%{_u}%} is set:
                send "{@prefix}&cTu es déjà membre d'une équipe Skyblock ! Fais &e/is leave &cpour la quitter d'abord." to player
            else if {island_team_owner::%player%} is set:
                send "{@prefix}&cTu es déjà membre d'une équipe Skyblock ! Fais &e/is leave &cpour la quitter d'abord." to player
            else:
                execute player command "is-create"
            stop

        # 1. SETHOME / SETSPAWN
        else if {_cmd} is "sethome" or "setspawn":
            if "%world of player%" contains "skyblock":
                if {island::%{_owner}%::x} is set:
                    set {island_home::%{_owner}%} to location of player
                    send "{@prefix}&aPoint d'apparition de l'île (&e%{_owner}%&a) défini à ta position !" to player
                    play sound "block.note_block.pling" to player
                else:
                    send "{@prefix}&cTu n'as pas encore d'île ! Fais &e/is &cpour la créer." to player
            else:
                send "{@prefix}&cTu dois être dans le monde Skyblock pour définir ton spawn !" to player
            stop

        # 2. HOME / TP (REJOINDRE SON ÎLE OU CELLE DE SON ÉQUIPE)
        else if {_cmd} is "home" or "go" or "tp" or "rejoindre":
            if {island::%{_owner}%::x} is set:
                set {_w} to {island::%{_owner}%::world}
                if {_w} is not set:
                    set {_w} to world "skyblock"
                if {_w} is not set:
                    set {_w} to "skyblock" parsed as world
                if {_w} is not set:
                    set {_w} to world of player

                if {island_home::%{_owner}%} is set:
                    teleport player to {island_home::%{_owner}%}
                else:
                    set {_targetLoc} to location(({island::%{_owner}%::x} + 0.5), 151, ({island::%{_owner}%::z} + 2.5), {_w})
                    teleport player to {_targetLoc}
                applyIslandBorder(player, {_owner})
                send title "&e&l✦ TON ÎLE CÉLESTE ✦" with subtitle "&7Bienvenue sur le domaine de &e%{_owner}%" to player for 2 seconds
                send "{@prefix}&7Téléporté sur l'île Skyblock (&e%{_owner}%&7) !" to player
                play sound "entity.experience_orb.pickup" to player
            else:
                send "{@prefix}&cTu n'as pas encore d'île ! Fais &e/is &cpour la créer." to player
            stop

        # 3. KIT DE SECOURS (/is kit)
        else if {_cmd} is "kit" or "starter":
            if {island::%{_owner}%::x} is set:
                give 2 ice to player
                give 1 lava bucket to player
                give 1 oak sapling to player
                give 6 bread to player
                send "{@prefix}&aKit de secours reçu (2 Glaces, 1 Lave, 1 Pousse, 6 Pains) !" to player
                play sound "entity.player.levelup" to player
            else:
                send "{@prefix}&cCrée d'abord ton île avec &e/is &c!" to player
            stop

        # 3b. REPLACER / RÉPARER LE GÉNÉRATEUR (/is fixgen, /is gen, /is fixgen <joueur>)
        else if {_cmd} is "fixgen" or "gen" or "setgen" or "generateur" or "generator":
            if "%world of player%" contains "skyblock":
                set {_canPlace} to false
                set {_genOwner} to {_owner}
                
                # Support Staff / OP pour replacer sur n'importe quelle île ou pour un autre joueur
                if player is op:
                    set {_canPlace} to true
                    if {_target} is set:
                        set {_genOwner} to {_target}
                else if {rank::%{_u}%} is "Fondateur" or "Admin" or "Resp" or "Modo":
                    set {_canPlace} to true
                    if {_target} is set:
                        set {_genOwner} to {_target}
                else if {island::%{_owner}%::x} is set:
                    set {_canPlace} to true
                    
                if {_canPlace} is true:
                    set {_targetLoc} to location of targeted block
                    if {_targetLoc} is not set:
                        set {_targetLoc} to location of block in front of player
                    if block at {_targetLoc} is air or water or lava:
                        set {_targetLoc} to location of block at player
                    set {_locBelow} to location 1 below {_targetLoc}
                    set block at {_locBelow} to bedrock
                    set block at {_targetLoc} to cobblestone
                    
                    set {_lvl} to {island_upgrades::%{_genOwner}%::gen} ? 1
                    send "{@prefix}&a✦ Générateur de minerais infini &e(Tier %{_lvl}%) &areplacé avec succès !" to player
                    send "{@prefix}&7Mine le bloc au-dessus de la bedrock pour récolter tes minerais !" to player
                    if {_genOwner} is not "%player%":
                        send "{@prefix}&7Générateur associé à l'île de : &e%{_genOwner}%" to player
                    play sound "block.anvil.use" to player
                    play sound "entity.player.levelup" to player
                else:
                    send "{@prefix}&cTu n'as pas encore d'île Skyblock ! Fais &e/is &cpour la créer." to player
            else:
                send "{@prefix}&cTu dois être dans le monde Skyblock pour replacer un générateur !" to player
            stop

        # 4. FLY SUR L'ÎLE (/is fly [manage|buy|gui])
        else if {_cmd} is "fly" or "vol":
            if {_target} is "gui" or "menu" or "manage" or "gerer" or "buy" or "abonnement":
                execute player command "is-gui-fly"
                stop
            if "%world of player%" contains "skyblock":
                set {_hasFly} to false
                if player is op:
                    set {_hasFly} to true
                else if {rank::%{_u}%} is "Admin" or "Fondateur" or "Modo":
                    set {_hasFly} to true
                else if {island_fly_expire::%player%} is set:
                    if now < {island_fly_expire::%player%}:
                        set {_hasFly} to true
                
                if {_hasFly} is true:
                    if player's flight mode is true:
                        set player's flight mode to false
                        send "{@prefix}&cMode vol désactivé sur ton île !" to player
                        play sound "block.wooden_button.click_off" to player
                    else:
                        set player's flight mode to true
                        set {_rem} to difference between {island_fly_expire::%player%} and now
                        send "{@prefix}&aMode vol activé ! &7(Temps restant: &e%{_rem}%&7)" to player
                        play sound "block.wooden_button.click_on" to player
                else:
                    send "{@prefix}&cTu n'as pas de Pass Vol actif en Skyblock !" to player
                    execute player command "is-gui-fly"
            else:
                send "{@prefix}&cLe vol est strictement interdit en Survie et réservé au Skyblock avec Pass !" to player
            stop

        # 5. CALCUL DU NIVEAU D'ÎLE (/is level)
        else if {_cmd} is "level" or "niveau":
            if {island::%{_owner}%::x} is set:
                set {_gen} to {island_upgrades::%{_owner}%::gen}
                if {_gen} is not set:
                    set {_gen} to 1
                set {_pts} to 10 + ({_gen} * 25)
                if {island_bank::%{_owner}%} > 10000:
                    add round({island_bank::%{_owner}%} / 5000) to {_pts}
                if {island_likes::%{_owner}%} is set:
                    add ({island_likes::%{_owner}%} * 5) to {_pts}
                set {island_level::%{_owner}%} to {_pts}
                send "{@prefix}&aNiveau de l'île (&e%{_owner}%&a) : &e&l%{_pts}% ⭐" to player
                play sound "entity.player.levelup" to player
            else:
                send "{@prefix}&cTu n'as pas encore d'île !" to player
            stop

        # 6. LIKE / RÉPUTATION D'UNE ÎLE (/is like <pseudo>)
        else if {_cmd} is "like" or "aimer":
            if {_target} is set:
                if {_target} is player's name:
                    send "{@prefix}&cTu ne peux pas liker ta propre île !" to player
                    stop
                if {island_liked::%player%::%{_target}%} is true:
                    send "{@prefix}&cTu as déjà aimé l'île de &e%{_target}% &c!" to player
                    stop
                if {island::%{_target}%::x} is set:
                    set {island_liked::%player%::%{_target}%} to true
                    add 1 to {island_likes::%{_target}%}
                    add 5 to {island_level::%{_target}%}
                    send "{@prefix}&aTu as aimé l'île de &e%{_target}% &a! (+1 Like, +5⭐)" to player
                    set {_targetP} to {_target} parsed as player
                    if {_targetP} is online:
                        send "{@prefix}&e%player% &aa aimé votre île ! (+1 Like)" to {_targetP}
                        play sound "entity.experience_orb.pickup" to {_targetP}
                else:
                    send "{@prefix}&cLe joueur &f%{_target}% &cn'a pas d'île Skyblock !" to player
            else:
                send "{@prefix}&cUtilisation : &e/is like <pseudo>" to player
            stop

        # 7. GESTION DES MEMBRES / ÉQUIPES (/is invite, accept, kick, leave)
        else if {_cmd} is "invite" or "inviter":
            if {_target} is set:
                if {island::%{_owner}%::x} is set:
                    set {_targetP} to {_target} parsed as player
                    if {_targetP} is online:
                        if {_targetP} is player:
                            send "{@prefix}&cTu ne peux pas t'inviter toi-même !" to player
                            stop
                        set {_targetU} to uuid of {_targetP}
                        set {island_invite::%{_targetU}%} to "%player%"
                        set {island_invite::%{_targetP}%} to "%player%"
                        set {island_invite_owner::%{_targetU}%} to "%{_owner}%"
                        set {island_invite_owner::%{_targetP}%} to "%{_owner}%"
                        send "{@prefix}&aInvitation envoyée à &e%{_targetP}% &apour rejoindre ton île Skyblock !" to player
                        send "{@prefix}&e%player% &7t'invite à rejoindre son île Skyblock (&e%{_owner}%&7) !" to {_targetP}
                        send "{@prefix}&aTape &e/is accept &aou clique pour rejoindre l'équipe !" to {_targetP}
                        play sound "block.note_block.pling" to {_targetP}
                    else:
                        send "{@prefix}&cLe joueur &f%{_target}% &cn'est pas en ligne !" to player
                else:
                    send "{@prefix}&cTu dois posséder une île pour inviter des membres !" to player
            else:
                send "{@prefix}&cUtilisation : &e/is invite <joueur>" to player
            stop

        else if {_cmd} is "accept" or "accepter" or "join":
            set {_inviter} to ""
            if {island_invite::%{_u}%} is set:
                set {_inviter} to {island_invite::%{_u}%}
            else if {island_invite::%player%} is set:
                set {_inviter} to {island_invite::%player%}

            if {_inviter} is not "":
                set {_canAccept} to true
                if {_target} is set:
                    if "%{_inviter}%" does not contain "%{_target}%":
                        set {_canAccept} to false

                if {_canAccept} is true:
                    set {_targetHost} to {_inviter}
                    if {island_invite_owner::%{_u}%} is set:
                        set {_targetHost} to {island_invite_owner::%{_u}%}
                    else if {island_invite_owner::%player%} is set:
                        set {_targetHost} to {island_invite_owner::%player%}

                    delete {island_invite::%{_u}%}
                    delete {island_invite::%player%}
                    delete {island_invite_owner::%{_u}%}
                    delete {island_invite_owner::%player%}

                    set {island_team_owner::%{_u}%} to "%{_targetHost}%"
                    set {island_team_owner::%player%} to "%{_targetHost}%"

                    add "%player%" to {island_team::%{_targetHost}%::*}
                    add player to {island_team::%{_targetHost}%::*}

                    send "{@prefix}&aTu as rejoint avec succès l'île de &e%{_targetHost}% &a!" to player
                    play sound "entity.player.levelup" to player

                    set {_hostP} to {_targetHost} parsed as player
                    if {_hostP} is online:
                        send "{@prefix}&e%player% &aa rejoint votre équipe Skyblock !" to {_hostP}
                        play sound "entity.player.levelup" to {_hostP}

                    # Téléportation immédiate sur l'île d'équipe
                    execute player command "is home"
                else:
                    send "{@prefix}&cCette invitation ne correspond pas à &f%{_target}% &c!" to player
            else:
                send "{@prefix}&cTu n'as aucune invitation d'équipe en attente !" to player
            stop

        else if {_cmd} is "leave" or "quitter":
            set {_teamHost} to ""
            if {island_team_owner::%{_u}%} is set:
                set {_teamHost} to "%{island_team_owner::%{_u}%}%"
            else if {island_team_owner::%player%} is set:
                set {_teamHost} to "%{island_team_owner::%player%}%"

            if {_teamHost} is not "":
                remove "%player%" from {island_team::%{_teamHost}%::*}
                remove player from {island_team::%{_teamHost}%::*}
                delete {island_team_owner::%{_u}%}
                delete {island_team_owner::%player%}
                send "{@prefix}&aTu as quitté l'équipe de &e%{_teamHost}%&a." to player
                set {_hostP} to {_teamHost} parsed as player
                if {_hostP} is online:
                    send "{@prefix}&e%player% &ca quitté ton équipe Skyblock." to {_hostP}
                execute player command "spawn"
            else:
                send "{@prefix}&cTu n'es dans aucune équipe. Fais &e/is reset &cpour réinitialiser ton île." to player
            stop

        # 8. SÉCURITÉ : EXPULSER / BAN D'ÎLE (/is kick <joueur>, /is ban <joueur>, /is unban <joueur>)
        else if {_cmd} is "kick" or "expulser" or "virer":
            if {_target} is set:
                set {_targetP} to {_target} parsed as player
                set {_targetName} to {_target}
                if {_targetP} is set:
                    set {_targetName} to "%{_targetP}%"
                    set {_targetU} to uuid of {_targetP}
                    delete {island_team_owner::%{_targetU}%}
                delete {island_team_owner::%{_targetName}%}
                remove {_targetName} from {island_team::%player%::*}
                remove {_targetP} from {island_team::%player%::*}
                if {_targetP} is online:
                    if "%world of {_targetP}%" contains "skyblock":
                        teleport {_targetP} to location(0, 100, 0, world "spawn")
                    send "{@prefix}&cTu as été exclu de l'équipe Skyblock de &e%player% &c!" to {_targetP}
                send "{@prefix}&aLe joueur &e%{_targetName}% &aa été expulsé de ton île !" to player
                play sound "block.anvil.land" to player
            else:
                send "{@prefix}&cUtilisation : &e/is kick <joueur>" to player
            stop

        else if {_cmd} is "ban":
            if {_target} is set:
                set {island_banned::%player%::%{_target}%} to true
                set {_targetP} to {_target} parsed as player
                if {_targetP} is online:
                    teleport {_targetP} to location(0, 100, 0, world "spawn")
                    send "{@prefix}&cTu as été banni de l'île de &e%player% &c!" to {_targetP}
                send "{@prefix}&aLe joueur &e%{_target}% &aest désormais banni de ton île !" to player
            else:
                send "{@prefix}&cUtilisation : &e/is ban <joueur>" to player
            stop

        else if {_cmd} is "unban":
            if {_target} is set:
                delete {island_banned::%player%::%{_target}%}
                send "{@prefix}&aLe joueur &e%{_target}% &aest débanni de ton île !" to player
            else:
                send "{@prefix}&cUtilisation : &e/is unban <joueur>" to player
            stop

        # 9. VISITER UNE ÎLE (/is visit <pseudo>)
        else if {_cmd} is "visit" or "visiter":
            if {_target} is set:
                if {island_banned::%{_target}%::%player%} is true:
                    send "{@prefix}&cTu es banni de l'île de &e%{_target}% &c!" to player
                    stop
                if {island::%{_target}%::x} is set:
                    if {island_locked::%{_target}%} is true:
                        if player is not op:
                            send "{@prefix}&cL'île de &f%{_target}% &cest verrouillée aux visiteurs !" to player
                            stop
                    set {_w} to {island::%{_target}%::world}
                    if {_w} is not set:
                        set {_w} to world "skyblock"
                    if {_w} is not set:
                        set {_w} to "skyblock" parsed as world
                    if {island_home::%{_target}%} is set:
                        teleport player to {island_home::%{_target}%}
                    else:
                        set {_targetLoc} to location(({island::%{_target}%::x} + 0.5), 151, ({island::%{_target}%::z} + 2.5), {_w})
                        teleport player to {_targetLoc}
                    applyIslandBorder(player, {_target})
                    send title "&b&l✦ ÎLE DE %{_target}% ✦" with subtitle "&7Bonne visite !" to player for 2 seconds
                    send "{@prefix}&7Téléporté sur l'île de &f%{_target}%&7 !" to player
                    play sound "entity.experience_orb.pickup" to player
                else:
                    send "{@prefix}&cLe joueur &f%{_target}% &cn'a pas encore d'île Skyblock !" to player
            else:
                send "{@prefix}&cUtilisation: &e/is visit <pseudo>" to player
            stop

        # 10. INFOS D'ÎLE (/is info [pseudo])
        else if {_cmd} is "info":
            set {_targetOwner} to player
            if {_target} is set:
                set {_targetOwner} to {_target}
            else:
                set {_targetOwner} to {_owner}

            if {island::%{_targetOwner}%::x} is set:
                set {_lvl} to {island_level::%{_targetOwner}%} ? 10
                set {_bank} to {island_bank::%{_targetOwner}%} ? 0
                set {_gen} to {island_upgrades::%{_targetOwner}%::gen} ? 1
                set {_likes} to {island_likes::%{_targetOwner}%} ? 0
                set {_teamSize} to size of {island_team::%{_targetOwner}%::*}

                send "" to player
                send "&e&l✦ INFORMATIONS DU DOMAINE ✦" to player
                send "&7• Propriétaire : &e%{_targetOwner}%" to player
                send "&7• Niveau de l'île : &b%{_lvl}% ⭐" to player
                send "&7• Coffre-fort Banque : &a%{_bank}%$" to player
                send "&7• Générateur central : &6Niveau %{_gen}%/4 (Multi-Blocs)" to player
                send "&7• Réputation : &c❤ %{_likes}% Likes" to player
                send "&7• Membres dans l'équipe : &f%{_teamSize}%" to player
                send "" to player
                play sound "block.note_block.pling" to player
            else:
                send "{@prefix}&cAucune île trouvée pour ce joueur." to player
            stop

        # 11. BOUTIQUE SKYBLOCK (/is shop)
        else if {_cmd} is "shop" or "boutique" or "magasin":
            execute player command "is-gui-shop"
            stop

        # 12. RÉPARER / RÉGÉNÉRER L'ÎLE
        else if {_cmd} is "fix" or "regen" or "rebuild":
            if {island::%{_owner}%::x} is set:
                createIsland(player, {island::%{_owner}%::x}, {island::%{_owner}%::z})
                set {_w} to {island::%{_owner}%::world}
                if {_w} is not set:
                    set {_w} to world "skyblock"
                if {_w} is not set:
                    set {_w} to "skyblock" parsed as world
                set {_targetLoc} to location(({island::%{_owner}%::x} + 0.5), 151, ({island::%{_owner}%::z} + 2.5), {_w})
                teleport player to {_targetLoc}
                send "{@prefix}&aÎle céleste et générateur régénérés avec succès !" to player
                play sound "block.anvil.use" to player
            else:
                send "{@prefix}&cTu n'as pas encore d'île !" to player
            stop

        # 13. BANQUE D'ÎLE (/is bank)
        else if {_cmd} is "bank" or "banque":
            if {_target} is not set:
                execute player command "is-gui-bank"
                stop
            if {_target} is "deposit" or "deposer":
                if {_val} is set:
                    if {_val} > 0:
                        if player's balance >= {_val}:
                            remove {_val} from player's balance
                            add {_val} to {island_bank::%{_owner}%}
                            send "{@prefix}&a+ %{_val}%$ &7déposés dans la banque de l'île ! (Solde: &e%{island_bank::%{_owner}%}%$&7)" to player
                            play sound "entity.experience_orb.pickup" to player
                        else:
                            send "{@prefix}&cTu n'as pas assez d'argent !" to player
                    else:
                        send "{@prefix}&cMontant invalide." to player
                else:
                    execute player command "is-gui-bank"
            else if {_target} is "withdraw" or "retirer":
                if {_val} is set:
                    if {_val} > 0:
                        if {island_bank::%{_owner}%} >= {_val}:
                            subtract {_val} from {island_bank::%{_owner}%}
                            add {_val} to player's balance
                            send "{@prefix}&a+ %{_val}%$ &7retirés de la banque de l'île ! (Solde: &e%{island_bank::%{_owner}%}%$&7)" to player
                            play sound "entity.experience_orb.pickup" to player
                        else:
                            send "{@prefix}&cLa banque de l'île ne possède pas assez de fonds !" to player
                    else:
                        send "{@prefix}&cMontant invalide." to player
                else:
                    execute player command "is-gui-bank"
            else:
                execute player command "is-gui-bank"
            stop

        # 14. MEMBRES & CO-OP (/is team)
        else if {_cmd} is "team" or "membres" or "coop" or "member":
            execute player command "is-gui-team"
            stop

        # 15. BOOSTERS (/is boosters)
        else if {_cmd} is "booster" or "boosters" or "boost":
            execute player command "is-gui-boosters"
            stop

        # 16. RESET & CONFIRMATION DE RESET (/is reset, /is confirm)
        else if {_cmd} is "reset" or "recommencer":
            if {island::%player%::x} is set:
                set {island_confirm::%player%} to true
                send "{@prefix}&c&lATTENTION ! &7Tu es sur le point de supprimer entièrement ton île !" to player
                send "{@prefix}&7Pour confirmer définitivement, tape : &e/is confirm" to player
            else:
                send "{@prefix}&cTu ne possèdes aucune île à réinitialiser !" to player
            stop

        else if {_cmd} is "confirm":
            if {island_confirm::%player%} is set:
                delete {island_confirm::%player%}
                set {_oldx} to {island::%player%::x}
                set {_oldz} to {island::%player%::z}
                set {_oldworld} to {island::%player%::world}
                set {_centerLoc} to location({_oldx}, 150, {_oldz}, {_oldworld})
                loop entities in radius 50 of {_centerLoc}:
                    if loop-entity is not a player:
                        delete loop-entity
                loop integers from -25 to 25:
                    set {_dx} to loop-integer-1
                    loop integers from -25 to 25:
                        set {_dz} to loop-integer-2
                        loop integers from 70 to 190:
                            set {_bLoc} to location(({_oldx} + {_dx}), loop-integer-3, ({_oldz} + {_dz}), {_oldworld})
                            if block at {_bLoc} is not air:
                                if block at {_bLoc} is chest or trapped chest or barrel or hopper or furnace or dropper or dispenser:
                                    clear inventory of block at {_bLoc}
                                set block at {_bLoc} to air
                loop entities in radius 50 of {_centerLoc}:
                    if loop-entity is not a player:
                        delete loop-entity
                delete {island::%player%::*}
                delete {island_home::%player%}
                delete {island_upgrades::%player%::*}
                delete {island_bank::%player%}
                delete {island_likes::%player%}
                delete {island_team::%player%::*}
                send "{@prefix}&aÎle entièrement réinitialisée ! Nouvelle île en cours de création..." to player
                execute player command "is-create"
            else:
                send "{@prefix}&cFais &e/is reset &cd'abord pour initier la confirmation." to player
            stop

        # 17. SOUS-MENUS
        else if {_cmd} is "upgrades" or "ameliorations":
            execute player command "is-gui-upgrades"
            stop
        else if {_cmd} is "biomes" or "biome":
            execute player command "is-gui-biomes"
            stop
        else if {_cmd} is "settings" or "parametres" or "mobs" or "mob" or "monstres" or "animaux":
            execute player command "is-gui-mobs"
            stop
        else if {_cmd} is "top" or "classement":
            execute player command "is-gui-top"
            stop
        else if {_cmd} is "quests" or "missions" or "quetes":
            execute player command "is-gui-quests"
            stop
        else if {_cmd} is "border" or "bordure" or "barrier" or "barriere" or "limite":
            execute player command "is-gui-border"
            stop

        # ==================== MENU SKYBLOCK MODERNE & ÉPURÉ (4 RANGÉES) ====================
        set {_gui} to a new chest inventory with 4 rows named "<#FFA502>&lMINE<#FFFFFF>&lSTARS &8▸ &eSkyblock Céleste"
        
        # Fond sombre & bordures dorées
        loop 36 times:
            set slot (loop-number - 1) of {_gui} to 1 of gray stained glass pane named "&8✦"
            
        set slot 0 of {_gui} to 1 of yellow stained glass pane named " "
        set slot 8 of {_gui} to 1 of yellow stained glass pane named " "
        set slot 27 of {_gui} to 1 of yellow stained glass pane named " "
        set slot 35 of {_gui} to 1 of yellow stained glass pane named " "

        # Profil du Joueur & Île (Slot 4)
        set {_lvl} to {island_level::%{_owner}%} ? 10
        set {_bank} to {island_bank::%{_owner}%} ? 0
        set {_genLvl} to {island_upgrades::%{_owner}%::gen} ? 1
        set {_rad} to getIslandRadius({_owner})
            
        set slot 4 of {_gui} to 1 of nether star named "<#FFA502>&l✦ DOMAINE : &f&l%{_owner}% <#FFA502>&l✦" with lore "&8&m─────────────────────" and "&8▸ &7Niveau : &e★ %{_lvl}% &8┃ &7Banque : &a%{_bank}%$" and "&8▸ &7Rayon : <#00D4FF>%{_rad}% blocs &8┃ &7Générateur : &6Tier %{_genLvl}%/4" and "&8&m─────────────────────"

        # ==================== LIGNE 2 : ACTIONS PRINCIPALES ====================
        
        # 1. Mon Île / Créer mon Île (Slot 11)
        if {island::%{_owner}%::x} is set:
            set slot 11 of {_gui} to 1 of grass block named "<#2ED573>&l✦ MON DOMAINE ✦" with lore "&8&m─────────────────────" and "&8▸ &7Téléportation immédiate sur ton île" and "&8&m─────────────────────" and "&a▶ Se téléporter (/is home)"
        else:
            set slot 11 of {_gui} to 1 of grass block named "<#2ED573>&l✦ CRÉER MON ÎLE ✦" with lore "&8&m─────────────────────" and "&8▸ &7Génère ton île flottante de départ" and "&8&m─────────────────────" and "&a▶ Cliquer pour créer"

        # 2. Améliorations du Domaine (Slot 13)
        set slot 13 of {_gui} to 1 of diamond pickaxe named "<#FFA502>&l✦ UPGRADES & TIER ✦" with lore "&8&m─────────────────────" and "&8▸ &7Générateur, Taille (jusqu'à 400m) & Coop" and "&8&m─────────────────────" and "&e▶ Ouvrir les Upgrades"

        # 3. Boutique Skyblock (Slot 15)
        set slot 15 of {_gui} to 1 of emerald named "<#2ED573>&l✦ BOUTIQUE & SHOP ✦" with lore "&8&m─────────────────────" and "&8▸ &7Vends minerais & achète des blocs" and "&8&m─────────────────────" and "&a▶ Ouvrir le Shop"

        # ==================== LIGNE 3 : GESTION & ÉQUIPE ====================

        # 4. Banque d'Île (Slot 20)
        set slot 20 of {_gui} to 1 of gold ingot named "<#F1C40F>&l✦ BANQUE D'ÎLE ✦" with lore "&8&m─────────────────────" and "&8▸ &7Coffre partagé : &e%{_bank}%$" and "&8&m─────────────────────" and "&a▶ Déposer / Retirer"

        # 5. Membres & Équipe (Slot 22)
        set slot 22 of {_gui} to 1 of player head named "<#00D4FF>&l✦ COOP & ÉQUIPE ✦" with lore "&8&m─────────────────────" and "&8▸ &7Gérer membres & permissions d'île" and "&8&m─────────────────────" and "&e▶ Gérer l'équipe (/is team)"

        # 6. Mode Vol (Fly) (Slot 24)
        set slot 24 of {_gui} to 1 of feather named "<#00D4FF>&l✦ PASS VOL (FLY) ✦" with lore "&8&m─────────────────────" and "&8▸ &7Vole librement sur ton île" and "&8&m─────────────────────" and "&a▶ Activer / Gérer"

        # ==================== LIGNE 4 : RACCOURCIS ====================

        # 7. Définir le spawn de l'île (Slot 29)
        set slot 29 of {_gui} to 1 of compass named "<#00D4FF>&l✦ DÉFINIR LE SPAWN ✦" with lore "&8&m─────────────────────" and "&8▸ &7Enregistre ton point d'arrivée" and "&8&m─────────────────────" and "&e▶ Définir ici (/is sethome)"

        # 8. Mobs & Paramètres (Slot 30)
        set slot 30 of {_gui} to 1 of zombie head named "<#FFA502>&l✦ MOBS & SÉCURITÉ ✦" with lore "&8&m─────────────────────" and "&8▸ &7Hostiles, Animaux, Visiteurs & Anti-Creeper" and "&8&m─────────────────────" and "&e▶ Configurer (/is mobs)"

        # 9. Bordure & Limite Céleste (Slot 31)
        set slot 31 of {_gui} to 1 of barrier named "<#FF4757>&l✦ BARRIÈRE LASER ✦" with lore "&8&m─────────────────────" and "&8▸ &7Rayon actuel : <#FF4757>%{_rad}% blocs" and "&8&m─────────────────────" and "&c▶ Configurer (/is border)"

        # 10. Missions & Quêtes (Slot 33)
        set slot 33 of {_gui} to 1 of book named "<#E056FD>&l✦ MISSIONS & DÉFIS ✦" with lore "&8&m─────────────────────" and "&8▸ &7Accomplis 8 quêtes & gagne du cash" and "&8&m─────────────────────" and "&d▶ Voir les défis"

        open {_gui} to player
        play sound "block.amethyst_block.hit" to player

# ==================== SOUS-MENUS DU SKYBLOCK ====================

# 1. MENU DES AMÉLIORATIONS
command /is-gui-upgrades:
    trigger:
        set {_gui} to a new chest inventory with 3 rows named "<#FFA502>&lMINE<#FFFFFF>&lSTARS &8▸ &6Améliorations d'Île"
        loop 27 times:
            set slot (loop-number - 1) of {_gui} to gray stained glass pane named "&8✦"
            
        set {_u} to uuid of player
        set {_owner} to "%player%"
        if {island_team_owner::%{_u}%} is set:
            set {_owner} to "%{island_team_owner::%{_u}%}%"
        else if {island_team_owner::%player%} is set:
            set {_owner} to "%{island_team_owner::%player%}%"

        set {_genLvl} to {island_upgrades::%{_owner}%::gen} ? 1
        set {_sizeLvl} to {island_upgrades::%{_owner}%::size} ? 1
        set {_rad} to getIslandRadius({_owner})
            
        # Upgrade Générateur (Slot 10)
        if {_genLvl} is 1:
            set slot 10 of {_gui} to cobblestone named "<#F1C40F>&l✦ GÉNÉRATEUR : TIER 1 ✦" with lore "&8&m─────────────────────" and "&8▸ &7Pierres, Charbon, Fer, Bois & Sols" and "&8▸ &7Prochain : &6Or, Lapis, Redstone, Quartz (Tier 2)" and "&8▸ &7Prix : &a25,000$" and "&8&m─────────────────────" and "&e▶ Cliquer pour passer au Tier 2"
        else if {_genLvl} is 2:
            set slot 10 of {_gui} to iron ore named "<#FFA502>&l✦ GÉNÉRATEUR : TIER 2 ✦" with lore "&8&m─────────────────────" and "&8▸ &7Fer, Or, Lapis, Redstone, Quartz" and "&8▸ &7Prochain : &bDiamants, Émeraudes, Obsidienne (Tier 3)" and "&8▸ &7Prix : &a75,000$" and "&8&m─────────────────────" and "&e▶ Cliquer pour passer au Tier 3"
        else if {_genLvl} is 3:
            set slot 10 of {_gui} to diamond ore named "<#00D4FF>&l✦ GÉNÉRATEUR : TIER 3 ✦" with lore "&8&m─────────────────────" and "&8▸ &7Deepslate, Diamants, Émeraudes, Nether" and "&8▸ &7Prochain : &dAncient Debris, Netherite & Jackpots (Tier MAX)" and "&8▸ &7Prix : &a150,000$" and "&8&m─────────────────────" and "&e▶ Cliquer pour passer au Tier MAX"
        else:
            set slot 10 of {_gui} to ancient debris named "<#E056FD>&l✦ GÉNÉRATEUR : TIER COSMIQUE (MAX) ✦" with lore "&8&m─────────────────────" and "&8▸ &7TOUS les minerais & blocs rares de Minecraft !" and "&8&m─────────────────────" and "&a✔ Niveau Maximum Atteint"

        # Upgrade Taille & Bordure d'Île (Slot 12)
        if {_sizeLvl} is 1:
            set slot 12 of {_gui} to beacon named "<#00D4FF>&l✦ TAILLE : 100x100 (50m) ✦" with lore "&8&m─────────────────────" and "&8▸ &7Prochain palier : <#FFA502>150x150 (75m)" and "&8▸ &7Prix : &a20,000$" and "&8&m─────────────────────" and "&e▶ Agrandir"
        else if {_sizeLvl} is 2:
            set slot 12 of {_gui} to beacon named "<#00D4FF>&l✦ TAILLE : 150x150 (75m) ✦" with lore "&8&m─────────────────────" and "&8▸ &7Prochain palier : <#FFA502>200x200 (100m)" and "&8▸ &7Prix : &a50,000$" and "&8&m─────────────────────" and "&e▶ Agrandir"
        else if {_sizeLvl} is 3:
            set slot 12 of {_gui} to beacon named "<#00D4FF>&l✦ TAILLE : 200x200 (100m) ✦" with lore "&8&m─────────────────────" and "&8▸ &7Prochain palier : <#FFA502>300x300 (150m)" and "&8▸ &7Prix : &a100,000$" and "&8&m─────────────────────" and "&e▶ Agrandir"
        else if {_sizeLvl} is 4:
            set slot 12 of {_gui} to beacon named "<#00D4FF>&l✦ TAILLE : 300x300 (150m) ✦" with lore "&8&m─────────────────────" and "&8▸ &7Prochain palier : <#FFA502>400x400 (200m - MAX)" and "&8▸ &7Prix : &a200,000$" and "&8&m─────────────────────" and "&e▶ Agrandir"
        else:
            set slot 12 of {_gui} to nether star named "<#00D4FF>&l✦ TAILLE : 400x400 (MAX) ✦" with lore "&8&m─────────────────────" and "&8▸ &7Rayon maximal atteint (400x400)" and "&8&m─────────────────────" and "&a✔ Taille Maximale Atteinte"

        # Upgrade Vitesse de Pousse (Slot 14)
        set slot 14 of {_gui} to wheat named "<#2ED573>&l✦ FERTILITÉ DES CULTURES ✦" with lore "&8&m─────────────────────" and "&8▸ &7Croissance accélérée des récoltes" and "&8▸ &7Prix : &a30,000$" and "&8&m─────────────────────" and "&e▶ Activer le boost"

        # Upgrade Limite Membres (Slot 16)
        set slot 16 of {_gui} to player head named "<#FD79A8>&l✦ TAILLE D'ÉQUIPE (8 COOP) ✦" with lore "&8&m─────────────────────" and "&8▸ &7Jusqu'à 8 membres sur ton île" and "&8▸ &7Prix : &a20,000$" and "&8&m─────────────────────" and "&e▶ Débloquer"

        # Retour
        set slot 22 of {_gui} to arrow named "&c« Retour au Menu"
        open {_gui} to player
        play sound "block.wooden_button.click_on" to player

# 1b. MENU DE GESTION DE LA BORDURE CÉLESTE
command /is-gui-border:
    trigger:
        set {_gui} to a new chest inventory with 3 rows named "<#FF4757>&lMINE<#FFFFFF>&lSTARS &8▸ &cBordure Céleste"
        loop 27 times:
            set slot (loop-number - 1) of {_gui} to gray stained glass pane named "&8✦"
        set slot 0 of {_gui} to red stained glass pane named " "
        set slot 8 of {_gui} to red stained glass pane named " "
        set slot 18 of {_gui} to red stained glass pane named " "
        set slot 26 of {_gui} to red stained glass pane named " "
            
        set {_u} to uuid of player
        set {_owner} to "%player%"
        if {island_team_owner::%{_u}%} is set:
            set {_owner} to "%{island_team_owner::%{_u}%}%"
        else if {island_team_owner::%player%} is set:
            set {_owner} to "%{island_team_owner::%player%}%"

        set {_rad} to getIslandRadius({_owner})
        
        # 1. Statut de la Barrière
        set slot 10 of {_gui} to 1 of barrier named "&c&lBordure Physique" with lore "&8&m─────────────────────" and "&8▸ &7Domaine : &f%{_owner}%" and "&8▸ &7Rayon : <#FF4757>%{_rad}% blocs &8(&7%{_rad}*2%x%{_rad}*2%&8)" and "&8▸ &7Protection : &aActive" and "&8&m─────────────────────"
        
        # 2. Toggle Particules
        if {border_particle::%{_u}%} is false:
            set slot 12 of {_gui} to red dye named "&7Mur Laser : &c✖ Inactif" with lore "&8&m─────────────────────" and "&8▸ &7Affiche un mur de lasers visibles" and "&8▸ &7à l'approche de la limite." and "&8&m─────────────────────" and "&e▶ Cliquer pour &aActiver"
        else:
            set slot 12 of {_gui} to lime dye named "&aMur Laser : &a✔ Actif" with lore "&8&m─────────────────────" and "&8▸ &7Mur laser visible actif." and "&8&m─────────────────────" and "&e▶ Cliquer pour &cDésactiver"
            
        # 3. Couleur des Particules
        set {_col} to {border_color::%{_u}%} ? "rouge"
        set slot 14 of {_gui} to red dye named "&6Teinte Laser : &e%{_col}%" with lore "&8&m─────────────────────" and "&8▸ &7Couleurs : &cRouge &8┃ &bCyan &8┃ &aVert &8┃ &6Or" and "&8&m─────────────────────" and "&e▶ Cliquer pour changer de couleur"
        
        # 4. Agrandir l'île
        set slot 16 of {_gui} to beacon named "&6&lAgrandir la Bordure" with lore "&8&m─────────────────────" and "&8▸ &7Augmente la taille jusqu'à 400x400." and "&8&m─────────────────────" and "&e▶ Cliquer pour ouvrir les Upgrades"
        
        # Retour
        set slot 22 of {_gui} to arrow named "&c« Retour au Menu"
        open {_gui} to player
        play sound "block.amethyst_block.hit" to player

# 2. MENU DES MISSIONS & DÉFIS (8 QUÊTES COMPLÈTES)
command /is-gui-quests:
    trigger:
        set {_gui} to a new chest inventory with 4 rows named "<#FFA502>&lMINE<#FFFFFF>&lSTARS &8▸ &6Quêtes Skyblock"
        loop 36 times:
            set slot (loop-number - 1) of {_gui} to gray stained glass pane named "&8✦"
        set slot 0 of {_gui} to orange stained glass pane named " "
        set slot 8 of {_gui} to orange stained glass pane named " "
        set slot 27 of {_gui} to orange stained glass pane named " "
        set slot 35 of {_gui} to orange stained glass pane named " "

        # Défi 1
        if {island_quest_1::%player%} is true:
            set slot 10 of {_gui} to cobblestone named "&a&l1. Premiers Pas &8(&a✔ Validé&8)" with lore "&8&m─────────────────────" and "&8▸ &7Objectif : Miner le générateur" and "&8▸ &7Gain : &a+1,000$ &7+ &e16 Terres" and "&8&m─────────────────────"
        else:
            set slot 10 of {_gui} to cobblestone named "&e&l1. Premiers Pas" with lore "&8&m─────────────────────" and "&8▸ &7Objectif : Miner le générateur" and "&8▸ &7Gain : &a+1,000$ &7+ &e16 Terres" and "&8&m─────────────────────" and "&e▶ Cliquer pour réclamer"

        # Défi 2
        if {island_quest_2::%player%} is true:
            set slot 11 of {_gui} to oak log named "&a&l2. Bûcheron &8(&a✔ Validé&8)" with lore "&8&m─────────────────────" and "&8▸ &7Objectif : Récolter 32 bûches" and "&8▸ &7Gain : &a+1,500$ &7+ &61 Pomme Dorée" and "&8&m─────────────────────"
        else:
            set slot 11 of {_gui} to oak log named "&6&l2. Bûcheron" with lore "&8&m─────────────────────" and "&8▸ &7Objectif : Récolter 32 bûches" and "&8▸ &7Gain : &a+1,500$ &7+ &61 Pomme Dorée" and "&8&m─────────────────────" and "&e▶ Cliquer pour réclamer"

        # Défi 3
        if {island_quest_3::%player%} is true:
            set slot 12 of {_gui} to bread named "&a&l3. Agriculteur &8(&a✔ Validé&8)" with lore "&8&m─────────────────────" and "&8▸ &7Objectif : Récolter blé & pain" and "&8▸ &7Gain : &a+2,000$ &7+ &a4 Graines Melon" and "&8&m─────────────────────"
        else:
            set slot 12 of {_gui} to bread named "&a&l3. Agriculteur" with lore "&8&m─────────────────────" and "&8▸ &7Objectif : Récolter blé & pain" and "&8▸ &7Gain : &a+2,000$ &7+ &a4 Graines Melon" and "&8&m─────────────────────" and "&e▶ Cliquer pour réclamer"

        # Défi 4
        if {island_quest_4::%player%} is true:
            set slot 13 of {_gui} to obsidian named "&a&l4. Portail Nether &8(&a✔ Validé&8)" with lore "&8&m─────────────────────" and "&8▸ &7Objectif : Construire portail Nether" and "&8▸ &7Gain : &a+5,000$ &7+ &b5 Diamants" and "&8&m─────────────────────"
        else:
            set slot 13 of {_gui} to obsidian named "&d&l4. Portail Nether" with lore "&8&m─────────────────────" and "&8▸ &7Objectif : Construire portail Nether" and "&8▸ &7Gain : &a+5,000$ &7+ &b5 Diamants" and "&8&m─────────────────────" and "&e▶ Cliquer pour réclamer"

        # Défi 5
        if {island_quest_5::%player%} is true:
            set slot 14 of {_gui} to diamond pickaxe named "&a&l5. Mineur d'Élite &8(&a✔ Validé&8)" with lore "&8&m─────────────────────" and "&8▸ &7Objectif : Générateur Niv 2+" and "&8▸ &7Gain : &a+7,500$ &7+ &b3 Diamants" and "&8&m─────────────────────"
        else:
            set slot 14 of {_gui} to diamond pickaxe named "&b&l5. Mineur d'Élite" with lore "&8&m─────────────────────" and "&8▸ &7Objectif : Générateur Niv 2+" and "&8▸ &7Gain : &a+7,500$ &7+ &b3 Diamants" and "&8&m─────────────────────" and "&e▶ Cliquer pour réclamer"

        # Défi 6
        if {island_quest_6::%player%} is true:
            set slot 15 of {_gui} to gold block named "&a&l6. Gestionnaire &8(&a✔ Validé&8)" with lore "&8&m─────────────────────" and "&8▸ &7Objectif : 10,000$ en banque" and "&8▸ &7Gain : &a+10,000$ &7+ &e32 Fers" and "&8&m─────────────────────"
        else:
            set slot 15 of {_gui} to gold block named "&6&l6. Gestionnaire" with lore "&8&m─────────────────────" and "&8▸ &7Objectif : 10,000$ en banque" and "&8▸ &7Gain : &a+10,000$ &7+ &e32 Fers" and "&8&m─────────────────────" and "&e▶ Cliquer pour réclamer"

        # Défi 7
        if {island_quest_7::%player%} is true:
            set slot 16 of {_gui} to gold ingot named "&a&l7. Banquier Céleste &8(&a✔ Validé&8)" with lore "&8&m─────────────────────" and "&8▸ &7Objectif : 50,000$ en banque" and "&8▸ &7Gain : &a+15,000$ &7+ &81 Netherite" and "&8&m─────────────────────"
        else:
            set slot 16 of {_gui} to gold ingot named "&e&l7. Banquier Céleste" with lore "&8&m─────────────────────" and "&8▸ &7Objectif : 50,000$ en banque" and "&8▸ &7Gain : &a+15,000$ &7+ &81 Netherite" and "&8&m─────────────────────" and "&e▶ Cliquer pour réclamer"

        # Défi 8 (Ultime)
        if {island_quest_8::%player%} is true:
            set slot 22 of {_gui} to nether star named "&a&l8. Seigneur des Nuages &8(&a✔ Validé&8)" with lore "&8&m─────────────────────" and "&8▸ &7Objectif : Niveau 100⭐ d'île" and "&8▸ &7Gain : &a+50,000$ &7+ &e1 Totem &7+ &616 Pommes d'or" and "&8&m─────────────────────"
        else:
