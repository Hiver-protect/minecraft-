# 7. MENU GESTION & PASS VOL TEMPORAIRE (FLY)
command /is-gui-fly:
    trigger:
        set {_gui} to a new chest inventory with 3 rows named "<#00D2D3>&lMINE<#FFFFFF>&lSTARS &8▸ &bPass Vol Céleste"
        loop 27 times:
            set slot (loop-number - 1) of {_gui} to gray stained glass pane named "&8✦"
        set slot 0 of {_gui} to cyan stained glass pane named " "
        set slot 8 of {_gui} to cyan stained glass pane named " "
        set slot 18 of {_gui} to cyan stained glass pane named " "
        set slot 26 of {_gui} to cyan stained glass pane named " "

        # Statut Actuel du Joueur
        set {_status} to "&cInactif"
        set {_canToggle} to false
        if player is op:
            set {_status} to "&a&lILLIMITÉ (OP)"
            set {_canToggle} to true
        else if {island_fly_expire::%player%} is set:
            if now < {island_fly_expire::%player%}:
                set {_rem} to difference between {island_fly_expire::%player%} and now
                set {_status} to "&a&lACTIF &8(&e%{_rem}%&8)"
                set {_canToggle} to true

        # En-tête profil Fly (Slot 4)
        set slot 4 of {_gui} to feather named "&b&lStatut Vol : %{_status}%" with lore "&8&m─────────────────────" and "&8▸ &7Valable uniquement sur l'île Skyblock." and "&8&m─────────────────────"

        # Bouton Activer / Désactiver (Slot 10)
        if player's flight mode is true:
            set slot 10 of {_gui} to lime dye named "&aVol : &a✔ En cours" with lore "&8&m─────────────────────" and "&8▸ &7Vous volez actuellement." and "&8&m─────────────────────" and "&c▶ Cliquer pour Désactiver"
        else:
            if {_canToggle} is true:
                set slot 10 of {_gui} to gray dye named "&7Vol : &7✖ En pause" with lore "&8&m─────────────────────" and "&8▸ &7Pass disponible." and "&8&m─────────────────────" and "&a▶ Cliquer pour Activer"
            else:
                set slot 10 of {_gui} to barrier named "&cVol : &c✖ Aucun pass" with lore "&8&m─────────────────────" and "&8▸ &7Achetez un forfait ci-dessous." and "&8&m─────────────────────"

        # Forfaits de temps
        set slot 12 of {_gui} to clock named "&e&lPass 15 Minutes" with lore "&8&m─────────────────────" and "&8▸ &7Durée : &e15 min &8┃ &7Prix : &a3,000$" and "&8&m─────────────────────" and "&e▶ Cliquer pour acheter"
        set slot 13 of {_gui} to clock named "&6&lPass 1 Heure" with lore "&8&m─────────────────────" and "&8▸ &7Durée : &61 heure &8┃ &7Prix : &a8,000$" and "&8&m─────────────────────" and "&e▶ Cliquer pour acheter"
        set slot 15 of {_gui} to gold ingot named "&b&lPass 24 Heures &6★" with lore "&8&m─────────────────────" and "&8▸ &7Durée : &b24 heures &8┃ &7Prix : &a20,000$" and "&8&m─────────────────────" and "&e▶ Cliquer pour acheter"
        set slot 16 of {_gui} to nether star named "&d&lPass 7 Jours &d👑" with lore "&8&m─────────────────────" and "&8▸ &7Durée : &d7 jours &8┃ &7Prix : &a60,000$" and "&8&m─────────────────────" and "&e▶ Cliquer pour acheter"

        set slot 22 of {_gui} to arrow named "&c« Retour au Menu"
        open {_gui} to player
        play sound "block.wooden_button.click_on" to player

# 8. MENU BANQUE INTERACTIVE
command /is-gui-bank:
    trigger:
        set {_gui} to a new chest inventory with 3 rows named "<#FFA502>&lMINE<#FFFFFF>&lSTARS &8▸ &6Banque de l'Île"
        loop 27 times:
            set slot (loop-number - 1) of {_gui} to gray stained glass pane named "&8✦"
        set slot 0 of {_gui} to yellow stained glass pane named " "
        set slot 8 of {_gui} to yellow stained glass pane named " "
        set slot 18 of {_gui} to yellow stained glass pane named " "
        set slot 26 of {_gui} to yellow stained glass pane named " "

        set {_u} to uuid of player
        set {_owner} to "%player%"
        if {island_team_owner::%{_u}%} is set:
            set {_owner} to "%{island_team_owner::%{_u}%}%"
        else if {island_team_owner::%player%} is set:
            set {_owner} to "%{island_team_owner::%player%}%"

        set {_bank} to {island_bank::%{_owner}%}
        if {_bank} is not set:
            set {_bank} to 0

        # Solde (Slot 4)
        set slot 4 of {_gui} to gold block named "&6&lCoffre de l'Île : &e%{_bank}%$" with lore "&8&m─────────────────────" and "&8▸ &7Domaine : &f%{_owner}%" and "&8▸ &7Votre Solde : &a%player's balance%$" and "&8&m─────────────────────"

        # Déposer (Slots 10, 11, 12)
        set slot 10 of {_gui} to green stained glass pane named "&a&l+ Déposer 1,000$" with lore "&8&m─────────────────────" and "&8▸ &7Ajoute 1,000$ en banque." and "&8&m─────────────────────" and "&a▶ Cliquer pour déposer"
        set slot 11 of {_gui} to lime stained glass pane named "&a&l+ Déposer 10,000$" with lore "&8&m─────────────────────" and "&8▸ &7Ajoute 10,000$ en banque." and "&8&m─────────────────────" and "&a▶ Cliquer pour déposer"
        set slot 12 of {_gui} to emerald named "&a&l+ Tout Déposer" with lore "&8&m─────────────────────" and "&8▸ &7Dépose l'intégralité de vos fonds." and "&8&m─────────────────────" and "&a▶ Cliquer pour tout déposer"

        # Retirer (Slots 14, 15, 16)
        set slot 14 of {_gui} to red stained glass pane named "&c&l- Retirer 1,000$" with lore "&8&m─────────────────────" and "&8▸ &7Retire 1,000$ de la banque." and "&8&m─────────────────────" and "&c▶ Cliquer pour retirer"
        set slot 15 of {_gui} to red stained glass pane named "&c&l- Retirer 10,000$" with lore "&8&m─────────────────────" and "&8▸ &7Retire 10,000$ de la banque." and "&8&m─────────────────────" and "&c▶ Cliquer pour retirer"
        set slot 16 of {_gui} to redstone named "&c&l- Tout Retirer" with lore "&8&m─────────────────────" and "&8▸ &7Retire tous les fonds d'île." and "&8&m─────────────────────" and "&c▶ Cliquer pour tout retirer"

        set slot 22 of {_gui} to arrow named "&c« Retour au Menu"
        open {_gui} to player
        play sound "block.wooden_button.click_on" to player

