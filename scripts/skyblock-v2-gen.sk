        # Rejoindre / TP sur l'île
        set slot 10 of {_gui} to grass block named "&a&lRejoindre le Domaine" with lore "&8&m─────────────────────" and "&8▸ &7Téléportation au spawn d'île." and "&8&m─────────────────────" and "&e▶ Cliquer pour te téléporter"

