# 4. MENU DES PARAMÈTRES & MOBS SKYBLOCK
command /is-gui-settings:
    aliases: /is-gui-mobs
    trigger:
        set {_gui} to a new chest inventory with 3 rows named "<#70A1FF>&lMINE<#FFFFFF>&lSTARS &8▸ &bParamètres & Mobs"
        loop 27 times:
            set slot (loop-number - 1) of {_gui} to gray stained glass pane named "&8✦"
        set slot 0 of {_gui} to light blue stained glass pane named " "
        set slot 8 of {_gui} to light blue stained glass pane named " "
        set slot 18 of {_gui} to light blue stained glass pane named " "
        set slot 26 of {_gui} to light blue stained glass pane named " "

        set {_u} to uuid of player
        set {_owner} to "%player%"
        if {island_team_owner::%{_u}%} is set:
            set {_owner} to "%{island_team_owner::%{_u}%}%"
        else if {island_team_owner::%player%} is set:
            set {_owner} to "%{island_team_owner::%player%}%"

        # 1. Visiteurs (Slot 10)
        if {island_locked::%{_owner}%} is true:
            set slot 10 of {_gui} to iron door named "&cVisiteurs : &c✖ Fermé" with lore "&8&m─────────────────────" and "&8▸ &7Visites interdites aux inconnus." and "&8&m─────────────────────" and "&e▶ Cliquer pour &aOuvrir"
        else:
            set slot 10 of {_gui} to oak door named "&aVisiteurs : &a✔ Ouvert" with lore "&8&m─────────────────────" and "&8▸ &7Tout le monde peut visiter l'île." and "&8&m─────────────────────" and "&e▶ Cliquer pour &cFermer"

        # 2. Spawn Monstres Hostiles (Slot 11)
        if {island_mobs_hostile::%{_owner}%} is false:
            set slot 11 of {_gui} to rotten flesh named "&cMonstres : &c✖ Inactifs" with lore "&8&m─────────────────────" and "&8▸ &7Aucun monstre n'apparaît." and "&8&m─────────────────────" and "&e▶ Cliquer pour &aActiver"
        else:
            set slot 11 of {_gui} to zombie head named "&aMonstres : &a✔ Actifs" with lore "&8&m─────────────────────" and "&8▸ &7Zombies, squelettes, etc." and "&8&m─────────────────────" and "&e▶ Cliquer pour &cDésactiver"

        # 3. PvP (Slot 12)
        if {island_pvp::%{_owner}%} is true:
            set slot 12 of {_gui} to diamond sword named "&cPvP : &c✔ Autorisé" with lore "&8&m─────────────────────" and "&8▸ &7Les combats sont actifs sur l'île." and "&8&m─────────────────────" and "&e▶ Cliquer pour &aDésactiver"
        else:
            set slot 12 of {_gui} to wooden sword named "&aPvP : &a✖ Désactivé" with lore "&8&m─────────────────────" and "&8▸ &7Combats désactivés (sécurisé)." and "&8&m─────────────────────" and "&e▶ Cliquer pour &cActiver"

        # 4. Coffres Visiteurs (Slot 14)
        if {island_chest_protect::%{_owner}%} is false:
            set slot 14 of {_gui} to chest named "&cCoffres Visiteurs : &c✖ Libres" with lore "&8&m─────────────────────" and "&8▸ &7Les visiteurs peuvent ouvrir !" and "&8&m─────────────────────" and "&e▶ Cliquer pour &aProtéger"
        else:
            set slot 14 of {_gui} to ender chest named "&aCoffres Visiteurs : &a✔ Protégés" with lore "&8&m─────────────────────" and "&8▸ &7Réservé aux membres de l'île." and "&8&m─────────────────────" and "&e▶ Cliquer pour &cLibérer"

        # 5. Animaux Passifs (Slot 15)
        if {island_mobs_passive::%{_owner}%} is false:
            set slot 15 of {_gui} to bone named "&cAnimaux : &c✖ Inactifs" with lore "&8&m─────────────────────" and "&8▸ &7Aucun animal naturel n'apparaît." and "&8&m─────────────────────" and "&e▶ Cliquer pour &aActiver"
        else:
            set slot 15 of {_gui} to wheat named "&aAnimaux : &a✔ Actifs" with lore "&8&m─────────────────────" and "&8▸ &7Vaches, cochons, moutons, poules." and "&8&m─────────────────────" and "&e▶ Cliquer pour &cDésactiver"

        # 6. Mode Vol (Slot 16)
        set slot 16 of {_gui} to feather named "&bGestion du Vol (Fly)" with lore "&8&m─────────────────────" and "&8▸ &7Gérer vos pass et temps de vol." and "&8&m─────────────────────" and "&e▶ Cliquer pour ouvrir le menu Fly"

        set slot 22 of {_gui} to arrow named "&c« Retour au Menu"
        open {_gui} to player
        play sound "block.wooden_button.click_on" to player

