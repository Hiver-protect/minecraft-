# 11. CRÉATION D'ÎLE INTERNE
command /is-create:
    trigger:
        set {_w} to world "skyblock"
        if {_w} is not set:
            set {_w} to "skyblock" parsed as world
        if {_w} is not set:
            set {_w} to world of player
            
        set {_x} to {skyblock_next_x}
        set {_z} to {skyblock_next_z}

        set {island::%player%::x} to {_x}
        set {island::%player%::z} to {_z}
        set {island::%player%::world} to {_w}
        set {island::%player%::owner} to uuid of player

        createIsland(player, {_x}, {_z})

        add {@distance} to {skyblock_next_x}
        if {skyblock_next_x} > 100000:
            set {skyblock_next_x} to 0
            add {@distance} to {skyblock_next_z}

        set {_targetLoc} to location(({_x} + 0.5), 151, ({_z} + 2.5), {_w})
        teleport player to {_targetLoc}
        play sound "entity.player.levelup" to player

# Intérêts quotidiens de banque (1% par jour de connexion)
every 24 hours:
    loop all players:
        set {_u} to uuid of loop-player
        set {_owner} to "%loop-player%"
        if {island_team_owner::%{_u}%} is set:
            set {_owner} to "%{island_team_owner::%{_u}%}%"
        else if {island_team_owner::%loop-player%} is set:
            set {_owner} to "%{island_team_owner::%loop-player%}%"

        if {island_bank::%{_owner}%} > 1000:
            set {_interest} to round({island_bank::%{_owner}%} * 0.01)
            if {_interest} > 50000:
                set {_interest} to 50000
            add {_interest} to {island_bank::%{_owner}%}
            send "{@prefix}&aIntérêts de banque quotidiens : &e+%{_interest}%$&a ajoutés au coffre de l'île (&e%{_owner}%&a) !" to loop-player

# ==================== AUTO-REPLANT SUR L'ÎLE SKYBLOCK ====================

on break:
    if "%world of player%" contains "skyblock":
        set {_b} to "%event-block%"
        if {_b} contains "wheat" or "carrot" or "potato" or "beetroot":
            wait 2 ticks
            set block at event-location to event-block
            play sound "block.crop.plant" with pitch 1.5 to player

# ==================== GESTION DES CLICS GUI ====================

on inventory click:
    # 1. MENU PRINCIPAL SKYBLOCK (4 RANGÉES)
    if name of event-inventory contains "Skyblock Céleste" or name of event-inventory contains "SKYBLOCK":
        cancel event
        
        # Rejoindre / Créer mon île (Slot 11)
        if index of event-slot is 11:
            close player's inventory
            set {_u} to uuid of player
            set {_owner} to "%player%"
            if {island_team_owner::%{_u}%} is set:
                set {_owner} to "%{island_team_owner::%{_u}%}%"
            else if {island_team_owner::%player%} is set:
                set {_owner} to "%{island_team_owner::%player%}%"

            if {island::%{_owner}%::x} is set:
                execute player command "is home"
            else:
                execute player command "is-create"

        # Améliorations & Upgrades (Slot 13)
        else if index of event-slot is 13:
            execute player command "is-gui-upgrades"

        # Boutique & Vente (Slot 15)
        else if index of event-slot is 15:
            execute player command "is-gui-shop"

        # Banque d'île (Slot 20)
        else if index of event-slot is 20:
            execute player command "is-gui-bank"

        # Membres & Équipe (Slot 22)
        else if index of event-slot is 22:
            execute player command "is-gui-team"

        # Vol / Fly (Slot 24)
        else if index of event-slot is 24:
            execute player command "is-gui-fly"

        # Définir le spawn (Slot 29)
        else if index of event-slot is 29:
            close player's inventory
            execute player command "is sethome"

        # Mobs & Paramètres (Slot 30)
        else if index of event-slot is 30:
            execute player command "is-gui-mobs"

        # Bordure & Limite (Slot 31)
        else if index of event-slot is 31:
            execute player command "is-gui-border"

        # Missions & Quêtes (Slot 33)
        else if index of event-slot is 33:
            execute player command "is-gui-quests"

    # 2. MENU UPGRADES
    else if name of event-inventory contains "Améliorations" or name of event-inventory contains "AMÉLIORATIONS":
        cancel event
        if index of event-slot is 22:
            execute player command "is"
            stop

        set {_u} to uuid of player
        set {_owner} to "%player%"
        if {island_team_owner::%{_u}%} is set:
            set {_owner} to "%{island_team_owner::%{_u}%}%"
        else if {island_team_owner::%player%} is set:
            set {_owner} to "%{island_team_owner::%player%}%"

        # Générateur Upgrade (Slot 10)
        if index of event-slot is 10:
            set {_lvl} to {island_upgrades::%{_owner}%::gen} ? 1
            if {_lvl} is 1:
                if player's balance >= 25000:
                    remove 25000 from player's balance
                    set {island_upgrades::%{_owner}%::gen} to 2
                    add 25 to {island_level::%{_owner}%}
                    send "{@prefix}&aGénérateur central amélioré au Tier 2 ! (+ Or, Redstone, Lapis, Quartz, Améthyste)" to player
                    play sound "entity.player.levelup" to player
                    execute player command "is-gui-upgrades"
                else:
                    send "{@prefix}&cIl te faut 25,000$ pour cette amélioration !" to player
            else if {_lvl} is 2:
                if player's balance >= 75000:
                    remove 75000 from player's balance
                    set {island_upgrades::%{_owner}%::gen} to 3
                    add 50 to {island_level::%{_owner}%}
                    send "{@prefix}&aGénérateur central amélioré au Tier 3 ! (+ Diamants, Émeraudes, Obsidienne, Prisme)" to player
                    play sound "entity.player.levelup" to player
                    execute player command "is-gui-upgrades"
                else:
                    send "{@prefix}&cIl te faut 75,000$ pour cette amélioration !" to player
            else if {_lvl} is 3:
                if player's balance >= 150000:
                    remove 150000 from player's balance
                    set {island_upgrades::%{_owner}%::gen} to 4
                    add 100 to {island_level::%{_owner}%}
                    send "{@prefix}&aGénérateur central amélioré au TIER COSMIQUE MAX ! (+ Ancient Debris & TOUS les blocs de Minecraft)" to player
                    play sound "entity.player.levelup" to player
                    execute player command "is-gui-upgrades"
                else:
                    send "{@prefix}&cIl te faut 150,000$ pour cette amélioration !" to player

        # Taille & Extension de Bordure (Slot 12)
        else if index of event-slot is 12:
            set {_sizeLvl} to {island_upgrades::%{_owner}%::size} ? 1
            if {_sizeLvl} is 1:
                if player's balance >= 20000:
                    remove 20000 from player's balance
                    set {island_upgrades::%{_owner}%::size} to 2
                    add 20 to {island_level::%{_owner}%}
                    applyIslandBorder(player, {_owner})
                    send "{@prefix}&aTaille de ton île agrandie à &e150x150 blocs (Rayon: 75m) &a!" to player
                    play sound "ui.toast.challenge_complete" to player
                    execute player command "is-gui-upgrades"
                else:
                    send "{@prefix}&cIl te faut 20,000$ pour cette extension !" to player
            else if {_sizeLvl} is 2:
                if player's balance >= 50000:
                    remove 50000 from player's balance
                    set {island_upgrades::%{_owner}%::size} to 3
                    add 50 to {island_level::%{_owner}%}
                    applyIslandBorder(player, {_owner})
                    send "{@prefix}&aTaille de ton île agrandie à &e200x200 blocs (Rayon: 100m) &a!" to player
                    play sound "ui.toast.challenge_complete" to player
                    execute player command "is-gui-upgrades"
                else:
                    send "{@prefix}&cIl te faut 50,000$ pour cette extension !" to player
            else if {_sizeLvl} is 3:
                if player's balance >= 100000:
                    remove 100000 from player's balance
                    set {island_upgrades::%{_owner}%::size} to 4
                    add 100 to {island_level::%{_owner}%}
                    applyIslandBorder(player, {_owner})
                    send "{@prefix}&aTaille de ton île agrandie à &e300x300 blocs (Rayon: 150m) &a!" to player
                    play sound "ui.toast.challenge_complete" to player
                    execute player command "is-gui-upgrades"
                else:
                    send "{@prefix}&cIl te faut 100,000$ pour cette extension !" to player
            else if {_sizeLvl} is 4:
                if player's balance >= 200000:
                    remove 200000 from player's balance
                    set {island_upgrades::%{_owner}%::size} to 5
                    add 200 to {island_level::%{_owner}%}
                    applyIslandBorder(player, {_owner})
                    send "{@prefix}&aTaille de ton île agrandie au &eMAXIMUM : 400x400 blocs (Rayon: 200m) &a!" to player
                    play sound "ui.toast.challenge_complete" to player
                    execute player command "is-gui-upgrades"
                else:
                    send "{@prefix}&cIl te faut 200,000$ pour cette extension maximale !" to player

        # Fertilité (Slot 14)
        else if index of event-slot is 14:
            if player's balance >= 30000:
                remove 30000 from player's balance
                send "{@prefix}&aBoost de fertilité activé sur ton île !" to player
                play sound "entity.player.levelup" to player
            else:
                send "{@prefix}&cIl te faut 30,000$ pour cette amélioration !" to player

        # Membres (Slot 16)
        else if index of event-slot is 16:
            if player's balance >= 20000:
                remove 20000 from player's balance
                send "{@prefix}&aCapacité de ton équipe augmentée à 8 membres !" to player
                play sound "entity.player.levelup" to player
            else:
                send "{@prefix}&cIl te faut 20,000$ pour cette amélioration !" to player

    # 2b. MENU BORDURE & BARRIÈRE CÉLESTE
    else if name of event-inventory contains "Bordure Céleste" or name of event-inventory contains "BORDURE":
        cancel event
        set {_u} to uuid of player
        if index of event-slot is 22:
            execute player command "is"
            stop
            
        # Toggle Particules (Slot 12)
        if index of event-slot is 12:
            if {border_particle::%{_u}%} is false:
                set {border_particle::%{_u}%} to true
                send "{@prefix}&aMur de bordure rouge visible activé !" to player
            else:
                set {border_particle::%{_u}%} to false
                send "{@prefix}&cMur de bordure rouge désactivé (gain de FPS)." to player
            play sound "block.note_block.hat" to player
            execute player command "is-gui-border"
            
        # Changer Couleur (Slot 14)
        else if index of event-slot is 14:
            set {_col} to {border_color::%{_u}%} ? "rouge"
            if {_col} is "rouge":
                set {border_color::%{_u}%} to "cyan"
            else if {_col} is "cyan":
                set {border_color::%{_u}%} to "vert"
            else if {_col} is "vert":
                set {border_color::%{_u}%} to "or"
            else if {_col} is "or":
                set {border_color::%{_u}%} to "rose"
            else:
                set {border_color::%{_u}%} to "rouge"
            send "{@prefix}&aCouleur de bordure changée pour : &e%{border_color::%{_u}%}%" to player
            play sound "block.note_block.bell" to player
            execute player command "is-gui-border"
            
        # Agrandir l'île (Slot 16)
        else if index of event-slot is 16:
            execute player command "is-gui-upgrades"

    # 3. MENU MISSIONS & DÉFIS
    else if name of event-inventory contains "Quêtes Skyblock" or name of event-inventory contains "MISSIONS":
        cancel event
        if index of event-slot is 31:
            execute player command "is"
            stop

        if index of event-slot is 10:
            if {island_quest_1::%player%} is not set:
                set {island_quest_1::%player%} to true
                execute console command "eco give %player% 1000"
                give 16 dirt to player
                add 10 to {island_level::%player%}
                send "{@prefix}&aDéfi 1 validé ! Récompense: +1,000$ et 16 Terres !" to player
                play sound "entity.player.levelup" to player
                execute player command "is-gui-quests"
            else:
                send "{@prefix}&cTu as déjà validé ce défi !" to player

        else if index of event-slot is 11:
            if {island_quest_2::%player%} is not set:
                set {island_quest_2::%player%} to true
                execute console command "eco give %player% 1500"
                give 1 golden apple to player
                add 15 to {island_level::%player%}
                send "{@prefix}&aDéfi 2 validé ! Récompense: +1,500$ et 1 Pomme Dorée !" to player
                play sound "entity.player.levelup" to player
                execute player command "is-gui-quests"
            else:
                send "{@prefix}&cTu as déjà validé ce défi !" to player

        else if index of event-slot is 12:
            if {island_quest_3::%player%} is not set:
                set {island_quest_3::%player%} to true
                execute console command "eco give %player% 2000"
                give 4 melon seeds to player
                add 20 to {island_level::%player%}
                send "{@prefix}&aDéfi 3 validé ! Récompense: +2,000$ et 4 Graines de Melon !" to player
                play sound "entity.player.levelup" to player
                execute player command "is-gui-quests"
            else:
                send "{@prefix}&cTu as déjà validé ce défi !" to player

        else if index of event-slot is 13:
            if {island_quest_4::%player%} is not set:
                set {island_quest_4::%player%} to true
                execute console command "eco give %player% 5000"
                give 5 diamonds to player
                add 30 to {island_level::%player%}
                send "{@prefix}&aDéfi 4 validé ! Récompense: +5,000$ et 5 Diamants !" to player
                play sound "entity.player.levelup" to player
                execute player command "is-gui-quests"
            else:
                send "{@prefix}&cTu as déjà validé ce défi !" to player

        else if index of event-slot is 14:
            if {island_quest_5::%player%} is not set:
                set {island_quest_5::%player%} to true
                execute console command "eco give %player% 7500"
                give 3 diamonds to player
                add 40 to {island_level::%player%}
                send "{@prefix}&aDéfi 5 validé ! Récompense: +7,500$ et 3 Diamants !" to player
                play sound "entity.player.levelup" to player
                execute player command "is-gui-quests"
            else:
                send "{@prefix}&cTu as déjà validé ce défi !" to player

        else if index of event-slot is 15:
            if {island_quest_6::%player%} is not set:
                set {_u} to uuid of player
                set {_owner} to "%player%"
                if {island_team_owner::%{_u}%} is set:
                    set {_owner} to "%{island_team_owner::%{_u}%}%"
                else if {island_team_owner::%player%} is set:
                    set {_owner} to "%{island_team_owner::%player%}%"

                if {island_bank::%{_owner}%} >= 10000:
                    set {island_quest_6::%player%} to true
                    execute console command "eco give %player% 10000"
                    give 32 iron ingots to player
                    add 50 to {island_level::%{_owner}%}
                    send "{@prefix}&aDéfi 6 validé ! Récompense: +10,000$ et 32 Fers !" to player
                    play sound "entity.player.levelup" to player
                    execute player command "is-gui-quests"
                else:
                    send "{@prefix}&cDépose au moins 10,000$ dans ta banque d'île pour valider ce défi !" to player
            else:
                send "{@prefix}&cTu as déjà validé ce défi !" to player

        else if index of event-slot is 16:
            if {island_quest_7::%player%} is not set:
                set {island_quest_7::%player%} to true
                execute console command "eco give %player% 15000"
                give 1 netherite ingot to player
                add 60 to {island_level::%player%}
                send "{@prefix}&aDéfi 7 validé ! Récompense: +15,000$ et 1 Lingot de Netherite !" to player
                play sound "entity.player.levelup" to player
                execute player command "is-gui-quests"
            else:
                send "{@prefix}&cTu as déjà validé ce défi !" to player

        else if index of event-slot is 22:
            if {island_quest_8::%player%} is not set:
                set {island_quest_8::%player%} to true
                execute console command "eco give %player% 50000"
                give 1 totem of undying to player
                give 16 golden apples to player
                add 100 to {island_level::%player%}
                send "{@prefix}&aDéfi 8 validé ! Récompense Ultime : +50,000$, 1 Totem et 16 Pommes Dorées !" to player
                play sound "entity.player.levelup" to player
                execute player command "is-gui-quests"
            else:
                send "{@prefix}&cTu as déjà validé ce défi !" to player

    # 4. MENU BIOMES
    else if name of event-inventory contains "Biomes de l'Île" or name of event-inventory contains "BIOME":
        cancel event
        if index of event-slot is 22:
            execute player command "is"
            stop

        set {_u} to uuid of player
        set {_owner} to "%player%"
        if {island_team_owner::%{_u}%} is set:
            set {_owner} to "%{island_team_owner::%{_u}%}%"
        else if {island_team_owner::%player%} is set:
            set {_owner} to "%{island_team_owner::%player%}%"

        if index of event-slot is 10:
            send "{@prefix}&aBiome Plaines appliqué à ton île !" to player
            play sound "block.grass.break" to player
        else if index of event-slot is 11:
            if player's balance >= 5000:
                remove 5000 from player's balance
                send "{@prefix}&aBiome Désert appliqué !" to player
                play sound "block.sand.break" to player
            else:
                send "{@prefix}&cIl te faut 5,000$ pour ce biome !" to player
        else if index of event-slot is 12:
            if player's balance >= 10000:
                remove 10000 from player's balance
                send "{@prefix}&aBiome Jungle appliqué !" to player
                play sound "block.azalea_leaves.break" to player
            else:
                send "{@prefix}&cIl te faut 10,000$ pour ce biome !" to player
        else if index of event-slot is 13:
            if player's balance >= 10000:
                remove 10000 from player's balance
                send "{@prefix}&aBiome Taïga appliqué !" to player
                play sound "block.wood.break" to player
            else:
                send "{@prefix}&cIl te faut 10,000$ pour ce biome !" to player
        else if index of event-slot is 14:
            if player's balance >= 15000:
                remove 15000 from player's balance
                send "{@prefix}&aBiome Océan appliqué !" to player
                play sound "item.bucket.fill" to player
            else:
                send "{@prefix}&cIl te faut 15,000$ pour ce biome !" to player
        else if index of event-slot is 15:
            if player's balance >= 25000:
                remove 25000 from player's balance
                send "{@prefix}&aBiome Nether appliqué !" to player
                play sound "block.fire.ambient" to player
            else:
                send "{@prefix}&cIl te faut 25,000$ pour ce biome !" to player
        else if index of event-slot is 16:
            if player's balance >= 35000:
                remove 35000 from player's balance
                send "{@prefix}&aBiome End appliqué !" to player
                play sound "entity.enderman.teleport" to player
            else:
                send "{@prefix}&cIl te faut 35,000$ pour ce biome !" to player

    # 5. MENU BOOSTERS
    else if name of event-inventory contains "Boosters" or name of event-inventory contains "BOOSTERS":
        cancel event
        if index of event-slot is 22:
            execute player command "is"
            stop

        if index of event-slot is 11:
            if player's balance >= 15000:
                remove 15000 from player's balance
                send "{@prefix}&aBooster Double XP activé sur ton île pendant 1 heure !" to player
                play sound "entity.player.levelup" to player
            else:
                send "{@prefix}&cIl te faut 15,000$ pour ce booster !" to player
        else if index of event-slot is 13:
            if player's balance >= 10000:
                remove 10000 from player's balance
                send "{@prefix}&aBooster Croissance Rapide activé sur ton île pendant 1 heure !" to player
                play sound "entity.player.levelup" to player
            else:
                send "{@prefix}&cIl te faut 10,000$ pour ce booster !" to player
        else if index of event-slot is 15:
            if player's balance >= 25000:
                remove 25000 from player's balance
                send "{@prefix}&aBooster Vente +25%% activé sur ton île pendant 1 heure !" to player
                play sound "entity.player.levelup" to player
            else:
                send "{@prefix}&cIl te faut 25,000$ pour ce booster !" to player

    # 7. MENU PARAMÈTRES & MOBS
    else if name of event-inventory contains "Paramètres & Mobs" or name of event-inventory contains "PARAMÈTRES" or name of event-inventory contains "GESTION MOBS":
        cancel event
        if index of event-slot is 22:
            execute player command "is"
            stop

        set {_u} to uuid of player
        set {_owner} to "%player%"
        if {island_team_owner::%{_u}%} is set:
            set {_owner} to "%{island_team_owner::%{_u}%}%"
        else if {island_team_owner::%player%} is set:
            set {_owner} to "%{island_team_owner::%player%}%"

        # Visiteurs (Slot 10)
        if index of event-slot is 10:
            if {island_locked::%{_owner}%} is true:
                delete {island_locked::%{_owner}%}
                send "{@prefix}&aTon île est désormais OUVERTE aux visiteurs !" to player
            else:
                set {island_locked::%{_owner}%} to true
                send "{@prefix}&cTon île est désormais VERROUILLÉE aux visiteurs !" to player
            play sound "block.note_block.pling" to player
            execute player command "is-gui-settings"

        # Monstres Hostiles (Slot 11)
        else if index of event-slot is 11:
            if {island_mobs_hostile::%{_owner}%} is false:
                delete {island_mobs_hostile::%{_owner}%}
                send "{@prefix}&aLe spawn des MONSTRES est désormais ACTIVÉ sur ton île !" to player
            else:
                set {island_mobs_hostile::%{_owner}%} to false
                send "{@prefix}&cLe spawn des MONSTRES est désormais DÉSACTIVÉ sur ton île !" to player
            play sound "entity.zombie.ambient" to player
            execute player command "is-gui-settings"

        # PvP (Slot 12)
        else if index of event-slot is 12:
            if {island_pvp::%{_owner}%} is true:
                delete {island_pvp::%{_owner}%}
                send "{@prefix}&aLe PvP est désormais DÉSACTIVÉ sur ton île !" to player
            else:
                set {island_pvp::%{_owner}%} to true
                send "{@prefix}&cLe PvP est désormais ACTIVÉ sur ton île !" to player
            play sound "block.note_block.pling" to player
            execute player command "is-gui-settings"

        # Protection coffres (Slot 14)
        else if index of event-slot is 14:
            if {island_chest_protect::%{_owner}%} is false:
                set {island_chest_protect::%{_owner}%} to true
                send "{@prefix}&aTes coffres sont désormais PROTÉGÉS des visiteurs !" to player
            else:
                set {island_chest_protect::%{_owner}%} to false
                send "{@prefix}&cTes coffres sont désormais ACCESSIBLES aux visiteurs !" to player
            play sound "block.note_block.pling" to player
            execute player command "is-gui-settings"

        # Animaux Passifs (Slot 15)
        else if index of event-slot is 15:
            if {island_mobs_passive::%{_owner}%} is false:
                delete {island_mobs_passive::%{_owner}%}
                send "{@prefix}&aLe spawn des ANIMAUX est désormais ACTIVÉ sur ton île !" to player
            else:
                set {island_mobs_passive::%{_owner}%} to false
                send "{@prefix}&cLe spawn des ANIMAUX est désormais DÉSACTIVÉ sur ton île !" to player
            play sound "entity.cow.ambient" to player
            execute player command "is-gui-settings"

        # Vol / Fly (Slot 16)
        else if index of event-slot is 16:
            execute player command "is-gui-fly"

    # 8. MENU ÉQUIPE COOP
    else if name of event-inventory contains "Équipe & Coop" or name of event-inventory contains "GESTION D'ÉQUIPE":
        cancel event
        if index of event-slot is 22:
            execute player command "is"
        else if index of event-slot is 10:
            close player's inventory
            execute player command "is home"
        else if index of event-slot is 14:
            close player's inventory
            send "{@prefix}&7Pour inviter un ami sur ton île, tape : &e/is invite <pseudo>" to player
            play sound "block.note_block.pling" to player
        else if index of event-slot is 16:
            close player's inventory
            execute player command "is leave"

    # 8bis. RETOUR TOP
    else if name of event-inventory contains "Top Îles" or name of event-inventory contains "CLASSEMENT":
        cancel event
        if index of event-slot is 22:
            execute player command "is"

    # 9. MENU GESTION & PASS VOL TEMPORAIRE
    else if name of event-inventory contains "Pass Vol Céleste" or name of event-inventory contains "PASS VOL":
        cancel event
        if index of event-slot is 22:
            execute player command "is"
            stop

        # Bouton Activer / Désactiver le vol (Slot 10)
        if index of event-slot is 10:
            set {_hasFly} to false
            if player is op:
                set {_hasFly} to true
            else if {island_fly_expire::%player%} is set:
                if now < {island_fly_expire::%player%}:
                    set {_hasFly} to true

            if {_hasFly} is true:
                if player's flight mode is true:
                    set player's flight mode to false
                    send "{@prefix}&cMode vol désactivé !" to player
                    play sound "block.wooden_button.click_off" to player
                else:
                    set player's flight mode to true
                    set {_rem} to difference between {island_fly_expire::%player%} and now
                    send "{@prefix}&aMode vol activé ! &7(Temps restant: &e%{_rem}%&7)" to player
                    play sound "block.wooden_button.click_on" to player
                execute player command "is-gui-fly"
            else:
                send "{@prefix}&cChoisis un forfait de temps ci-dessous pour activer le vol !" to player
                play sound "block.anvil.land" to player

        # Pass 15 Minutes (Slot 12 - 3,000$)
        else if index of event-slot is 12:
            if player's balance >= 3000:
                remove 3000 from player's balance
                if {island_fly_expire::%player%} is set:
                    if now < {island_fly_expire::%player%}:
                        add 15 minutes to {island_fly_expire::%player%}
                    else:
                        set {island_fly_expire::%player%} to now
                        add 15 minutes to {island_fly_expire::%player%}
                else:
                    set {island_fly_expire::%player%} to now
                    add 15 minutes to {island_fly_expire::%player%}
                set player's flight mode to true
                set {_rem} to difference between {island_fly_expire::%player%} and now
                send "{@prefix}&aPass Vol 15 Minutes activé ! &7(Temps restant: &e%{_rem}%&7)" to player
                play sound "entity.player.levelup" to player
                execute player command "is-gui-fly"
            else:
                send "{@prefix}&cIl te faut 3,000$ pour le Pass Vol 15min !" to player

        # Pass 1 Heure (Slot 13 - 8,000$)
        else if index of event-slot is 13:
            if player's balance >= 8000:
                remove 8000 from player's balance
                if {island_fly_expire::%player%} is set:
                    if now < {island_fly_expire::%player%}:
                        add 1 hour to {island_fly_expire::%player%}
                    else:
                        set {island_fly_expire::%player%} to now
                        add 1 hour to {island_fly_expire::%player%}
                else:
                    set {island_fly_expire::%player%} to now
                    add 1 hour to {island_fly_expire::%player%}
                set player's flight mode to true
                set {_rem} to difference between {island_fly_expire::%player%} and now
                send "{@prefix}&aPass Vol 1 Heure activé ! &7(Temps restant: &e%{_rem}%&7)" to player
                play sound "entity.player.levelup" to player
                execute player command "is-gui-fly"
            else:
                send "{@prefix}&cIl te faut 8,000$ pour le Pass Vol 1h !" to player

        # Pass 24 Heures (Slot 15 - 20,000$)
        else if index of event-slot is 15:
            if player's balance >= 20000:
                remove 20000 from player's balance
                if {island_fly_expire::%player%} is set:
                    if now < {island_fly_expire::%player%}:
                        add 24 hours to {island_fly_expire::%player%}
                    else:
                        set {island_fly_expire::%player%} to now
                        add 24 hours to {island_fly_expire::%player%}
                else:
                    set {island_fly_expire::%player%} to now
                    add 24 hours to {island_fly_expire::%player%}
                set player's flight mode to true
                set {_rem} to difference between {island_fly_expire::%player%} and now
                send "{@prefix}&aPass Vol 24 Heures activé ! &7(Temps restant: &e%{_rem}%&7)" to player
                play sound "entity.player.levelup" to player
                execute player command "is-gui-fly"
            else:
                send "{@prefix}&cIl te faut 20,000$ pour le Pass Vol 24h !" to player

        # Pass 7 Jours (Slot 16 - 60,000$)
        else if index of event-slot is 16:
            if player's balance >= 60000:
                remove 60000 from player's balance
                if {island_fly_expire::%player%} is set:
                    if now < {island_fly_expire::%player%}:
                        add 7 days to {island_fly_expire::%player%}
                    else:
                        set {island_fly_expire::%player%} to now
                        add 7 days to {island_fly_expire::%player%}
                else:
                    set {island_fly_expire::%player%} to now
                    add 7 days to {island_fly_expire::%player%}
                set player's flight mode to true
                set {_rem} to difference between {island_fly_expire::%player%} and now
                send "{@prefix}&aPass Vol 7 Jours activé ! &7(Temps restant: &e%{_rem}%&7)" to player
                play sound "entity.player.levelup" to player
                execute player command "is-gui-fly"
            else:
                send "{@prefix}&cIl te faut 60,000$ pour le Pass Vol 7 Jours !" to player

    # 10. MENU BANQUE INTERACTIVE
    else if name of event-inventory contains "Banque de l'Île" or name of event-inventory contains "BANQUE":
        cancel event
        if index of event-slot is 22:
            execute player command "is"
            stop

        set {_u} to uuid of player
        set {_owner} to "%player%"
        if {island_team_owner::%{_u}%} is set:
            set {_owner} to "%{island_team_owner::%{_u}%}%"
        else if {island_team_owner::%player%} is set:
            set {_owner} to "%{island_team_owner::%player%}%"

        # Déposer 1,000$ (Slot 10)
        if index of event-slot is 10:
            if player's balance >= 1000:
                remove 1000 from player's balance
                add 1000 to {island_bank::%{_owner}%}
                send "{@prefix}&a+ 1,000$ déposés dans la banque de l'île (&e%{_owner}%&a) !" to player
                play sound "entity.experience_orb.pickup" to player
                execute player command "is-gui-bank"
            else:
                send "{@prefix}&cTu n'as pas assez d'argent !" to player

        # Déposer 10,000$ (Slot 11)
        else if index of event-slot is 11:
            if player's balance >= 10000:
                remove 10000 from player's balance
                add 10000 to {island_bank::%{_owner}%}
                send "{@prefix}&a+ 10,000$ déposés dans la banque de l'île (&e%{_owner}%&a) !" to player
                play sound "entity.experience_orb.pickup" to player
                execute player command "is-gui-bank"
            else:
                send "{@prefix}&cTu n'as pas assez d'argent !" to player

        # Déposer Tout (Slot 12)
        else if index of event-slot is 12:
            set {_all} to player's balance
            if {_all} > 0:
                remove {_all} from player's balance
                add {_all} to {island_bank::%{_owner}%}
                send "{@prefix}&a+ %{_all}%$ (Totalité de ton solde) déposés dans la banque !" to player
                play sound "entity.player.levelup" to player
                execute player command "is-gui-bank"
            else:
                send "{@prefix}&cTon solde personnel est vide !" to player

        # Retirer 1,000$ (Slot 14)
        else if index of event-slot is 14:
            if {island_bank::%{_owner}%} >= 1000:
                subtract 1000 from {island_bank::%{_owner}%}
                add 1000 to player's balance
                send "{@prefix}&a+ 1,000$ retirés de la banque !" to player
                play sound "entity.experience_orb.pickup" to player
                execute player command "is-gui-bank"
            else:
                send "{@prefix}&cLa banque ne possède pas assez de fonds !" to player

        # Retirer 10,000$ (Slot 15)
        else if index of event-slot is 15:
            if {island_bank::%{_owner}%} >= 10000:
                subtract 10000 from {island_bank::%{_owner}%}
                add 10000 to player's balance
                send "{@prefix}&a+ 10,000$ retirés de la banque !" to player
                play sound "entity.experience_orb.pickup" to player
                execute player command "is-gui-bank"
            else:
                send "{@prefix}&cLa banque ne possède pas assez de fonds !" to player

        # Retirer Tout (Slot 16)
        else if index of event-slot is 16:
            set {_bankAll} to {island_bank::%{_owner}%}
            if {_bankAll} > 0:
                set {island_bank::%{_owner}%} to 0
                add {_bankAll} to player's balance
                send "{@prefix}&a+ %{_bankAll}%$ (Totalité de la banque) retirés !" to player
                play sound "entity.player.levelup" to player
                execute player command "is-gui-bank"
            else:
                send "{@prefix}&cLa banque est vide !" to player

    # 11. BOUTIQUE & VENTE RAPIDE SKYBLOCK
    else if name of event-inventory contains "Boutique & Vente" or name of event-inventory contains "BOUTIQUE":
        cancel event
        if index of event-slot is 31:
            execute player command "is"
            stop

        # TOUT VENDRE (Slot 4)
        if index of event-slot is 4:
            set {_gained} to 0
            # Pierres
            set {_c} to amount of cobblestone in player's inventory
            if {_c} > 0:
                remove {_c} of cobblestone from player's inventory
                add ({_c} * 1) to {_gained}
            # Charbon
            set {_c} to amount of coal in player's inventory
            if {_c} > 0:
                remove {_c} of coal from player's inventory
                add ({_c} * 6) to {_gained}
            # Fer
            set {_c} to amount of iron ingot in player's inventory
            if {_c} > 0:
                remove {_c} of iron ingot from player's inventory
                add ({_c} * 20) to {_gained}
            # Cuivre
            set {_c} to amount of copper ingot in player's inventory
            if {_c} > 0:
                remove {_c} of copper ingot from player's inventory
                add ({_c} * 15) to {_gained}
            # Or
            set {_c} to amount of gold ingot in player's inventory
            if {_c} > 0:
                remove {_c} of gold ingot from player's inventory
                add ({_c} * 40) to {_gained}
            # Quartz
            set {_c} to amount of quartz in player's inventory
            if {_c} > 0:
                remove {_c} of quartz from player's inventory
                add ({_c} * 25) to {_gained}
            # Améthyste
            set {_c} to amount of amethyst shard in player's inventory
            if {_c} > 0:
                remove {_c} of amethyst shard from player's inventory
                add ({_c} * 35) to {_gained}
            # Diamant
            set {_c} to amount of diamond in player's inventory
            if {_c} > 0:
                remove {_c} of diamond from player's inventory
                add ({_c} * 150) to {_gained}
            # Émeraude
            set {_c} to amount of emerald in player's inventory
            if {_c} > 0:
                remove {_c} of emerald from player's inventory
                add ({_c} * 200) to {_gained}
            # Ancient Debris / Netherite
            set {_c} to amount of ancient debris in player's inventory
            if {_c} > 0:
                remove {_c} of ancient debris from player's inventory
                add ({_c} * 2500) to {_gained}
            set {_c} to amount of netherite scrap in player's inventory
            if {_c} > 0:
                remove {_c} of netherite scrap from player's inventory
                add ({_c} * 3000) to {_gained}
            # Blé & Récoltes
            set {_c} to amount of wheat in player's inventory
            if {_c} > 0:
                remove {_c} of wheat from player's inventory
                add ({_c} * 4) to {_gained}
            
            if {_gained} > 0:
                add {_gained} to player's balance
                send "{@prefix}&aInventaire vendu avec succès ! &6+%{_gained}%$&a reçus !" to player
                play sound "entity.player.levelup" to player
            else:
                send "{@prefix}&cAucun minerai ou récolte à vendre dans ton inventaire !" to player

        # Ventes ciblées
        else if index of event-slot is 10:
            if player has 64 cobblestone:
                remove 64 cobblestone from player's inventory
                add 50 to player's balance
                send "{@prefix}&a+50$ pour 64 Pierres !" to player
                play sound "entity.experience_orb.pickup" to player
            else:
                send "{@prefix}&cIl te faut 64 pierres !" to player
        else if index of event-slot is 11:
            if player has 16 coal:
                remove 16 coal from player's inventory
                add 100 to player's balance
                send "{@prefix}&a+100$ pour 16 Charbons !" to player
                play sound "entity.experience_orb.pickup" to player
            else:
                send "{@prefix}&cIl te faut 16 charbons !" to player
        else if index of event-slot is 12:
            if player has 16 iron ingot:
                remove 16 iron ingot from player's inventory
                add 300 to player's balance
                send "{@prefix}&a+300$ pour 16 Lingots de fer !" to player
                play sound "entity.experience_orb.pickup" to player
            else:
                send "{@prefix}&cIl te faut 16 fers !" to player
        else if index of event-slot is 13:
            if player has 16 gold ingot:
                remove 16 gold ingot from player's inventory
                add 600 to player's balance
                send "{@prefix}&a+600$ pour 16 Lingots d'or !" to player
                play sound "entity.experience_orb.pickup" to player
            else:
                send "{@prefix}&cIl te faut 16 lingots d'or !" to player
        else if index of event-slot is 14:
            if player has 8 diamond:
                remove 8 diamond from player's inventory
                add 1200 to player's balance
                send "{@prefix}&a+1,200$ pour 8 Diamants !" to player
                play sound "entity.experience_orb.pickup" to player
            else:
                send "{@prefix}&cIl te faut 8 diamants !" to player
        else if index of event-slot is 15:
            if player has 8 emerald:
                remove 8 emerald from player's inventory
                add 1600 to player's balance
                send "{@prefix}&a+1,600$ pour 8 Émeraudes !" to player
                play sound "entity.experience_orb.pickup" to player
            else:
                send "{@prefix}&cIl te faut 8 émeraudes !" to player
        else if index of event-slot is 16:
            if player has 1 ancient debris:
                remove 1 ancient debris from player's inventory
                add 2500 to player's balance
                send "{@prefix}&a+2,500$ pour 1 Ancient Debris !" to player
                play sound "entity.experience_orb.pickup" to player
            else:
                send "{@prefix}&cIl te faut 1 ancient debris !" to player

        # Achats ciblés
        else if index of event-slot is 19:
            if player's balance >= 250:
                remove 250 from player's balance
                give 64 dirt to player
                send "{@prefix}&a64 Terres achetées !" to player
                play sound "entity.experience_orb.pickup" to player
            else:
                send "{@prefix}&cPas assez d'argent !" to player
        else if index of event-slot is 20:
            if player's balance >= 300:
                remove 300 from player's balance
                give 64 sand to player
                send "{@prefix}&a64 Sables achetés !" to player
                play sound "entity.experience_orb.pickup" to player
            else:
                send "{@prefix}&cPas assez d'argent !" to player
        else if index of event-slot is 21:
            if player's balance >= 500:
                remove 500 from player's balance
                give 4 packed ice to player
                send "{@prefix}&a4 Glaces Comprimées achetées !" to player
                play sound "entity.experience_orb.pickup" to player
            else:
                send "{@prefix}&cPas assez d'argent !" to player
        else if index of event-slot is 23:
            if player's balance >= 1000:
                remove 1000 from player's balance
                give 1 lava bucket to player
                send "{@prefix}&a1 Seau de lave acheté !" to player
                play sound "entity.experience_orb.pickup" to player
            else:
                send "{@prefix}&cPas assez d'argent !" to player
        else if index of event-slot is 24:
            if player's balance >= 2000:
                remove 2000 from player's balance
                give 2 cow spawn eggs to player
                send "{@prefix}&a2 Œufs de vache achetés !" to player
                play sound "entity.experience_orb.pickup" to player
            else:
                send "{@prefix}&cPas assez d'argent !" to player

    # 12. MENU ADMIN LISTE DES ÎLES
    else if name of event-inventory contains "Îles Skyblock" or name of event-inventory contains "ÎLES SKYBLOCK":
        cancel event
        if event-item is player head:
            set {_headName} to uncolored name of event-item
            replace all "✦ Île de " with "" in {_headName}
            replace all " ✦" with "" in {_headName}
            set {_targetOwner} to {_headName}
            if click type is left mouse button:
                close player's inventory
                execute player command "is tp %{_targetOwner}%"
            else if click type is right mouse button:
                close player's inventory
                send "{@prefix}&ePour régénérer l'île de %{_targetOwner}%, tape : &c/isadmin regen %{_targetOwner}%" to player
                play sound "block.note_block.pling" to player


# ==================== COMMANDES STAFF & JOUEURS POUR LE GÉNÉRATEUR ====================

command /fixgen [<player>]:
    aliases: /isgen, /generateur
    trigger:
        if arg-1 is set:
            if player is op:
                execute player command "is fixgen %arg-1%"
            else if {rank::%uuid of player%} is "Fondateur" or "Admin" or "Resp" or "Modo":
                execute player command "is fixgen %arg-1%"
            else:
                execute player command "is fixgen"
        else:
            execute player command "is fixgen"

command /staffgen [<player>]:
    aliases: /admingen, /forcegen, /setgen
    permission: op
    permission message: &cTu n'as pas la permission!
    trigger:
        if "%world of player%" does not contain "skyblock":
            send "{@prefix}&cTu dois être dans le monde Skyblock !" to player
            stop
            
        set {_targetLoc} to location of targeted block
        if {_targetLoc} is not set:
            set {_targetLoc} to location of block in front of player
        if block at {_targetLoc} is air or water or lava:
            set {_targetLoc} to location of block at player
        set {_locBelow} to location 1 below {_targetLoc}
        set block at {_locBelow} to bedrock
        set block at {_targetLoc} to cobblestone
        
        if arg-1 is set:
            set {_targetLvl} to {island_upgrades::%arg-1%::gen} ? 1
            send "{@prefix}&a✦ Générateur Skyblock (Tier %{_targetLvl}%) placé pour &e%arg-1% &a!" to player
            send "{@prefix}&a✦ Un membre du Staff (&e%player%&a) a replacé ton générateur de minerais !" to arg-1
        else:
            send "{@prefix}&a✦ Générateur Skyblock Staff placé à votre position / cible !" to player
            
        play sound "block.anvil.use" to player
        play sound "entity.player.levelup" to player

command /setgentier <integer> [<player>]:
    permission: op
    permission message: &cTu n'as pas la permission!
    trigger:
        set {_t} to arg-1
        if {_t} < 1:
            set {_t} to 1
        if {_t} > 4:
            set {_t} to 4
        set {_target} to "%player%"
        if arg-2 is set:
            set {_target} to "%arg-2%"
        set {island_upgrades::%{_target}%::gen} to {_t}
        send "{@prefix}&aNiveau de générateur de &e%{_target}% &adéfini au &eTier %{_t}% &a!" to player
        if arg-2 is set:
            send "{@prefix}&aVotre générateur Skyblock a été amélioré au &eTier %{_t}% &apar &e%player% &a!" to arg-2
        play sound "ui.toast.challenge_complete" to player


# ==================== SÉCURITÉ ANTI-CHUTE DANS LE VIDE & KEEP INVENTORY ====================

# 1. Rattrapage automatique dans le vide, Barrière de Bordure Céleste & Gestion d'expiration du Pass Vol
every 10 ticks:
    loop all players:
        # A. Gestion Monde Skyblock
        if "%world of loop-player%" contains "skyblock":
            set {_u} to uuid of loop-player
            set {_owner} to "%loop-player%"
            if {island_team_owner::%{_u}%} is set:
                set {_owner} to "%{island_team_owner::%{_u}%}%"
            else if {island_team_owner::%loop-player%} is set:
                set {_owner} to "%{island_team_owner::%loop-player%}%"

            # 1. Rattrapage de vide (Chute sous Y=60)
            if y-coordinate of loop-player < 60:
                if {island_home::%{_owner}%} is set:
                    teleport loop-player to {island_home::%{_owner}%}
                else if {island::%{_owner}%::x} is set:
                    set {_w} to {island::%{_owner}%::world}
                    if {_w} is not set:
                        set {_w} to world "skyblock"
                    if {_w} is not set:
                        set {_w} to "skyblock" parsed as world
                    set {_targetLoc} to location(({island::%{_owner}%::x} + 0.5), 151, ({island::%{_owner}%::z} + 2.5), {_w})
                    teleport loop-player to {_targetLoc}
                set loop-player's fall distance to 0
                send "{@prefix}&aSauvetage d'urgence ! Tu as été rattrapé dans le vide et ramené sur ton île !" to loop-player
                play sound "entity.enderman.teleport" to loop-player

            # 2. Grosse Bordure Rouge Éclatante & Piliers d'Angles Visibles en Temps Réel
            if {island::%{_owner}%::x} is set:
                set {_isX} to {island::%{_owner}%::x}
                set {_isZ} to {island::%{_owner}%::z}
                set {_px} to x-coordinate of loop-player
                set {_py} to y-coordinate of loop-player
                set {_pz} to z-coordinate of loop-player
                set {_pw} to world of loop-player
                set {_dx} to abs({_px} - {_isX})
                set {_dz} to abs({_pz} - {_isZ})
                set {_maxDist} to max({_dx}, {_dz})
                set {_rad} to getIslandRadius({_owner})

                if {border_particle::%{_u}%} is not false:
                    # A. 4 Piliers d'Angles Lasers Rouges (Visibles en temps réel sur les chunks)
                    loop integers from 0 to 6:
                        set {_beamY} to 148 + (loop-integer * 4)
                        draw 1 of dust using dustOption(rgb(255, 0, 0), 2.5) at location({_isX} + {_rad}, {_beamY}, {_isZ} + {_rad}, {_pw})
                        draw 1 of dust using dustOption(rgb(255, 0, 0), 2.5) at location({_isX} + {_rad}, {_beamY}, {_isZ} - {_rad}, {_pw})
                        draw 1 of dust using dustOption(rgb(255, 0, 0), 2.5) at location({_isX} - {_rad}, {_beamY}, {_isZ} + {_rad}, {_pw})
                        draw 1 of dust using dustOption(rgb(255, 0, 0), 2.5) at location({_isX} - {_rad}, {_beamY}, {_isZ} - {_rad}, {_pw})

                    # B. Grosse Barrière Rouge visible en temps réel à l'approche de la bordure (à moins de 18 blocs)
                    if {_maxDist} >= ({_rad} - 18):
                        # Mur Est (X+)
                        if ({_px} - {_isX}) >= ({_rad} - 18):
                            set {_wallX} to {_isX} + {_rad}
                            loop integers from -4 to 4:
                                set {_dOffset} to loop-integer
                                loop integers from -2 to 3:
                                    set {_yOffset} to loop-integer-2
                                    draw 1 of dust using dustOption(rgb(255, 0, 0), 2.8) at location({_wallX}, {_py} + {_yOffset}, {_pz} + {_dOffset}, {_pw})
                            draw 2 of flame at location({_wallX}, {_py} + 1, {_pz}, {_pw})
                            
                        # Mur Ouest (X-)
                        if ({_isX} - {_px}) >= ({_rad} - 18):
                            set {_wallX} to {_isX} - {_rad}
                            loop integers from -4 to 4:
                                set {_dOffset} to loop-integer
                                loop integers from -2 to 3:
                                    set {_yOffset} to loop-integer-2
                                    draw 1 of dust using dustOption(rgb(255, 0, 0), 2.8) at location({_wallX}, {_py} + {_yOffset}, {_pz} + {_dOffset}, {_pw})
                            draw 2 of flame at location({_wallX}, {_py} + 1, {_pz}, {_pw})

                        # Mur Sud (Z+)
                        if ({_pz} - {_isZ}) >= ({_rad} - 18):
                            set {_wallZ} to {_isZ} + {_rad}
                            loop integers from -4 to 4:
                                set {_dOffset} to loop-integer
                                loop integers from -2 to 3:
                                    set {_yOffset} to loop-integer-2
                                    draw 1 of dust using dustOption(rgb(255, 0, 0), 2.8) at location({_px} + {_dOffset}, {_py} + {_yOffset}, {_wallZ}, {_pw})
                            draw 2 of flame at location({_px}, {_py} + 1, {_wallZ}, {_pw})

                        # Mur Nord (Z-)
                        if ({_isZ} - {_pz}) >= ({_rad} - 18):
                            set {_wallZ} to {_isZ} - {_rad}
                            loop integers from -4 to 4:
                                set {_dOffset} to loop-integer
                                loop integers from -2 to 3:
                                    set {_yOffset} to loop-integer-2
                                    draw 1 of dust using dustOption(rgb(255, 0, 0), 2.8) at location({_px} + {_dOffset}, {_py} + {_yOffset}, {_wallZ}, {_pw})
                            draw 2 of flame at location({_px}, {_py} + 1, {_wallZ}, {_pw})

                        send action bar "&4&l⛔ BORDURE ROUGE CÉLESTE &8| &cRayon: &e%{_rad}%m &8(&4Barrière Active&8)" to loop-player

                # Contact et franchissement de la bordure : Répulsion immédiate & Alerte
                if {_maxDist} >= {_rad}:
                    if loop-player is not op:
                        set {_r} to {rank::%{_u}%} ? "Joueur"
                        if {_r} is not "Fondateur" or "Admin" or "Resp" or "Modo":
                            if gamemode of loop-player is not spectator:
                                set {_centerLoc} to location({_isX}, {_py}, {_isZ}, {_pw})
                                push loop-player towards {_centerLoc} at speed 0.45
                                draw 20 of dust using dustOption(rgb(255, 0, 0), 3.0) at location 1 meter above loop-player
                                draw 5 of flame at location 1.2 meters above loop-player
                                play sound "block.anvil.land" with volume 0.7 and pitch 1.2 to loop-player
                                play sound "block.beacon.deactivate" with volume 0.8 and pitch 1.6 to loop-player
                                send action bar "&4&l⛔ BORDURE D'ÎLE ATTEINTE &8| &cLimite atteinte ! Agrandis ton île avec &e/is upgrade &c!" to loop-player

            # 3. Expiration du Vol en Skyblock
            if loop-player's flight mode is true:
                if loop-player is not op:
                    set {_r} to {rank::%{_u}%} ? "Joueur"
                    if {_r} is not "Fondateur" or "Admin" or "Resp" or "Modo":
                        if {island_fly_expire::%loop-player%} is set:
                            if now >= {island_fly_expire::%loop-player%}:
                                delete {island_fly_expire::%loop-player%}
                                set loop-player's flight mode to false
                                execute console command "effect give %loop-player% slow_falling 6 0 true"
                                send "{@prefix}&c&lPass Vol Expiré ! &7Ton temps de vol est terminé, vol désactivé en douceur." to loop-player
                                play sound "block.wooden_button.click_off" to loop-player
                        else:
                            set loop-player's flight mode to false
                            execute console command "effect give %loop-player% slow_falling 6 0 true"
                            send "{@prefix}&cMode vol désactivé (aucun Pass Vol actif)." to loop-player

        # B. Gestion Monde Survie : Vol strictement interdit aux joueurs
        else if "%world of loop-player%" contains "survie" or "world":
            if loop-player's flight mode is true:
                if loop-player is not op:
                    set {_u} to uuid of loop-player
                    set {_r} to {rank::%{_u}%} ? "Joueur"
                    if {_r} is not "Fondateur" or "Admin" or "Resp" or "Modo":
                        set loop-player's flight mode to false
                        send "{@prefix}&cLe vol (Fly) est désactivé en monde Survie !" to loop-player

# ==================== PROTECTION DE CONSTRUCTION HORS-LIMITE D'ÎLE ====================

on block place:
    if "%world of player%" contains "skyblock":
        if player is not op:
            set {_u} to uuid of player
            set {_r} to {rank::%{_u}%} ? "Joueur"
            if {_r} is not "Fondateur" or "Admin" or "Resp" or "Modo":
                set {_owner} to "%player%"
                if {island_team_owner::%{_u}%} is set:
                    set {_owner} to "%{island_team_owner::%{_u}%}%"
                else if {island_team_owner::%player%} is set:
                    set {_owner} to "%{island_team_owner::%player%}%"
                if {island::%{_owner}%::x} is set:
                    set {_dx} to abs(x-coordinate of event-location - {island::%{_owner}%::x})
                    set {_dz} to abs(z-coordinate of event-location - {island::%{_owner}%::z})
                    set {_maxDist} to max({_dx}, {_dz})
                    set {_rad} to getIslandRadius({_owner})
                    if {_maxDist} > {_rad}:
                        cancel event
                        send action bar "&c&l✦ HORS-LIMITE &8| &7Tu ne peux pas poser de blocs au-delà de ta bordure (%{_rad}%m) !" to player
                        play sound "block.note_block.bass" to player

on block break:
    if "%world of player%" contains "skyblock":
        if block 1 below event-block is not bedrock: # Préserve le générateur infini
            if player is not op:
                set {_u} to uuid of player
                set {_r} to {rank::%{_u}%} ? "Joueur"
                if {_r} is not "Fondateur" or "Admin" or "Resp" or "Modo":
                    set {_owner} to "%player%"
                    if {island_team_owner::%{_u}%} is set:
                        set {_owner} to "%{island_team_owner::%{_u}%}%"
                    else if {island_team_owner::%player%} is set:
                        set {_owner} to "%{island_team_owner::%player%}%"
                    if {island::%{_owner}%::x} is set:
                        set {_dx} to abs(x-coordinate of event-location - {island::%{_owner}%::x})
                        set {_dz} to abs(z-coordinate of event-location - {island::%{_owner}%::z})
                        set {_maxDist} to max({_dx}, {_dz})
                        set {_rad} to getIslandRadius({_owner})
                        if {_maxDist} > {_rad}:
                            cancel event
                            send action bar "&c&l✦ HORS-LIMITE &8| &7Tu ne peux pas casser de blocs au-delà de ta bordure (%{_rad}%m) !" to player
                            play sound "block.note_block.bass" to player

on world change:
    wait 3 ticks
    if "%world of player%" contains "survie" or "world":
        if player is not op:
            set {_u} to uuid of player
            set {_r} to {rank::%{_u}%} ? "Joueur"
            if {_r} is not "Fondateur" or "Admin" or "Resp" or "Modo":
                if player's flight mode is true:
                    set player's flight mode to false
                    send "{@prefix}&cLe vol (Fly) est strictement désactivé dans le monde Survie !" to player
    else if "%world of player%" contains "skyblock":
        set {_u} to uuid of player
        set {_owner} to "%player%"
        if {island_team_owner::%{_u}%} is set:
            set {_owner} to "%{island_team_owner::%{_u}%}%"
        else if {island_team_owner::%player%} is set:
            set {_owner} to "%{island_team_owner::%player%}%"
        applyIslandBorder(player, {_owner})

# 2. Annulation totale des dégâts de vide et de chute extrême en Skyblock
on damage of player:
    if "%world of victim%" contains "skyblock":
        if damage cause is void:
            cancel event
            set {_u} to uuid of victim
            set {_owner} to "%victim%"
            if {island_team_owner::%{_u}%} is set:
                set {_owner} to "%{island_team_owner::%{_u}%}%"
            else if {island_team_owner::%victim%} is set:
                set {_owner} to "%{island_team_owner::%victim%}%"

            if {island_home::%{_owner}%} is set:
                teleport victim to {island_home::%{_owner}%}
            else if {island::%{_owner}%::x} is set:
                set {_w} to {island::%{_owner}%::world}
                if {_w} is not set:
                    set {_w} to world "skyblock"
                if {_w} is not set:
                    set {_w} to "skyblock" parsed as world
                set {_targetLoc} to location(({island::%{_owner}%::x} + 0.5), 151, ({island::%{_owner}%::z} + 2.5), {_w})
                teleport victim to {_targetLoc}
            set victim's fall distance to 0
            send "{@prefix}&aSauvetage d'urgence ! Tu as été ramené sain et sauf sur ton île !" to victim
            play sound "entity.enderman.teleport" to victim
        else if y-coordinate of victim < 70:
            cancel event
            set victim's fall distance to 0

# 3. Conservation permanente de l'inventaire et des niveaux d'XP en Skyblock
on death of player:
    if "%world of victim%" contains "skyblock":
        clear drops
        set {last_death_world::%uuid of victim%} to "skyblock"
        send "{@prefix}&aTon stuff et ton expérience ont été conservés !" to victim

# Réapparition instantanée garantie sur l'île Skyblock
on respawn:
    wait 2 ticks
    set {_u} to uuid of player
    set {_isSky} to false
    if "%world of player%" contains "skyblock":
        set {_isSky} to true
    else if {last_death_world::%{_u}%} is set:
        if "%{last_death_world::%{_u}%}%" contains "skyblock":
            set {_isSky} to true
            
    if {_isSky} is true:
        delete {last_death_world::%{_u}%}
        set {_owner} to "%player%"
        if {island_team_owner::%{_u}%} is set:
            set {_owner} to "%{island_team_owner::%{_u}%}%"
        else if {island_team_owner::%player%} is set:
            set {_owner} to "%{island_team_owner::%player%}%"

        if {island_home::%{_owner}%} is set:
            teleport player to {island_home::%{_owner}%}
            send "{@prefix}&aTu as réapparu sur ton île Skyblock !" to player
            play sound "entity.experience_orb.pickup" to player
        else if {island::%{_owner}%::x} is set:
            set {_w} to {island::%{_owner}%::world}
            if {_w} is not set:
                set {_w} to world "skyblock"
            if {_w} is not set:
                set {_w} to "skyblock" parsed as world
            set {_targetLoc} to location(({island::%{_owner}%::x} + 0.5), 151, ({island::%{_owner}%::z} + 2.5), {_w})
            teleport player to {_targetLoc}
            send "{@prefix}&aTu as réapparu sur ton île Skyblock !" to player
            play sound "entity.experience_orb.pickup" to player

# ==================== SYSTÈME FAST LEAF DECAY & DROPS RÉDUITS ====================

# 1. Quand un joueur coupe un tronc d'arbre : disparition rapide et propre des feuilles
on break:
    set {_b} to "%event-block%"
    if {_b} contains "log" or "stem" or "wood":
        set {_loc} to event-location
        wait 3 ticks
        loop blocks in radius 5 of {_loc}:
            set {_lb} to "%loop-block%"
            if {_lb} contains "leaves":
                # Vérifie s'il n'y a plus de tronc à proximité immédiate
                set {_hasLog} to false
                loop blocks in radius 2 of loop-block:
                    if "%loop-block-2%" contains "log" or "stem" or "wood":
                        set {_hasLog} to true
                if {_hasLog} is false:
                    # Chance équilibrée de loot utile (Pousse d'arbre, bâton ou pomme)
                    set {_r} to random integer between 1 and 20
                    if {_r} is 1:
                        drop 1 of oak sapling at location of loop-block
                    else if {_r} is 2:
                        drop 1 of stick at location of loop-block
                    else if {_r} is 3:
                        if {_lb} contains "oak":
                            drop 1 of apple at location of loop-block
                    set loop-block to air
                    play sound "block.grass.break" with volume 0.3 at location of loop-block

# 2. Quand un joueur casse des feuilles à la main ou à l'outil : 0 encombrement de l'inventaire
on break:
    set {_b} to "%event-block%"
    if {_b} contains "leaves":
        set {_t} to "%player's tool%"
        # Si le joueur n'utilise pas de cisailles (shears), on ne drop pas de blocs de feuilles
        if {_t} does not contain "shears":
            if {_t} does not contain "cisaille":
                clear drops
            set {_r} to random integer between 1 and 15
            if {_r} is 1:
                drop 1 of oak sapling at event-location
            else if {_r} is 2:
                drop 1 of stick at event-location
            else if {_r} is 3:
                if {_b} contains "oak":
                    drop 1 of apple at event-location


# ==================== SYSTÈME DE MINAGE SKYBLOCK & GÉNÉRATEURS ÉQUILIBRÉS ====================

# 1. Transformation équilibrée des générateurs eau/lave naturels selon le Tier d'île
on form of cobblestone or stone or basalt:
    if "%event-world%" contains "skyblock":
        set {_loc} to event-location
        # Détection du propriétaire de l'île proche
        set {_owner} to ""
        loop all players in radius 75 of {_loc}:
            set {_u} to uuid of loop-player
            if {island_team_owner::%{_u}%} is set:
                set {_owner} to "%{island_team_owner::%{_u}%}%"
            else if {island::%loop-player%::x} is set:
                set {_owner} to "%loop-player%"
            exit loop if {_owner} is not ""
            
        set {_genLvl} to {island_upgrades::%{_owner}%::gen} ? 1
        set {_rand} to random integer between 1 and 100
        
        # Palier 1 (Départ - Principalement Cobble & Roches de base)
        if {_genLvl} is 1:
            if {_rand} <= 80:
                set event-block to cobblestone
            else if {_rand} <= 90:
                set event-block to andesite or diorite or stone
            else if {_rand} <= 96:
                set event-block to coal ore
            else if {_rand} <= 99:
                set event-block to copper ore
            else:
                set event-block to iron ore

        # Palier 2 (Mineur Avancé)
        else if {_genLvl} is 2:
            if {_rand} <= 65:
                set event-block to cobblestone or stone
            else if {_rand} <= 77:
                set event-block to deepslate or tuff
            else if {_rand} <= 87:
                set event-block to coal ore or copper ore
            else if {_rand} <= 95:
                set event-block to iron ore
            else if {_rand} <= 98:
                set event-block to lapis ore or redstone ore
            else:
                set event-block to gold ore

        # Palier 3 (Maître des Abysses)
        else if {_genLvl} is 3:
            if {_rand} <= 50:
                set event-block to stone or deepslate or tuff
            else if {_rand} <= 68:
                set event-block to iron ore or deepslate iron ore
            else if {_rand} <= 80:
                set event-block to gold ore or deepslate gold ore
            else if {_rand} <= 90:
                set event-block to redstone ore or lapis ore
            else if {_rand} <= 97:
                set event-block to nether quartz ore or amethyst block
            else:
                set event-block to diamond ore

        # Palier 4 (Cosmique / Max Tier)
        else:
            if {_rand} <= 40:
                set event-block to deepslate or smooth basalt or calcite
            else if {_rand} <= 60:
                set event-block to iron ore or deepslate iron ore
            else if {_rand} <= 75:
                set event-block to gold ore or deepslate gold ore
            else if {_rand} <= 88:
                set event-block to redstone ore or lapis ore or nether quartz ore
            else if {_rand} <= 95:
                set event-block to diamond ore or deepslate diamond ore
            else if {_rand} <= 99:
                set event-block to emerald ore or deepslate emerald ore
            else:
                set event-block to ancient debris

# 2. Régénération réaliste & cadencée du Générateur Central Skyblock (au-dessus de la bedrock - Cooldown 3s)
on break:
    if "%world of player%" contains "skyblock":
        # Détection du bloc au-dessus de la bedrock (Générateur infini de l'île)
        set {_locBelow} to location 1 below event-location
        if block at {_locBelow} is bedrock:
            set {_genLoc} to event-location
            
            # Anti-spam & protection de cooldown
            if {island_gen_cooling::%{_genLoc}%} is true:
                cancel event
                stop
            
            set {island_gen_cooling::%{_genLoc}%} to true
            
            # Effet sonore et particule de forge/refroidissement lors du minage
            play sound "block.fire.extinguish" with pitch 1.8 to player
            
            # Délai de régénération réaliste de 3 secondes (fini le spam abusif de blocs instantanés)
            wait 1.5 seconds
            play sound "block.gravel.place" with pitch 1.5 to player
            wait 1.5 seconds
            
            # Vérifie que la bedrock est toujours présente sous le bloc
            if block at (location 1 below {_genLoc}) is bedrock:
                set {_owner} to "%player%"
                set {_u} to uuid of player
                if {island_team_owner::%{_u}%} is set:
                    set {_owner} to "%{island_team_owner::%{_u}%}%"
                else if {island_team_owner::%player%} is set:
                    set {_owner} to "%{island_team_owner::%player%}%"
                
                set {_genLvl} to {island_upgrades::%{_owner}%::gen} ? 1
                set {_roll} to random integer between 1 and 100
                
                # Tier 1 (Débutant : 75% Cobble, 12% Roches, 8% Charbon, 3% Cuivre, 2% Fer)
                if {_genLvl} is 1:
                    if {_roll} <= 75:
                        set block at {_genLoc} to cobblestone
                    else if {_roll} <= 87:
                        set block at {_genLoc} to andesite or diorite or stone
                    else if {_roll} <= 95:
                        set block at {_genLoc} to coal ore
                    else if {_roll} <= 98:
                        set block at {_genLoc} to copper ore
                    else:
                        set block at {_genLoc} to iron ore

                # Tier 2 (Avancé : 60% Cobble/Pierre, 15% Deepslate, 12% Charbon/Cuivre, 9% Fer, 3% Lapis/Or)
                else if {_genLvl} is 2:
                    if {_roll} <= 60:
                        set block at {_genLoc} to cobblestone or stone
                    else if {_roll} <= 75:
                        set block at {_genLoc} to deepslate or tuff
                    else if {_roll} <= 87:
                        set block at {_genLoc} to coal ore or copper ore
                    else if {_roll} <= 96:
                        set block at {_genLoc} to iron ore
                    else if {_roll} <= 98:
                        set block at {_genLoc} to lapis ore or redstone ore
                    else:
                        set block at {_genLoc} to gold ore

                # Tier 3 (Expert : 45% Deepslate/Roches, 20% Fer, 15% Or, 10% Redstone/Lapis, 7% Quartz, 3% Diamant)
                else if {_genLvl} is 3:
                    if {_roll} <= 45:
                        set block at {_genLoc} to deepslate or smooth stone or tuff
                    else if {_roll} <= 65:
                        set block at {_genLoc} to iron ore or deepslate iron ore
                    else if {_roll} <= 80:
                        set block at {_genLoc} to gold ore or deepslate gold ore
                    else if {_roll} <= 90:
                        set block at {_genLoc} to redstone ore or deepslate redstone ore or lapis ore
                    else if {_roll} <= 97:
                        set block at {_genLoc} to nether quartz ore or amethyst block
                    else:
                        set block at {_genLoc} to diamond ore

                # Tier 4 (Cosmique Max : 35% Deepslate, 22% Fer, 18% Or, 14% Lapis/Redstone/Quartz, 7% Diamant, 3% Émeraude, 1% Debris)
                else:
                    if {_roll} <= 35:
                        set block at {_genLoc} to deepslate or basalt or calcite
                    else if {_roll} <= 57:
                        set block at {_genLoc} to iron ore or deepslate iron ore
                    else if {_roll} <= 75:
                        set block at {_genLoc} to gold ore or deepslate gold ore
                    else if {_roll} <= 89:
                        set block at {_genLoc} to deepslate redstone ore or deepslate lapis ore or nether quartz ore
                    else if {_roll} <= 96:
                        set block at {_genLoc} to diamond ore or deepslate diamond ore
                    else if {_roll} <= 99:
                        set block at {_genLoc} to emerald ore or deepslate emerald ore
                    else:
                        set block at {_genLoc} to ancient debris
                
                # Feedback sonore doux d'apparition
                play sound "block.stone.place" with pitch 1.1 to player
                play sound "block.amethyst_block.hit" with pitch 1.4 to player
            
            delete {island_gen_cooling::%{_genLoc}%}

# ==================== SYSTÈME DE SPAWN DE MOBS & ANIMAUX SKYBLOCK ====================

# Commande directe de gestion des Mobs & Paramètres Skyblock (/is mobs, /is settings)
command /is-gui-mobs:
    aliases: /is-gui-settings
    trigger:
        set {_u} to uuid of player
        set {_owner} to "%player%"
        if {island_team_owner::%{_u}%} is set:
            set {_owner} to "%{island_team_owner::%{_u}%}%"
        else if {island_team_owner::%player%} is set:
            set {_owner} to "%{island_team_owner::%player%}%"

        set {_gui} to a new chest inventory with 3 rows named "&8» &0&lGESTION MOBS & PARAMÈTRES"
        loop 27 times:
            set slot (loop-number - 1) of {_gui} to gray stained glass pane named "&8✦"

        # 1. Toggle Monstres Hostiles (Slot 10)
        if {island_mobs_hostile::%{_owner}%} is false:
            set slot 10 of {_gui} to zombie head named "&c&lMonstres Hostiles : &cDÉSACTIVÉS" with lore "&8Génération de monstres" and "&7• Zombies, Squelettes, Creepers, Araignées" and "&7• Mini-Boss Célestes" and "" and "&e► Cliquer pour &aACTIVER"
        else:
            set slot 10 of {_gui} to zombie head named "&a&lMonstres Hostiles : &aACTIVÉS" with lore "&8Génération de monstres" and "&7• Zombies, Squelettes, Creepers, Araignées" and "&7• Mini-Boss Célestes" and "" and "&e► Cliquer pour &cDÉSACTIVER"

        # 2. Toggle Animaux Pacifiques (Slot 12)
        if {island_mobs_passive::%{_owner}%} is false:
            set slot 12 of {_gui} to egg named "&c&lAnimaux Pacifiques : &cDÉSACTIVÉS" with lore "&8Génération d'élevage" and "&7• Vaches, Moutons, Cochons, Poules, Abeilles" and "&7• Apparaissent sur les blocs d'herbe" and "" and "&e► Cliquer pour &aACTIVER"
        else:
            set slot 12 of {_gui} to egg named "&a&lAnimaux Pacifiques : &aACTIVÉS" with lore "&8Génération d'élevage" and "&7• Vaches, Moutons, Cochons, Poules, Abeilles" and "&7• Apparaissent sur les blocs d'herbe" and "" and "&e► Cliquer pour &cDÉSACTIVER"

        # 3. Protection Anti-Grief Explosions Creepers (Slot 14)
        if {island_antigrief::%{_owner}%} is false:
            set slot 14 of {_gui} to tnt named "&c&lProtection Anti-Explosion : &cDÉSACTIVÉE" with lore "&8Sécurité des blocs" and "&7• Les Creepers détruiront vos constructions !" and "" and "&e► Cliquer pour &aACTIVER LA PROTECTION"
        else:
            set slot 14 of {_gui} to shield named "&a&lProtection Anti-Explosion : &aACTIVÉE" with lore "&8Sécurité des blocs" and "&7• 0 dégât aux blocs de votre île" and "&7• Dégâts physiques aux entités uniquement" and "" and "&e► Cliquer pour &cDÉSACTIVER"

        # 4. Forcer l'apparition de Mobs (Slot 16)
        set slot 16 of {_gui} to spawner named "&6&l✦ Forcer l'apparition (Spawn Vague) ✦" with lore "&8Invoque une vague immédiate" and "&7• Génère des créatures sur vos plateformes" and "" and "&e► Cliquer pour &6GÉNÉRER UNE VAGUE"

        # Retour
        set slot 22 of {_gui} to arrow named "&c« Retour au Menu"
        open {_gui} to player
        play sound "block.amethyst_block.hit" to player

# Boucle périodique d'apparition automatique de Mobs sur les îles Skyblock (Toutes les 20 secondes)
every 20 seconds:
    loop all players:
        if "%world of loop-player%" contains "skyblock":
            set {_u} to uuid of loop-player
            set {_owner} to "%loop-player%"
            if {island_team_owner::%{_u}%} is set:
                set {_owner} to "%{island_team_owner::%{_u}%}%"
            else if {island_team_owner::%loop-player%} is set:
                set {_owner} to "%{island_team_owner::%loop-player%}%"

            if {island::%{_owner}%::x} is set:
                set {_w} to world of loop-player
                set {_isX} to {island::%{_owner}%::x}
                set {_isZ} to {island::%{_owner}%::z}
                set {_rad} to getIslandRadius({_owner})
                if {_rad} < 30:
                    set {_rad} to 40
                set {_maxOffset} to ({_rad} - 6)
                if {_maxOffset} < 15:
                    set {_maxOffset} to 15
                
                set {_centerLoc} to location({_isX}, 150, {_isZ}, {_w})
                set {_py} to y-coordinate of loop-player
                if {_py} is not set:
                    set {_py} to 150

                # 1. SPAWN DE MONSTRES HOSTILES
                if {island_mobs_hostile::%{_owner}%} is not false:
                    set {_hostileCount} to 0
                    loop monsters in radius 45 of {_centerLoc}:
                        add 1 to {_hostileCount}
                        
                    if {_hostileCount} < 18:
                        # Tente de trouver une plateforme valide sur plusieurs niveaux Y
                        set {_rx} to random integer between (0 - {_maxOffset}) and {_maxOffset}
                        set {_rz} to random integer between (0 - {_maxOffset}) and {_maxOffset}
                        set {_targetX} to {_isX} + {_rx}
                        set {_targetZ} to {_isZ} + {_rz}
                        
                        # Scan intelligent de hauteur : autour du joueur et à Y=150
                        set {_foundFloor} to false
                        set {_spawnLoc} to location({_targetX}, 151, {_targetZ}, {_w})
                        
                        loop integers from 0 to 20:
                            set {_checkY} to round({_py} + 10 - loop-integer)
                            set {_testLoc} to location({_targetX}, {_checkY}, {_targetZ}, {_w})
                            if block at {_testLoc} is air:
                                set {_bBelow} to block 1 below {_testLoc}
                                if {_bBelow} is not air or water or lava:
                                    if {_bBelow} is cobblestone or stone or cobbled deepslate or deepslate or dirt or grass block or oak planks or spruce planks or netherrack or blackstone:
                                        set {_spawnLoc} to {_testLoc}
                                        set {_foundFloor} to true
                                        exit 1 loop
                        
                        if {_foundFloor} is false:
                            if block at location({_targetX}, 151, {_targetZ}, {_w}) is air:
                                set {_bBelow} to block at location({_targetX}, 150, {_targetZ}, {_w})
                                if {_bBelow} is cobblestone or stone or cobbled deepslate or deepslate or dirt or grass block:
                                    set {_spawnLoc} to location({_targetX}, 151, {_targetZ}, {_w})
                                    set {_foundFloor} to true

                        if {_foundFloor} is true:
                            set {_floorType} to "%type of block 1 below {_spawnLoc}%"
                            set {_mobRoll} to random integer between 1 and 100
                            
                            # Mini-Boss Céleste Rare (Garde Céleste - 2%)
                            if {_mobRoll} is 100 or 99:
                                spawn 1 zombie at {_spawnLoc}
                                set {_boss} to last spawned zombie
                                set name of {_boss} to "&6&l✦ GARDE CÉLESTE ✦ &c[Mini-Boss]"
                                set max health of {_boss} to 60
                                set health of {_boss} to 60
                                equip {_boss} with netherite helmet
                                equip {_boss} with golden chestplate
                                equip {_boss} with iron sword
                                set {skyblock_boss::%uuid of {_boss}%} to "garde_celeste"
                                draw 15 of flame at location 1 meter above {_spawnLoc}
                                play sound "entity.wither.spawn" with volume 0.8 and pitch 1.5 at {_spawnLoc}
                                send "{@prefix}&6&l✦ UN GARDE CÉLESTE (Mini-Boss) EST APPARU SUR TON ÎLE ! ✦" to loop-player
                            
                            # Mini-Boss des Ombres (Spectre du Néant - 2%)
                            else if {_mobRoll} is 98 or 97:
                                spawn 1 skeleton at {_spawnLoc}
                                set {_boss} to last spawned skeleton
                                set name of {_boss} to "&d&l✦ SPECTRE DU NÉANT ✦ &c[Mini-Boss]"
                                set max health of {_boss} to 50
                                set health of {_boss} to 50
                                equip {_boss} with diamond helmet
                                equip {_boss} with bow of power 2
                                set {skyblock_boss::%uuid of {_boss}%} to "spectre_neant"
                                draw 15 of portal at location 1 meter above {_spawnLoc}
                                play sound "entity.wither.ambient" with volume 0.8 and pitch 1.8 at {_spawnLoc}
                                send "{@prefix}&d&l✦ UN SPECTRE DU NÉANT (Mini-Boss) EST APPARU SUR TON ÎLE ! ✦" to loop-player
                            
                            # Monde / Blocs du Nether
                            else if {_floorType} contains "netherrack" or "blackstone" or "basalt":
                                if {_mobRoll} <= 40:
                                    spawn 1 zombified piglin at {_spawnLoc}
                                else if {_mobRoll} <= 70:
                                    spawn 1 wither skeleton at {_spawnLoc}
                                else if {_mobRoll} <= 85:
                                    spawn 1 blaze at {_spawnLoc}
                                else:
                                    spawn 1 magma cube at {_spawnLoc}
                            
                            # Monstres Classiques & Variantes
                            else:
                                if {_mobRoll} <= 32:
                                    spawn 1 zombie at {_spawnLoc}
                                    chance of 35%:
                                        equip last spawned zombie with iron helmet
                                else if {_mobRoll} <= 58:
                                    spawn 1 skeleton at {_spawnLoc}
                                    chance of 25%:
                                        equip last spawned skeleton with chainmail helmet
                                else if {_mobRoll} <= 76:
                                    spawn 1 spider at {_spawnLoc}
                                else if {_mobRoll} <= 88:
                                    spawn 1 creeper at {_spawnLoc}
                                else if {_mobRoll} <= 94:
                                    spawn 1 enderman at {_spawnLoc}
                                else:
                                    spawn 1 witch at {_spawnLoc}

                # 2. SPAWN D'ANIMAUX PASSIFS (Sur herbe naturelle)
                if {island_mobs_passive::%{_owner}%} is not false:
                    set {_animalCount} to 0
                    loop animals in radius 45 of {_centerLoc}:
                        add 1 to {_animalCount}
                        
                    if {_animalCount} < 12:
                        set {_rx} to random integer between (0 - {_maxOffset}) and {_maxOffset}
                        set {_rz} to random integer between (0 - {_maxOffset}) and {_maxOffset}
                        set {_targetX} to {_isX} + {_rx}
                        set {_targetZ} to {_isZ} + {_rz}
                        
                        set {_foundGrass} to false
                        set {_spawnLoc} to location({_targetX}, 151, {_targetZ}, {_w})
                        
                        loop integers from 0 to 20:
                            set {_checkY} to round({_py} + 10 - loop-integer)
                            set {_testLoc} to location({_targetX}, {_checkY}, {_targetZ}, {_w})
                            if block at {_testLoc} is air:
                                if block 1 below {_testLoc} is grass block:
                                    set {_spawnLoc} to {_testLoc}
                                    set {_foundGrass} to true
                                    exit 1 loop
                        
                        if {_foundGrass} is false:
                            if block at location({_targetX}, 151, {_targetZ}, {_w}) is air:
                                if block at location({_targetX}, 150, {_targetZ}, {_w}) is grass block:
                                    set {_spawnLoc} to location({_targetX}, 151, {_targetZ}, {_w})
                                    set {_foundGrass} to true

                        if {_foundGrass} is true:
                            set {_aRoll} to random integer between 1 and 100
                            if {_aRoll} <= 28:
                                spawn 1 cow at {_spawnLoc}
                            else if {_aRoll} <= 52:
                                spawn 1 sheep at {_spawnLoc}
                            else if {_aRoll} <= 72:
                                spawn 1 pig at {_spawnLoc}
                            else if {_aRoll} <= 86:
                                spawn 1 chicken at {_spawnLoc}
                            else if {_aRoll} <= 94:
                                spawn 1 rabbit at {_spawnLoc}
                            else:
                                spawn 1 bee at {_spawnLoc}

# Gestion des clics dans le Menu de Mobs & Paramètres
on inventory click:
    if name of event-inventory contains "GESTION MOBS" or name of event-inventory contains "Gestion Mobs" or name of event-inventory contains "Paramètres" or name of event-inventory contains "PARAMÈTRES":
        cancel event
        set {_u} to uuid of player
        set {_owner} to "%player%"
        if {island_team_owner::%{_u}%} is set:
            set {_owner} to "%{island_team_owner::%{_u}%}%"
        else if {island_team_owner::%player%} is set:
            set {_owner} to "%{island_team_owner::%player%}%"

        # 1. Toggle Monstres Hostiles (Slot 10)
        if index of event-slot is 10:
            if {island_mobs_hostile::%{_owner}%} is false:
                set {island_mobs_hostile::%{_owner}%} to true
                send "{@prefix}&aGénération de monstres hostiles &aACTIVÉE &asur ton île !" to player
            else:
                set {island_mobs_hostile::%{_owner}%} to false
                send "{@prefix}&cGénération de monstres hostiles &cDÉSACTIVÉE &csur ton île !" to player
            play sound "block.note_block.pling" to player
            execute player command "is-gui-mobs"

        # 2. Toggle Animaux Pacifiques (Slot 12)
        else if index of event-slot is 12:
            if {island_mobs_passive::%{_owner}%} is false:
                set {island_mobs_passive::%{_owner}%} to true
                send "{@prefix}&aGénération d'animaux pacifiques &aACTIVÉE &asur ton île !" to player
            else:
                set {island_mobs_passive::%{_owner}%} to false
                send "{@prefix}&cGénération d'animaux pacifiques &cDÉSACTIVÉE &csur ton île !" to player
            play sound "block.note_block.pling" to player
            execute player command "is-gui-mobs"

        # 3. Toggle Anti-Grief Creepers (Slot 14)
        else if index of event-slot is 14:
            if {island_antigrief::%{_owner}%} is false:
                set {island_antigrief::%{_owner}%} to true
                send "{@prefix}&aProtection anti-explosion de blocs &aACTIVÉE &a!" to player
            else:
                set {island_antigrief::%{_owner}%} to false
                send "{@prefix}&cProtection anti-explosion de blocs &cDÉSACTIVÉE &c!" to player
            play sound "block.anvil.use" to player
            execute player command "is-gui-mobs"

        # 4. Spawn Vague Immédiate (Slot 16)
        else if index of event-slot is 16:
            close player's inventory
            set {_w} to world of player
            set {_spawnCount} to 0
            loop 4 times:
                set {_rx} to random integer between -15 and 15
                set {_rz} to random integer between -15 and 15
                set {_sLoc} to location(x-coordinate of player + {_rx}, y-coordinate of player + 1, z-coordinate of player + {_rz}, {_w})
                if block at {_sLoc} is air:
                    set {_bBelow} to block 1 below {_sLoc}
                    if {_bBelow} is not air or water or lava:
                        spawn 1 zombie at {_sLoc}
                        add 1 to {_spawnCount}
                        draw 10 of cloud at {_sLoc}
            send "{@prefix}&aVague invoquée ! &e%{_spawnCount}% &7créatures sont apparues autour de vous." to player
            play sound "entity.wither.spawn" with pitch 1.8 to player

        # Retour (Slot 22)
        else if index of event-slot is 22:
            execute player command "is"

# Récompenses & Butin spécial lors de l'élimination des créatures Skyblock
on death of monster:
    if "%world of victim%" contains "skyblock":
        set {_u} to uuid of victim
        
        # Mini-Boss Céleste Récompense
        if {skyblock_boss::%{_u}%} is "garde_celeste":
            delete {skyblock_boss::%{_u}%}
            drop 2 of diamond at victim's location
            drop 1 of golden apple at victim's location
            drop 8 of iron ingot at victim's location
            spawn 80 of xp at victim's location
            if attacker is a player:
                set {_reward} to random integer between 150 and 300
                execute console command "eco give %attacker% %{_reward}%"
                send title "&6&l✦ GARDE CÉLESTE VAINCU ! ✦" with subtitle "&a+%{_reward}%$ &7et butin rare récolté !" to attacker for 3 seconds
                play sound "ui.toast.challenge_complete" to attacker
                
        # Mini-Boss des Ombres Récompense
        else if {skyblock_boss::%{_u}%} is "spectre_neant":
            delete {skyblock_boss::%{_u}%}
            drop 3 of emerald at victim's location
            drop 16 of spectral arrow at victim's location
            drop 1 of enchanted book at victim's location
            spawn 70 of xp at victim's location
            if attacker is a player:
                set {_reward} to random integer between 150 and 250
                execute console command "eco give %attacker% %{_reward}%"
                send title "&d&l✦ SPECTRE DU NÉANT VAINCU ! ✦" with subtitle "&a+%{_reward}%$ &7et flèches spectrales récoltées !" to attacker for 3 seconds
                play sound "ui.toast.challenge_complete" to attacker
                
        # Monstre Skyblock Standard
        else:
            if attacker is a player:
                set {_cash} to random integer between 3 and 10
                execute console command "eco give %attacker% %{_cash}%"
                send action bar "&c☠ Monstre vaincu ! &a+%{_cash}%$ &e(+5 XP)" to attacker
                spawn 5 of xp at victim's location

# Protection contre les dégâts de blocs des explosions de Creepers en Skyblock (Anti-Grief)
on explode:
    if "%world of event-location%" contains "skyblock":
        if event-entity is a creeper:
            cancel event
            loop all entities in radius 6 of event-location:
                if loop-entity is a player or monster:
                    damage loop-entity by 6
            draw 15 of explosion at event-location
            play sound "entity.generic.explode" with volume 1.2 and pitch 1.0 at event-location

# Gestion des clics dans le Menu Admin des Îles
on inventory click:
    if name of event-inventory contains "ÎLES SKYBLOCK" or name of event-inventory contains "Îles Skyblock" or name of event-inventory contains "Liste des Îles":
        cancel event
        if event-slot is set:
            set {_name} to uncolored name of event-slot
            replace all "✦ " with "" in {_name}
            replace all " ✦" with "" in {_name}
            replace all "Île de " with "" in {_name}
            set {_owner} to {_name}
            
            if click type is left mouse button or left mouse button with shift:
                close player's inventory
                execute player command "isadmin tp %{_owner}%"
            else if click type is right mouse button or right mouse button with shift:
                close player's inventory
                execute player command "isadmin regen %{_owner}%"

